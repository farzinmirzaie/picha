---
import { Icon } from 'astro-icon/components';
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import Footer from '../components/Footer.astro';
import {
  vet,
  contact,
  weight,
  healthTimeline,
  recurringCare,
  treatment,
  callVetIf,
  ageLabel,
  inDaysLabel,
} from '../data/picha';
import { currentWeight } from '../data/weights';
import { supabaseClient } from '../data/supabase';
import { dateLabel, shortLabel, addDays } from '../lib/dates';

// Split the timeline by date: past = done, future = coming up (soonest first,
// the first one is "next"), undated = still to book. The split is computed at
// build time; countdown chips and the progress bar update client-side.
const today = new Date().toISOString().slice(0, 10);
const dated = healthTimeline.filter((e) => e.date);
const done = dated
  .filter((e) => e.date! < today)
  .sort((a, b) => b.date!.localeCompare(a.date!));
const onceUpcoming = dated
  .filter((e) => e.date! >= today)
  .sort((a, b) => a.date!.localeCompare(b.date!));
const toBook = healthTimeline.filter((e) => !e.date);

// Recurring upkeep: compute the next due date from lastDone + interval, then
// merge with the one-time items into a single due-date-sorted list. Items
// whose routine hasn't started (no lastDone) sink to the end.
interface UpcomingEntry {
  icon: string;
  title: string;
  detail: string;
  date?: string;
  everyLabel?: string;
  where?: string;
}

const upcoming: UpcomingEntry[] = [
  ...onceUpcoming,
  ...recurringCare.map((r) => ({
    icon: r.icon,
    title: r.title,
    detail: r.detail,
    date: r.nextDue ?? (r.lastDone ? addDays(r.lastDone, r.intervalDays) : undefined),
    everyLabel: r.everyLabel,
    where: r.where,
  })),
].sort((a, b) => (a.date ?? '9999').localeCompare(b.date ?? '9999'));

const next = upcoming.find((e) => e.date);

// Build-time countdown text: the no-JS fallback inside [data-until] spans
// (the client script recomputes it against the visitor's clock).
const untilLabel = (iso: string) => {
  const days = Math.round((Date.parse(iso) - Date.parse(today)) / 86_400_000);
  if (days > 60) return '';
  if (days < 0) return ' (overdue)';
  return ` (${inDaysLabel(days)})`;
};

const segments = [
  { id: 'upcoming', label: 'Coming up' },
  { id: 'done', label: 'The record' },
  { id: 'tobook', label: 'On the list' },
];
---

<Layout
  title="Health · Picha 🐾"
  description="Picha's health record: vitals, vaccinations, vet visits and what is coming up."
  current="health"
>
  <PageHeader
    kicker="Vet & Health"
    title="The royal health record"
    blurb={`From birthday to boosters: meticulous records, kept by the staff. ${vet.status}.`}
  />

  <!-- Vitals strip: horizontally snap-scrolling stat tiles -->
  <section aria-label="Vitals" class="mx-auto w-full max-w-2xl pt-5">
    <div
      class="no-scrollbar flex snap-x snap-mandatory gap-3 overflow-x-auto scroll-px-5 px-5 pb-1"
    >
      <div
        class="reveal min-w-[8.5rem] shrink-0 snap-start rounded-2xl border border-blush-200/70 bg-paper-50 p-4 dark:border-plum-700 dark:bg-plum-900"
      >
        <div class="flex items-center gap-1.5 text-blush-500 dark:text-blush-300">
          <Icon name="ph:scales" class="h-4 w-4" aria-hidden="true" />
          <span class="text-[10px] font-bold tracking-[0.14em] uppercase">Weight</span>
        </div>
        <p
          class="font-display mt-1.5 text-xl font-semibold"
          data-weight-live
          data-supabase-url={supabaseClient?.url}
          data-supabase-key={supabaseClient?.key}
        >
          {currentWeight.label}
        </p>
        <p class="mt-0.5 text-[11px] leading-tight text-ink-400">
          target {weight.healthyTarget}
        </p>
      </div>

      <div
        class="reveal min-w-[8.5rem] shrink-0 snap-start rounded-2xl border border-blush-200/70 bg-paper-50 p-4 dark:border-plum-700 dark:bg-plum-900"
      >
        <div class="flex items-center gap-1.5 text-blush-500 dark:text-blush-300">
          <Icon name="ph:cake" class="h-4 w-4" aria-hidden="true" />
          <span class="text-[10px] font-bold tracking-[0.14em] uppercase">Age</span>
        </div>
        <p class="font-display mt-1.5 text-xl font-semibold" data-age>{ageLabel()}</p>
        <p class="mt-0.5 text-[11px] leading-tight text-ink-400">
          adult at ~1.5–2 years
        </p>
      </div>

      {
        next && (
          <div class="reveal min-w-[8.5rem] shrink-0 snap-start rounded-2xl border border-blush-200/70 bg-paper-50 p-4 dark:border-plum-700 dark:bg-plum-900">
            <div class="flex items-center gap-1.5 text-blush-500 dark:text-blush-300">
              <Icon name="ph:calendar-check" class="h-4 w-4" aria-hidden="true" />
              <span class="text-[10px] font-bold tracking-[0.14em] uppercase">
                Next due
              </span>
            </div>
            <p class="font-display mt-1.5 text-xl font-semibold">
              {shortLabel(next.date!)}
            </p>
            <p class="mt-0.5 truncate text-[11px] leading-tight text-ink-400">
              {next.title.toLowerCase()}
            </p>
          </div>
        )
      }
    </div>
  </section>

  <!-- Doctor's orders: the standing slot for anything the vet prescribes.
       Data-driven from `treatment` in picha.ts; hides itself when empty. -->
  {
    treatment.length > 0 && (
      <section class="mx-auto w-full max-w-2xl px-5 pt-8" aria-label="Doctor's orders">
        <h2 class="reveal mb-2 flex items-center gap-1.5 text-[11px] font-bold tracking-[0.24em] text-amber-700 uppercase dark:text-amber-300">
          <Icon name="ph:stethoscope" class="h-3.5 w-3.5" aria-hidden="true" />
          Doctor's orders
        </h2>
        <div class="space-y-3">
          {treatment.map((t) => (
            <div class="reveal flex items-start gap-4 rounded-3xl border border-amber-300/60 bg-paper-50 p-6 dark:border-amber-700/40 dark:bg-plum-900">
              <span
                class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-amber-300/30 text-amber-700 dark:bg-amber-700/30 dark:text-amber-300"
                aria-hidden="true"
              >
                <Icon name={t.icon} class="h-5.5 w-5.5" />
              </span>
              <div>
                <div class="flex flex-wrap items-center gap-2">
                  <h3 class="font-display text-lg font-semibold">{t.title}</h3>
                  {t.cadence && (
                    <span class="rounded-full bg-amber-300/30 px-2.5 py-0.5 text-[11px] font-bold text-amber-700 dark:bg-amber-700/30 dark:text-amber-300">
                      {t.cadence}
                    </span>
                  )}
                </div>
                <p class="mt-1 text-sm leading-relaxed text-ink-600 dark:text-ink-400">
                  {t.detail}
                </p>
              </div>
            </div>
          ))}
        </div>
      </section>
    )
  }

  <!-- Timeline with segmented control -->
  <section class="mx-auto w-full max-w-2xl px-5 pt-10" aria-label="Timeline">
    <div
      class="reveal relative grid grid-cols-3 rounded-full bg-paper-200/80 p-1 dark:bg-plum-800/80"
      role="tablist"
      aria-label="Timeline filter"
      data-seg
    >
      <span
        class="pointer-events-none absolute inset-y-1 left-1 w-[calc((100%-0.5rem)/3)] rounded-full bg-paper-50 shadow-sm transition-transform duration-300 ease-out dark:bg-plum-950"
        data-seg-thumb
        aria-hidden="true"
      >
      </span>
      {
        segments.map((s, i) => (
          <button
            type="button"
            role="tab"
            id={`seg-tab-${s.id}`}
            aria-controls={`seg-panel-${s.id}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            data-seg-tab={s.id}
            class:list={[
              'relative z-10 rounded-full py-1.5 text-xs font-bold transition-colors duration-200',
              i === 0
                ? 'text-blush-700 dark:text-blush-300'
                : 'text-ink-400',
            ]}
          >
            {s.label}
          </button>
        ))
      }
    </div>

    <!-- Coming up -->
    <div id="seg-panel-upcoming" role="tabpanel" aria-labelledby="seg-tab-upcoming" data-seg-panel="upcoming" class="pt-6">
      <ol class="ml-3 pl-7">
        {
          upcoming.map((e, i) => (
            <li class="group relative pb-8 last:pb-2">
              <span
                class="absolute -left-[27px] top-0 bottom-0 w-0.5 bg-amber-300/60 group-first:top-8 group-last:bottom-auto group-last:h-4 group-only:hidden dark:bg-amber-700/40"
                aria-hidden="true"
              />
              <span
                class:list={[
                  'absolute -left-[42px] flex h-8 w-8 items-center justify-center rounded-full ring-4 ring-paper-100 dark:ring-plum-950',
                  i === 0
                    ? 'bg-amber-300/60 text-amber-800 dark:bg-amber-700/50 dark:text-amber-200'
                    : 'bg-paper-200 text-ink-600 dark:bg-plum-800 dark:text-ink-400',
                ]}
                aria-hidden="true"
              >
                <Icon name={e.icon} class="h-4 w-4" />
              </span>
              <h3 class="font-display pt-1 text-lg font-semibold">{e.title}</h3>
              {(i === 0 || e.everyLabel || e.where) && (
                <div class="mt-1 mb-0.5 flex flex-wrap items-center gap-1.5">
                  {i === 0 && (
                    <span class="rounded-full bg-amber-300/40 px-2.5 py-0.5 text-[11px] font-bold text-amber-700 dark:bg-amber-700/30 dark:text-amber-300">
                      Next up
                    </span>
                  )}
                  {e.everyLabel && (
                    <span class="inline-flex items-center gap-1 rounded-full bg-paper-200 px-2.5 py-0.5 text-[11px] font-bold text-ink-600 dark:bg-plum-800 dark:text-ink-400">
                      <Icon name="ph:arrow-clockwise" class="h-3 w-3" aria-hidden="true" />
                      {e.everyLabel}
                    </span>
                  )}
                  {e.where && (
                    <span class="inline-flex items-center gap-1 rounded-full bg-paper-200 px-2.5 py-0.5 text-[11px] font-bold text-ink-600 dark:bg-plum-800 dark:text-ink-400">
                      <Icon name="ph:map-pin" class="h-3 w-3" aria-hidden="true" />
                      {e.where}
                    </span>
                  )}
                </div>
              )}
              <p class="text-xs font-bold text-amber-700/80 dark:text-amber-300/80">
                {e.date ? (
                  <>
                    {e.everyLabel && 'due ~'}
                    {dateLabel(e.date)}
                    <span data-until={e.date} data-overdue="overdue">
                      {untilLabel(e.date)}
                    </span>
                  </>
                ) : (
                  'not started yet'
                )}
              </p>
              <p class="mt-1 text-sm leading-relaxed text-ink-600 dark:text-ink-400">
                {e.detail}
              </p>
            </li>
          ))
        }
      </ol>
    </div>

    <!-- The record -->
    <div id="seg-panel-done" role="tabpanel" aria-labelledby="seg-tab-done" data-seg-panel="done" class="hidden pt-6">
      <ol class="ml-3 pl-7">
        {
          done.map((e) => (
            <li class="group relative pb-8 last:pb-2">
              <span
                class="absolute -left-[27px] top-0 h-full w-0.5 bg-blush-200 group-last:h-4 dark:bg-plum-700"
                aria-hidden="true"
              />
              <span
                class="absolute -left-[42px] flex h-8 w-8 items-center justify-center rounded-full bg-blush-100 text-blush-600 ring-4 ring-paper-100 dark:bg-plum-800 dark:text-blush-300 dark:ring-plum-950"
                aria-hidden="true"
              >
                <Icon name={e.icon} class="h-4 w-4" />
              </span>
              <h3 class="font-display pt-1 text-lg font-semibold">{e.title}</h3>
              <p class="text-xs font-bold text-blush-500/90 dark:text-blush-300/80">
                {dateLabel(e.date!)}
              </p>
              <p class="mt-1 text-sm leading-relaxed text-ink-600 dark:text-ink-400">
                {e.detail}
              </p>
            </li>
          ))
        }
      </ol>
    </div>

    <!-- To book -->
    <div id="seg-panel-tobook" role="tabpanel" aria-labelledby="seg-tab-tobook" data-seg-panel="tobook" class="hidden pt-6">
      <ul class="space-y-3">
        {
          toBook.map((e) => (
            <li class="flex items-start gap-3 text-sm text-ink-600 dark:text-ink-400">
              <span
                class="mt-0.5 inline-block h-4 w-4 shrink-0 rounded-full border-2 border-dashed border-blush-300 dark:border-plum-600"
                aria-hidden="true"
              />
              <span>
                <strong class="font-semibold text-ink-900 dark:text-paper-100">
                  {e.title}
                </strong>{' '}
                · {e.detail}
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Emergency: deliberately plain-spoken. -->
  <section class="mx-auto w-full max-w-2xl px-5 pt-10" aria-label="Emergency">
    <div
      class="reveal overflow-hidden rounded-3xl bg-red-50 ring-1 ring-red-200 dark:bg-red-950/30 dark:ring-red-900/50"
    >
      <div class="p-6 pb-4">
        <h2 class="font-display flex items-center gap-2 text-lg font-semibold text-red-600 dark:text-red-300">
          <Icon name="ph:warning" class="h-4.5 w-4.5 shrink-0" aria-hidden="true" /> Call the vet if…
        </h2>
        <ul class="mt-3 space-y-2 text-sm text-red-900/80 dark:text-red-100/80">
          {
            callVetIf.map((c) => (
              <li class="flex gap-2.5">
                <span class="text-red-400" aria-hidden="true">
                  •
                </span>
                {c}
              </li>
            ))
          }
        </ul>
      </div>
      <div class="divide-y divide-red-200/70 border-t border-red-200/70 dark:divide-red-900/40 dark:border-red-900/40">
        {
          contact.owners.map((o) => (
            <a
              href={`tel:${o.phone.replace(/\s/g, '')}`}
              class="flex items-center gap-3 px-6 py-3.5 text-sm font-bold text-red-700 transition-colors active:bg-red-100/60 dark:text-red-300 dark:active:bg-red-900/30"
            >
              <Icon name="ph:phone" class="h-4.5 w-4.5 shrink-0" aria-hidden="true" />
              <span class="flex-1">
                {o.name} <span class="font-semibold opacity-70">· {o.phone}</span>
              </span>
              <Icon name="ph:caret-right" class="h-4 w-4 opacity-50" aria-hidden="true" />
            </a>
          ))
        }
        <a
          href={`tel:${vet.recentPhone.replace(/[\s-]/g, '')}`}
          class="flex items-center gap-3 px-6 py-3.5 text-sm font-bold text-red-700 transition-colors active:bg-red-100/60 dark:text-red-300 dark:active:bg-red-900/30"
        >
          <Icon name="ph:buildings" class="h-4.5 w-4.5 shrink-0" aria-hidden="true" />
          <span class="flex-1">
            Recent clinic <span class="font-semibold opacity-70">· {vet.recentPhone}</span>
          </span>
          <Icon name="ph:caret-right" class="h-4 w-4 opacity-50" aria-hidden="true" />
        </a>
      </div>
    </div>
    <p class="mt-3 px-1 text-xs text-ink-400">
      Recent care: {vet.recentClinic}
    </p>
  </section>

  <Footer />

  <script>
    // Segmented control: slide the thumb, toggle panels.
    function setupSegments() {
      const seg = document.querySelector<HTMLElement>('[data-seg]');
      if (!seg || seg.dataset.bound) return;
      seg.dataset.bound = '1';
      const thumb = seg.querySelector<HTMLElement>('[data-seg-thumb]')!;
      const tabs = Array.from(seg.querySelectorAll<HTMLButtonElement>('[data-seg-tab]'));
      const panels = Array.from(
        document.querySelectorAll<HTMLElement>('[data-seg-panel]'),
      );
      const select = (i: number) => {
        const tab = tabs[i];
        thumb.style.transform = `translateX(${i * 100}%)`;
        tabs.forEach((t) => {
          const active = t === tab;
          t.setAttribute('aria-selected', String(active));
          t.classList.toggle('text-blush-700', active);
          t.classList.toggle('dark:text-blush-300', active);
          t.classList.toggle('text-ink-400', !active);
        });
        panels.forEach((p) => {
          const show = p.dataset.segPanel === tab.dataset.segTab;
          const wasHidden = p.classList.contains('hidden');
          p.classList.toggle('hidden', !show);
          // slide-fade the incoming panel (restart the animation each switch)
          if (show && wasHidden) {
            p.classList.remove('seg-in');
            void p.offsetWidth;
            p.classList.add('seg-in');
          }
        });
      };
      tabs.forEach((tab, i) => tab.addEventListener('click', () => select(i)));
      // arrow keys move between segments, per the tabs pattern
      seg.addEventListener('keydown', (e) => {
        if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
        const current = tabs.findIndex((t) => t.getAttribute('aria-selected') === 'true');
        const nextIdx =
          (current + (e.key === 'ArrowRight' ? 1 : -1) + tabs.length) % tabs.length;
        select(nextIdx);
        tabs[nextIdx].focus();
        e.preventDefault();
      });
    }

    // Weight tile: refresh from the live Supabase ledger (same data the
    // Weight tracker shows); the built value stands when offline.
    async function refreshWeightTile() {
      const el = document.querySelector<HTMLElement>('[data-weight-live]');
      if (!el?.dataset.supabaseUrl || !el.dataset.supabaseKey) return;
      try {
        const { sbSelect } = await import('../lib/sb');
        const rows = await sbSelect<Array<{ date: string; kg: number | string }>>(
          el.dataset.supabaseUrl,
          el.dataset.supabaseKey,
          'picha_weights?select=date,kg',
        );
        if (!Array.isArray(rows) || !rows.length) return;
        const latest = rows.reduce((a, b) => (b.date > a.date ? b : a));
        el.textContent = `${Number(latest.kg)} kg`;
      } catch {
        /* offline: the built value stands */
      }
    }

    setupSegments();
    refreshWeightTile();
    document.addEventListener('astro:page-load', () => {
      setupSegments();
      refreshWeightTile();
    });
  </script>
</Layout>
