---
import { Icon } from 'astro-icon/components';
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import Footer from '../components/Footer.astro';
import StatStrip from '../components/ui/StatStrip.astro';
import StatTile from '../components/ui/StatTile.astro';
import SectionLabel from '../components/ui/SectionLabel.astro';
import IconBadge from '../components/ui/IconBadge.astro';
import Chip from '../components/ui/Chip.astro';
import SegmentedTabs from '../components/ui/SegmentedTabs.astro';
import LabReportDialog from '../components/LabReportDialog.astro';
import {
  vet,
  contact,
  weight,
  healthTimeline,
  labReportById,
  treatment,
  callVetIf,
  clinicalStatus,
} from '../data/picha';
import { currentWeight } from '../data/weights';
import { supabaseClient } from '../data/supabase';
import { dateLabel, shortLabel, inDaysLabel } from '../lib/dates';
import { upcomingHealth, nextDueHealth, isHealthDueSoon } from '../lib/health';
import { getHealthCopy, getLabCopy, localizeHealthItem, ageLabelI18n, localizeName } from '../i18n/content';

const locale = Astro.currentLocale ?? 'en';
const c = getHealthCopy(locale);
const lc = getLabCopy(locale);
const loc = <T extends { title: string; detail: string; everyLabel?: string; where?: string }>(x: T) =>
  localizeHealthItem(x, locale);

// Split the timeline by date: past = done, undated = still to book. The
// "coming up" list (one-time + recurring, merged) comes from lib/health so the
// page, the Nav badge and the app badge all agree. Build-time; countdown chips
// and the progress bar update client-side.
const today = new Date().toISOString().slice(0, 10);
const done = healthTimeline
  .filter((e) => e.date && e.date <= today)
  .sort((a, b) => b.date!.localeCompare(a.date!))
  .map(loc);
const toBook = healthTimeline.filter((e) => !e.date).map(loc);

const upcoming = upcomingHealth(today).map(loc);
const next = nextDueHealth(today)?.item;
const nextLoc = next ? loc(next) : undefined;

// Near-term alert: surface the single next item only when it's due within 2
// days, or already overdue. Build-time gate, kept fresh by the nightly rebuild;
// the countdown text itself updates live via [data-until].
const showDueSoon = isHealthDueSoon(today);

// Build-time countdown text: the no-JS fallback inside [data-until] spans
// (the client script recomputes it against the visitor's clock).
const untilLabel = (iso: string) => {
  const days = Math.round((Date.parse(iso) - Date.parse(today)) / 86_400_000);
  if (days > 60) return '';
  if (days < 0) return ` (${c.overdue})`;
  return ` (${inDaysLabel(days, locale)})`;
};

const segments = [
  { id: 'upcoming', label: c.segments.upcoming },
  { id: 'done', label: c.segments.done },
  { id: 'tobook', label: c.segments.tobook },
];

// Directions to the most recent clinic (opens the visitor's maps app).
const vetMapsUrl = `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(vet.mapsQuery)}`;
---

<Layout title={c.metaTitle} description={c.metaDescription} current="health">
  <PageHeader kicker={c.kicker} title={c.title} blurb={c.blurb} />

  {/* Supabase config for the client care-done writes (read, never shown) */}
  <div
    data-care-config
    hidden
    data-supabase-url={supabaseClient?.url}
    data-supabase-key={supabaseClient?.key}
  />


  <!-- Vitals strip: horizontally snap-scrolling stat tiles -->
  <StatStrip label="Vitals" class="pt-5">
    {
      nextLoc && (
        <StatTile
          icon="ph:calendar-check"
          label={c.nextDue}
          value={shortLabel(nextLoc.date!, locale)}
          sub={nextLoc.title}
          truncateSub
        />
      )
    }
    <StatTile
      icon="ph:scales"
      label={c.weight}
      value={currentWeight.label}
      valueAttrs={{
        'data-weight-live': true,
        'data-supabase-url': supabaseClient?.url,
        'data-supabase-key': supabaseClient?.key,
      }}
      sub={`${c.targetPrefix} ${weight.healthyTarget}`}
    />
    <StatTile
      icon="ph:cake"
      label={c.age}
      value={ageLabelI18n(locale)}
      valueAttrs={{ 'data-age': true }}
      sub={c.ageSub}
    />
    {
      clinicalStatus.map((s) => {
        const t = c.clinicalStatus[s.label] ?? s;
        return <StatTile icon={s.icon} label={t.label} value={t.value} sub={t.sub} truncateSub />;
      })
    }
  </StatStrip>

  <!-- Doctor's orders: the standing slot for anything the vet prescribes.
       Data-driven from `treatment` in picha.ts; hides itself when empty. -->
  {
    treatment.length > 0 && (
      <section class="mx-auto w-full max-w-2xl px-5 pt-8" aria-label="Doctor's orders">
        <SectionLabel tone="amber" icon="ph:stethoscope" class="reveal mb-2">
          {c.doctorsOrders}
        </SectionLabel>
        <div class="space-y-3">
          {treatment.map((t) => (
            <div class="reveal flex items-start gap-4 rounded-3xl border border-amber-300/60 bg-paper-50 p-6 dark:border-amber-700/40 dark:bg-plum-900">
              <IconBadge icon={t.icon} tone="amber" />
              <div>
                <div class="flex flex-wrap items-center gap-2">
                  <h3 class="font-display text-lg font-semibold">{t.title}</h3>
                  {t.cadence && <Chip tone="amber">{t.cadence}</Chip>}
                </div>
                <p class="mt-1 text-sm leading-relaxed text-ink-600 dark:text-ink-400">
                  {t.detail}
                </p>
              </div>
            </div>
          ))}
        </div>
      </section>
    )
  }

  <!-- Due soon: the single next item, shown only within 2 days of its due date
       (or once overdue). Always in the DOM; visibility is decided live on the
       client (Layout's applyDueSoon, via [data-due-soon]) against the visitor's
       clock, with the build-time state as the initial (no-JS) value. No
       `.reveal` here — it can be revealed from hidden, where the observer never
       fires. Countdown text updates via [data-until]. -->
  {
    nextLoc && (
      <section
        class="mx-auto w-full max-w-2xl px-5 pt-8"
        aria-label="Due soon"
        data-due-soon
        hidden={!showDueSoon}
      >
        <SectionLabel tone="amber" icon="ph:bell-ringing" class="mb-2">
          {c.dueSoon}
        </SectionLabel>
        <div
          class="flex items-start gap-4 rounded-3xl border border-amber-300/60 bg-paper-50 p-6 dark:border-amber-700/40 dark:bg-plum-900"
          {...(nextLoc.quickDone ? { 'data-care-id': nextLoc.id, 'data-care-interval': nextLoc.intervalDays } : {})}
        >
          <IconBadge icon={nextLoc.icon} tone="amber" />
          <div class="min-w-0">
            <div class="flex flex-wrap items-center gap-2">
              <h3 class="font-display text-lg font-semibold">{nextLoc.title}</h3>
              {nextLoc.everyLabel && <Chip tone="amber">{nextLoc.everyLabel}</Chip>}
              {nextLoc.where && <Chip icon="ph:map-pin">{nextLoc.where}</Chip>}
            </div>
            <p class="mt-1 text-xs font-bold text-amber-700 dark:text-amber-300">
              {nextLoc.everyLabel && c.dueApprox}
              <span data-date-label>{dateLabel(nextLoc.date!, locale)}</span>
              <span data-until={nextLoc.date} data-overdue={c.overdue}>
                {untilLabel(nextLoc.date!)}
              </span>
            </p>
            <p class="mt-1 text-sm leading-relaxed text-ink-600 dark:text-ink-400">
              {nextLoc.detail}
            </p>
            {nextLoc.quickDone && (
              <>
                <button
                  type="button"
                  data-care-done
                  data-staff-only
                  style="display:none"
                  class="mt-3 inline-flex items-center gap-1.5 rounded-full border border-amber-400/70 bg-amber-100/60 px-3.5 py-1.5 text-xs font-bold text-amber-800 transition-colors hover:bg-amber-100 active:bg-amber-200/70 disabled:opacity-60 dark:border-amber-600/60 dark:bg-amber-900/30 dark:text-amber-200 dark:hover:bg-amber-900/50"
                >
                  <Icon name="ph:check-circle" class="h-4 w-4" aria-hidden="true" />
                  <span data-care-label>{c.careDone.action}</span>
                </button>
                <span data-care-note hidden aria-live="polite" class="mt-1.5 block text-xs font-bold text-red-500" />
              </>
            )}
          </div>
        </div>
      </section>
    )
  }

  <!-- Timeline with segmented control -->
  <section class="mx-auto w-full max-w-2xl px-5 pt-10" aria-label="Timeline">
    <SegmentedTabs tabs={segments} label="Timeline filter" />

    <!-- Coming up. The list is re-sorted + reset client-side when a recurring
         chore is marked done (data-care-*), so the node highlight + "Next up"
         chip are managed as togglable hooks, not baked only onto the first. -->
    <div id="seg-panel-upcoming" role="tabpanel" aria-labelledby="seg-tab-upcoming" data-seg-panel="upcoming" class="pt-6">
      <ol class="ms-3 ps-7" data-upcoming-list>
        {
          upcoming.map((e, i) => (
            <li
              class="reveal group relative pb-8 last:pb-2"
              {...(e.quickDone ? { 'data-care-id': e.id, 'data-care-interval': e.intervalDays } : {})}
            >
              <span
                class="absolute -start-[27px] top-0 bottom-0 w-0.5 bg-amber-300/60 group-first:top-8 group-last:bottom-auto group-last:h-4 group-only:hidden dark:bg-amber-700/40"
                aria-hidden="true"
              />
              <span
                data-node
                class:list={[
                  'absolute -start-[42px] flex h-8 w-8 items-center justify-center rounded-full ring-4 ring-paper-100 dark:ring-plum-950',
                  i === 0
                    ? 'bg-amber-300/60 text-amber-800 dark:bg-amber-700/50 dark:text-amber-200'
                    : 'bg-paper-200 text-ink-600 dark:bg-plum-800 dark:text-ink-400',
                ]}
                aria-hidden="true"
              >
                <Icon name={e.icon} class="h-4 w-4" />
              </span>
              <h3 class="font-display pt-1 text-lg font-semibold">{e.title}</h3>
              <div class="mt-1 mb-0.5 flex flex-wrap items-center gap-1.5 empty:hidden">
                <span data-nextup class:list={[i !== 0 && 'hidden']}>
                  <Chip tone="amber">{c.nextUp}</Chip>
                </span>
                {e.everyLabel && <Chip icon="ph:arrow-clockwise">{e.everyLabel}</Chip>}
                {e.where && <Chip icon="ph:map-pin">{e.where}</Chip>}
              </div>
              <p class="text-xs font-bold text-amber-700/80 dark:text-amber-300/80">
                {e.date ? (
                  <>
                    {e.everyLabel && c.dueApprox}
                    <span data-date-label>{dateLabel(e.date, locale)}</span>
                    <span data-until={e.date} data-overdue={c.overdue}>
                      {untilLabel(e.date)}
                    </span>
                  </>
                ) : (
                  c.notStarted
                )}
              </p>
              <p class="mt-1 text-sm leading-relaxed text-ink-600 dark:text-ink-400">
                {e.detail}
              </p>
              {e.quickDone && (
                <>
                  <button
                    type="button"
                    data-care-done
                    data-staff-only
                    style="display:none"
                    class="mt-2.5 inline-flex items-center gap-1.5 rounded-full border border-blush-300/70 bg-blush-100/50 px-3.5 py-1.5 text-xs font-bold text-blush-700 transition-colors hover:bg-blush-100 active:bg-blush-200/60 disabled:opacity-60 dark:border-plum-600 dark:bg-plum-800/60 dark:text-blush-300 dark:hover:bg-plum-800"
                  >
                    <Icon name="ph:check-circle" class="h-4 w-4" aria-hidden="true" />
                    <span data-care-label>{c.careDone.action}</span>
                  </button>
                  <span data-care-note hidden aria-live="polite" class="mt-1.5 block text-xs font-bold text-red-500" />
                </>
              )}
            </li>
          ))
        }
      </ol>
    </div>

    <!-- The record -->
    <div id="seg-panel-done" role="tabpanel" aria-labelledby="seg-tab-done" data-seg-panel="done" class="hidden pt-6">
      <ol class="ms-3 ps-7">
        {
          done.map((e) => {
            const rep = e.reportId ? labReportById(e.reportId) : undefined;
            const isImg = rep?.kind === 'imaging';
            const chipText = isImg ? lc.imaging.reportChip : lc.reportChip;
            const viewText = isImg ? lc.imaging.viewReport : lc.viewReport;
            return (
            <li class="group relative pb-8 last:pb-2">
              <span
                class="absolute -start-[27px] top-0 h-full w-0.5 bg-blush-200 group-last:h-4 dark:bg-plum-700"
                aria-hidden="true"
              />
              <span
                class="absolute -start-[42px] flex h-8 w-8 items-center justify-center rounded-full bg-blush-100 text-blush-600 ring-4 ring-paper-100 dark:bg-plum-800 dark:text-blush-300 dark:ring-plum-950"
                aria-hidden="true"
              >
                <Icon name={e.icon} class="h-4 w-4" />
              </span>
              <div class="flex flex-wrap items-center gap-2 pt-1">
                <h3 class="font-display text-lg font-semibold">{e.title}</h3>
                {rep && <Chip tone="blushSolid" icon={isImg ? 'ph:scan' : 'ph:flask'}>{chipText}</Chip>}
              </div>
              <p class="text-xs font-bold text-blush-500/90 dark:text-blush-300/80">
                {dateLabel(e.date!, locale)}
              </p>
              <p class="mt-1 text-sm leading-relaxed text-ink-600 dark:text-ink-400">
                {e.detail}
              </p>
              {rep && (
                <button
                  type="button"
                  data-lab-open={e.reportId}
                  class="mt-2.5 inline-flex items-center gap-1.5 rounded-full border border-blush-300/70 bg-blush-100/50 px-3.5 py-1.5 text-xs font-bold text-blush-700 transition-colors hover:bg-blush-100 active:bg-blush-200/60 dark:border-plum-600 dark:bg-plum-800/60 dark:text-blush-300 dark:hover:bg-plum-800"
                >
                  <Icon name={isImg ? 'ph:scan' : 'ph:file-magnifying-glass'} class="h-4 w-4" aria-hidden="true" />
                  {viewText}
                </button>
              )}
            </li>
            );
          })
        }
      </ol>
    </div>

    <!-- To book -->
    <div id="seg-panel-tobook" role="tabpanel" aria-labelledby="seg-tab-tobook" data-seg-panel="tobook" class="hidden pt-6">
      <ul class="space-y-3">
        {
          toBook.map((e) => (
            <li class="flex items-start gap-3 text-sm text-ink-600 dark:text-ink-400">
              <span
                class="mt-0.5 inline-block h-4 w-4 shrink-0 rounded-full border-2 border-dashed border-blush-300 dark:border-plum-600"
                aria-hidden="true"
              />
              <span>
                <strong class="font-semibold text-ink-900 dark:text-paper-100">
                  {e.title}
                </strong>{' '}
                · {e.detail}
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Emergency: deliberately plain-spoken. -->
  <section class="mx-auto w-full max-w-2xl px-5 pt-10 pb-8 md:pb-0" aria-label="Emergency">
    <div
      class="reveal overflow-hidden rounded-3xl bg-red-50 ring-1 ring-red-200 dark:bg-red-950/30 dark:ring-red-900/50"
    >
      <div class="p-6 pb-4">
        <h2 class="font-display flex items-center gap-2 text-lg font-semibold text-red-600 dark:text-red-300">
          <Icon name="ph:warning" class="h-4.5 w-4.5 shrink-0" aria-hidden="true" /> {c.callVetIfTitle}
        </h2>
        <ul class="mt-3 space-y-2 text-sm text-red-900/80 dark:text-red-100/80">
          {
            (c.callVetIf.length === callVetIf.length ? c.callVetIf : callVetIf).map((line) => (
              <li class="flex gap-2.5">
                <span class="text-red-400" aria-hidden="true">
                  •
                </span>
                {line}
              </li>
            ))
          }
        </ul>
      </div>
      <div class="divide-y divide-red-200/70 border-t border-red-200/70 dark:divide-red-900/40 dark:border-red-900/40">
        {
          contact.owners.map((o) => (
            <a
              href={`tel:${o.phone.replace(/\s/g, '')}`}
              class="flex items-center gap-3 px-6 py-3.5 text-sm font-bold text-red-700 transition-colors hover:bg-red-100/60 active:bg-red-100/60 dark:text-red-300 dark:hover:bg-red-900/30 dark:active:bg-red-900/30"
            >
              <Icon name="ph:phone" class="h-4.5 w-4.5 shrink-0" aria-hidden="true" />
              <span class="flex-1">
                {localizeName(o.name, locale)} <span class="font-semibold opacity-70">· {o.phone}</span>
              </span>
              <Icon name="ph:caret-right" class="h-4 w-4 opacity-50 rtl:-scale-x-100" aria-hidden="true" />
            </a>
          ))
        }
        <a
          href={`tel:${vet.recentPhone.replace(/[\s-]/g, '')}`}
          class="flex items-center gap-3 px-6 py-3.5 text-sm font-bold text-red-700 transition-colors hover:bg-red-100/60 active:bg-red-100/60 dark:text-red-300 dark:hover:bg-red-900/30 dark:active:bg-red-900/30"
        >
          <Icon name="ph:buildings" class="h-4.5 w-4.5 shrink-0" aria-hidden="true" />
          <span class="flex-1">
            {c.recentClinic} <span class="font-semibold opacity-70">· {vet.recentPhone}</span>
          </span>
          <Icon name="ph:caret-right" class="h-4 w-4 opacity-50 rtl:-scale-x-100" aria-hidden="true" />
        </a>
        <a
          href={vetMapsUrl}
          target="_blank"
          rel="noopener"
          class="flex items-center gap-3 px-6 py-3.5 text-sm font-bold text-red-700 transition-colors hover:bg-red-100/60 active:bg-red-100/60 dark:text-red-300 dark:hover:bg-red-900/30 dark:active:bg-red-900/30"
        >
          <Icon name="ph:navigation-arrow" class="h-4.5 w-4.5 shrink-0" aria-hidden="true" />
          <span class="flex-1">{c.directions}</span>
          <Icon name="ph:caret-right" class="h-4 w-4 opacity-50 rtl:-scale-x-100" aria-hidden="true" />
        </a>
      </div>
    </div>
    <p class="mt-3 px-1 text-xs text-ink-400">
      {c.recentCarePre}{vet.recentClinic}. {c.vetStatus}.
    </p>
  </section>

  <Footer />

  <LabReportDialog />

  <script>
    // Weight tile: refresh from the live Supabase ledger (same data the
    // Weight tracker shows); the built value stands when offline.
    async function refreshWeightTile() {
      const el = document.querySelector<HTMLElement>('[data-weight-live]');
      if (!el?.dataset.supabaseUrl || !el.dataset.supabaseKey) return;
      try {
        const { sbSelect } = await import('../lib/sb');
        const rows = await sbSelect<Array<{ date: string; kg: number | string }>>(
          el.dataset.supabaseUrl,
          el.dataset.supabaseKey,
          'picha_weights?select=date,kg',
        );
        if (!Array.isArray(rows) || !rows.length) return;
        const latest = rows.reduce((a, b) => (b.date > a.date ? b : a));
        el.textContent = `${Number(latest.kg)} kg`;
      } catch {
        /* offline: the built value stands */
      }
    }

    refreshWeightTile();
    document.addEventListener('astro:page-load', refreshWeightTile);

    // Refresh the weight tile when the tab/app returns to the foreground, so a
    // weigh-in logged elsewhere shows up without a manual reload.
    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'visible') refreshWeightTile();
    });
    window.addEventListener('pageshow', (e) => {
      if ((e as PageTransitionEvent).persisted) refreshWeightTile();
    });
  </script>

  <script>
    // "Mark done" for routine recurring chores (nail trim, grooming, litter).
    // Writes lastDone=today to Supabase (picha_care) via the PIN-gated log_care
    // RPC, then resets the countdown + re-sorts "Coming up" in place — so the
    // schedule updates without an edit + redeploy. On load it also re-applies
    // any cloud override the static build predates. Buttons are [data-staff-only]
    // (hidden until the registrar PIN is present on the device).
    import { sbSelect, sbRpc } from '../lib/sb';
    import { staffPin, hasStaffPin, applyStaffVisibility } from '../lib/staff';
    import { addDays, dateLabel, inDaysLabel } from '../lib/dates';
    import { getHealthCopy } from '../i18n/content';

    const AMBER_NODE = ['bg-amber-300/60', 'text-amber-800', 'dark:bg-amber-700/50', 'dark:text-amber-200'];
    const PLAIN_NODE = ['bg-paper-200', 'text-ink-600', 'dark:bg-plum-800', 'dark:text-ink-400'];

    const loc = () => document.documentElement.lang || 'en';
    const hc = () => getHealthCopy(loc());

    function todayISO(): string {
      const d = new Date();
      return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
    }

    function cfg() {
      const el = document.querySelector<HTMLElement>('[data-care-config]');
      return { url: el?.dataset.supabaseUrl, key: el?.dataset.supabaseKey };
    }

    // Rewrite a date line (the date label + its live countdown span) to an ISO.
    function applyDate(scope: HTMLElement, iso: string) {
      const c = hc();
      const label = scope.querySelector<HTMLElement>('[data-date-label]');
      if (label) label.textContent = dateLabel(iso, loc());
      const until = scope.querySelector<HTMLElement>('[data-until]');
      if (until) {
        until.dataset.until = iso;
        const days = Math.round((Date.parse(iso) - Date.parse(todayISO())) / 86_400_000);
        until.textContent = days > 60 ? '' : days < 0 ? ` (${c.overdue})` : ` (${inDaysLabel(days, loc())})`;
      }
    }

    // Apply a new next-due date everywhere this care id appears (coming-up row +
    // the due-soon card), but never move a displayed date backwards.
    function applyForId(id: string, nextIso: string) {
      document.querySelectorAll<HTMLElement>(`[data-care-id="${id}"]`).forEach((host) => {
        const cur = host.querySelector<HTMLElement>('[data-until]')?.dataset.until;
        if (!cur || nextIso > cur) applyDate(host, nextIso);
      });
    }

    // Re-sort the "Coming up" list by date and re-point the node highlight +
    // "Next up" chip to whatever is soonest now.
    function resort() {
      const ol = document.querySelector<HTMLElement>('[data-upcoming-list]');
      if (!ol) return;
      const items = Array.from(ol.querySelectorAll<HTMLElement>(':scope > li'));
      const dateOf = (li: HTMLElement) =>
        li.querySelector<HTMLElement>('[data-until]')?.dataset.until ?? '9999-12-31';
      items
        .sort((a, b) => dateOf(a).localeCompare(dateOf(b)))
        .forEach((li, i) => {
          ol.appendChild(li);
          const node = li.querySelector<HTMLElement>('[data-node]');
          if (node) {
            node.classList.remove(...AMBER_NODE, ...PLAIN_NODE);
            node.classList.add(...(i === 0 ? AMBER_NODE : PLAIN_NODE));
          }
          li.querySelector<HTMLElement>('[data-nextup]')?.classList.toggle('hidden', i !== 0);
        });
    }

    // Recompute the soonest due-date for the badges + due-soon card, and hand it
    // to Layout's applyDueSoon (listens on visibilitychange).
    function refreshBadges() {
      const ol = document.querySelector<HTMLElement>('[data-upcoming-list]');
      let min: string | undefined;
      ol?.querySelectorAll<HTMLElement>('[data-until]').forEach((s) => {
        const iso = s.dataset.until;
        if (iso && (!min || iso < min)) min = iso;
      });
      if (min) document.body.dataset.healthNext = min;
      document.dispatchEvent(new Event('visibilitychange'));
    }

    function note(host: HTMLElement, msg: string) {
      const el = host.querySelector<HTMLElement>('[data-care-note]');
      if (!el) return;
      el.textContent = msg;
      el.hidden = !msg;
    }

    async function onMarkDone(btn: HTMLButtonElement) {
      const host = btn.closest<HTMLElement>('[data-care-id]');
      if (!host) return;
      const id = host.dataset.careId!;
      const interval = Number(host.dataset.careInterval);
      const { url, key } = cfg();
      const pin = staffPin();
      const label = btn.querySelector<HTMLElement>('[data-care-label]');
      const c = hc();
      if (!url || !key || !pin) return; // gated; button is hidden without a PIN
      note(host, '');
      btn.disabled = true;
      if (label) label.textContent = c.careDone.saving;
      const today = todayISO();
      try {
        await sbRpc(url, key, 'log_care', { p_id: id, p_date: today, p_pin: pin });
        applyForId(id, addDays(today, interval));
        resort();
        refreshBadges();
        if (label) label.textContent = c.careDone.done;
        setTimeout(() => {
          if (label) label.textContent = c.careDone.action;
          btn.disabled = false;
        }, 2000);
      } catch (err) {
        note(host, String(err).includes('wrong pin') ? c.careDone.pinError : c.careDone.error);
        if (label) label.textContent = c.careDone.action;
        btn.disabled = false;
      }
    }

    async function hydrateCare() {
      applyStaffVisibility();
      document.querySelectorAll<HTMLButtonElement>('[data-care-done]').forEach((btn) => {
        if (btn.dataset.bound) return;
        btn.dataset.bound = '1';
        btn.addEventListener('click', () => onMarkDone(btn));
      });

      const { url, key } = cfg();
      if (!url || !key) return;
      try {
        const rows = await sbSelect<Array<{ id: string; last_done: string }>>(
          url,
          key,
          'picha_care?select=id,last_done',
        );
        if (!Array.isArray(rows) || !rows.length) return;
        rows.forEach((r) => {
          const host = document.querySelector<HTMLElement>(`[data-care-id="${r.id}"]`);
          if (!host) return;
          const interval = Number(host.dataset.careInterval);
          if (r.last_done && interval) applyForId(r.id, addDays(r.last_done, interval));
        });
        resort();
        refreshBadges();
      } catch {
        /* offline: the baked dates stand */
      }
    }

    hydrateCare();
    document.addEventListener('astro:page-load', hydrateCare);
    // A PIN entered at the Staff room should reveal the buttons on return.
    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'visible' && hasStaffPin()) applyStaffVisibility();
    });
  </script>
</Layout>
