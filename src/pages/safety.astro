---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import Footer from '../components/Footer.astro';
import pichaPhoto from '../assets/picha.jpg';
import { identity, safety, toxicItems, microchip, contact } from '../data/picha';
---

<Layout title="Safety · Picha 🐾" current="safety">
  <PageHeader
    kicker="Safety"
    title="Keeping her safe"
    blurb="House rules, forbidden items, and the protocol should Her Fluffiness ever slip out."
  />

  <!-- House rules -->
  <section class="mx-auto w-full max-w-2xl px-5 pt-6" aria-label="House rules">
    <ul class="divide-y divide-paper-300/70 dark:divide-plum-800">
      {
        safety.map((s, i) => (
          <li
            class="reveal flex items-start gap-4 py-5"
            style={`--reveal-delay: ${i * 80}ms`}
          >
            <span
              class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-blush-100 text-xl dark:bg-plum-800"
              aria-hidden="true"
            >
              {s.icon}
            </span>
            <div>
              <h3 class="font-display text-lg font-semibold">{s.title}</h3>
              <p class="mt-0.5 text-sm leading-relaxed text-ink-600 dark:text-ink-400">
                {s.detail}
              </p>
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- Toxic list -->
  <section class="mx-auto w-full max-w-2xl px-5 pt-8" aria-label="Toxic items">
    <h2
      class="reveal text-[11px] font-bold tracking-[0.24em] text-red-500 uppercase dark:text-red-300"
    >
      🚫 Never within reach
    </h2>
    <ul class="mt-3 flex flex-wrap gap-2">
      {
        toxicItems.map((t, i) => (
          <li
            class="reveal rounded-full bg-red-50 px-3.5 py-1.5 text-sm font-bold text-red-700 ring-1 ring-red-200 dark:bg-red-950/40 dark:text-red-300 dark:ring-red-900/50"
            style={`--reveal-delay: ${i * 60}ms`}
          >
            {t}
          </li>
        ))
      }
    </ul>
  </section>

  <!-- If found -->
  <section class="mx-auto w-full max-w-2xl px-5 pt-12" aria-label="If found">
    <div
      class="reveal overflow-hidden rounded-3xl border-2 border-dashed border-blush-300 bg-paper-50 dark:border-plum-700 dark:bg-plum-900"
    >
      <div class="flex items-center gap-4 p-6 sm:p-7">
        <div
          class="h-20 w-20 shrink-0 overflow-hidden rounded-2xl ring-2 ring-blush-200 dark:ring-plum-700"
        >
          <Image
            src={pichaPhoto}
            alt=""
            width={160}
            densities={[1, 2]}
            class="h-full w-full object-cover"
            style="object-position: 50% 22%"
          />
        </div>
        <div class="min-w-0">
          <p
            class="text-[10px] font-bold tracking-[0.24em] text-blush-400 uppercase dark:text-blush-300/70"
          >
            If found
          </p>
          <h2 class="font-display text-xl font-semibold">
            This is {identity.name} 🐾
          </h2>
          <p class="mt-0.5 truncate text-xs text-ink-600 dark:text-ink-400">
            Microchip {microchip}
          </p>
        </div>
      </div>
      <div class="grid sm:grid-cols-2">
        {
          contact.owners.map((o) => (
            <a
              href={`tel:${o.phone.replace(/\s/g, '')}`}
              class="block bg-blush-600 py-3.5 text-center text-sm font-bold text-white transition-colors duration-200 first:border-b first:border-blush-500/50 hover:bg-blush-700 sm:first:border-r sm:first:border-b-0"
            >
              📞 {o.name} · {o.phone}
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <Footer />
</Layout>
