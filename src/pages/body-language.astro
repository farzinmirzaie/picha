---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { Icon } from 'astro-icon/components';
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import Footer from '../components/Footer.astro';
import { earSignals } from '../data/picha';

// Signal photos, cropped from the reference chart. Match each signal by id
// (ear-<id>.png). Each body part is a segment/panel; the same pattern extends
// to more parts by adding a segment + its own signal set.
const earImages = import.meta.glob<{ default: ImageMetadata }>('../assets/ears/*.png', {
  eager: true,
});
const earImageById: Record<string, ImageMetadata> = {};
for (const [path, mod] of Object.entries(earImages)) {
  const id = path.match(/ear-(.+)\.png$/)?.[1];
  if (id) earImageById[id] = mod.default;
}

// Segments = the tabs. Each has its signal set and image lookup.
const segments = [{ id: 'ears', label: 'Ears', signals: earSignals, images: earImageById }];

// tone → how to treat it, driving the corner dot + mood chip colours.
const dotTone: Record<string, string> = {
  calm: 'bg-blush-600',
  alert: 'bg-ink-400',
  wary: 'bg-amber-500',
  danger: 'bg-red-600',
};
const chipTone: Record<string, string> = {
  calm: 'bg-blush-100 text-blush-700 dark:bg-plum-800 dark:text-blush-300',
  alert: 'bg-paper-200 text-ink-600 dark:bg-plum-800 dark:text-ink-400',
  wary: 'bg-amber-300/40 text-amber-700 dark:bg-amber-700/30 dark:text-amber-300',
  danger: 'bg-red-100 text-red-700 dark:bg-red-950/50 dark:text-red-300',
};
const legend = [
  { tone: 'calm', label: 'Calm' },
  { tone: 'alert', label: 'Alert' },
  { tone: 'wary', label: 'Ease off' },
  { tone: 'danger', label: 'Give space' },
];
---

<Layout
  title="Reading Picha · Picha 🐾"
  description="A field guide to Picha's body language: what her signals mean and how to answer."
  current="tools"
  appTitle="Reading Picha"
>
  <PageHeader
    kicker="Cat to human"
    title="Reading Picha"
    blurb="She says plenty without a sound. Here is how to read Her Fluffiness, and how to answer before she has to repeat herself."
  />

  <section class="mx-auto w-full max-w-3xl px-5 pt-4" aria-label="Body language">
    <!-- Segmented tabs (one per body part) -->
    <div
      class="reveal relative grid rounded-full bg-paper-200/80 p-1 dark:bg-plum-800/80"
      style={`grid-template-columns: repeat(${segments.length}, minmax(0, 1fr))`}
      role="tablist"
      aria-label="Body part"
      data-seg
    >
      <span
        class="pointer-events-none absolute inset-y-1 left-1 rounded-full bg-paper-50 shadow-sm transition-transform duration-300 ease-out dark:bg-plum-950"
        style={`width: calc((100% - 0.5rem) / ${segments.length})`}
        data-seg-thumb
        aria-hidden="true"
      >
      </span>
      {
        segments.map((s, i) => (
          <button
            type="button"
            role="tab"
            id={`seg-tab-${s.id}`}
            aria-controls={`seg-panel-${s.id}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            data-seg-tab={s.id}
            class:list={[
              'relative z-10 rounded-full py-1.5 text-xs font-bold transition-colors duration-200 hover:text-blush-600 dark:hover:text-blush-300',
              i === 0 ? 'text-blush-700 dark:text-blush-300' : 'text-ink-400',
            ]}
          >
            {s.label}
          </button>
        ))
      }
    </div>

    <!-- Tone key -->
    <div
      class="reveal mt-4 flex flex-wrap items-center gap-x-4 gap-y-1.5 text-[11px] font-bold text-ink-400"
    >
      {
        legend.map((l) => (
          <span class="inline-flex items-center gap-1.5">
            <span class:list={['h-2 w-2 rounded-full', dotTone[l.tone]]} />
            {l.label}
          </span>
        ))
      }
    </div>

    {
      segments.map((seg, si) => (
        <div
          id={`seg-panel-${seg.id}`}
          role="tabpanel"
          aria-labelledby={`seg-tab-${seg.id}`}
          data-seg-panel={seg.id}
          class:list={['pt-5', si === 0 ? '' : 'hidden']}
        >
          <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {seg.signals.map((s) => (
              <article class="reveal overflow-hidden rounded-3xl border border-blush-200/70 bg-paper-50 dark:border-plum-700 dark:bg-plum-900">
                <div class="relative aspect-square bg-white">
                  {seg.images[s.id] && (
                    <Image
                      src={seg.images[s.id]}
                      alt={`Picha with ears ${s.title.toLowerCase()}`}
                      width={320}
                      densities={[1, 2]}
                      class="h-full w-full object-contain"
                    />
                  )}
                  <span
                    class:list={[
                      'absolute top-3 left-3 h-3 w-3 rounded-full ring-2 ring-white',
                      dotTone[s.tone],
                    ]}
                    aria-hidden="true"
                  />
                </div>
                <div class="p-4">
                  <div class="flex flex-wrap items-center justify-between gap-2">
                    <h3 class="font-display font-semibold">{s.title}</h3>
                    <span
                      class:list={[
                        'rounded-full px-2.5 py-0.5 text-[11px] font-bold whitespace-nowrap',
                        chipTone[s.tone],
                      ]}
                    >
                      {s.mood}
                    </span>
                  </div>
                  <p class="mt-1.5 text-sm leading-relaxed text-ink-600 dark:text-ink-400">
                    {s.detail}
                  </p>
                </div>
              </article>
            ))}
          </div>

          <div class="mt-6 space-y-3">
            <p class="reveal flex items-start gap-2 rounded-2xl border border-dashed border-paper-300 bg-paper-50/60 px-4 py-3 text-xs leading-relaxed text-ink-500 dark:border-plum-700 dark:bg-plum-900/60">
              <Icon name="ph:wave-sine" class="mt-0.5 h-4 w-4 shrink-0" aria-hidden="true" />
              <span>
                One a photo can't hold: quick ear-<em>flicking</em> or twitching.
                Usually plain irritation (or a passing fly); if it comes with
                head-shaking or scratching, check her ears.
              </span>
            </p>
            <p class="reveal flex items-start gap-2 rounded-2xl bg-red-50 px-4 py-3 text-xs leading-relaxed font-medium text-red-700 ring-1 ring-red-200 dark:bg-red-950/40 dark:text-red-300 dark:ring-red-900/50">
              <Icon name="ph:hand-palm" class="mt-0.5 h-4 w-4 shrink-0" aria-hidden="true" />
              <span>
                When the signals say ease off or give space, the kind move is
                exactly that: no reaching, no scooping. Let her come back to you.
              </span>
            </p>
          </div>
        </div>
      ))
    }
  </section>

  <Footer showOnMobile />

  <script>
    // Segmented control (mirrors the Health timeline): slide the thumb, toggle
    // panels, stagger the cards in on switch. Works for any number of tabs.
    function setupSegments() {
      const seg = document.querySelector<HTMLElement>('[data-seg]');
      if (!seg || seg.dataset.bound) return;
      seg.dataset.bound = '1';
      const thumb = seg.querySelector<HTMLElement>('[data-seg-thumb]')!;
      const tabs = Array.from(seg.querySelectorAll<HTMLButtonElement>('[data-seg-tab]'));
      const panels = Array.from(document.querySelectorAll<HTMLElement>('[data-seg-panel]'));

      const animatePanel = (panel: HTMLElement) => {
        panel.querySelectorAll<HTMLElement>('article').forEach((card, i) => {
          card.classList.remove('seg-in');
          void card.offsetWidth;
          card.style.animationDelay = `${Math.min(i * 40, 320)}ms`;
          card.classList.add('seg-in');
        });
      };

      const select = (i: number) => {
        const tab = tabs[i];
        thumb.style.transform = `translateX(${i * 100}%)`;
        tabs.forEach((t) => {
          const active = t === tab;
          t.setAttribute('aria-selected', String(active));
          t.classList.toggle('text-blush-700', active);
          t.classList.toggle('dark:text-blush-300', active);
          t.classList.toggle('text-ink-400', !active);
        });
        panels.forEach((p) => {
          const show = p.dataset.segPanel === tab.dataset.segTab;
          const wasHidden = p.classList.contains('hidden');
          p.classList.toggle('hidden', !show);
          if (show && wasHidden) animatePanel(p);
        });
      };
      tabs.forEach((tab, i) => tab.addEventListener('click', () => select(i)));

      seg.addEventListener('keydown', (e) => {
        if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
        const current = tabs.findIndex((t) => t.getAttribute('aria-selected') === 'true');
        const nextIdx = (current + (e.key === 'ArrowRight' ? 1 : -1) + tabs.length) % tabs.length;
        select(nextIdx);
        tabs[nextIdx].focus();
        e.preventDefault();
      });
    }

    setupSegments();
    document.addEventListener('astro:page-load', setupSegments);
  </script>
</Layout>
