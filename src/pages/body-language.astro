---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { Icon } from 'astro-icon/components';
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import Footer from '../components/Footer.astro';
import SegmentedTabs from '../components/ui/SegmentedTabs.astro';
import { earSignals, eyeSignals } from '../data/picha';

// Signal photos, cropped from the reference chart. Match each signal by id
// (<part>-<id>.png). Each body part is a segment/panel; the same pattern
// extends to more parts by adding a segment + its own signal set + crops.
function imagesById(
  glob: Record<string, { default: ImageMetadata }>,
  part: string,
): Record<string, ImageMetadata> {
  const re = new RegExp(`${part}-(.+)\\.png$`);
  const out: Record<string, ImageMetadata> = {};
  for (const [path, mod] of Object.entries(glob)) {
    const id = path.match(re)?.[1];
    if (id) out[id] = mod.default;
  }
  return out;
}
const earImageById = imagesById(
  import.meta.glob<{ default: ImageMetadata }>('../assets/ears/*.png', { eager: true }),
  'ear',
);
const eyeImageById = imagesById(
  import.meta.glob<{ default: ImageMetadata }>('../assets/eyes/*.png', { eager: true }),
  'eye',
);

// Segments = the tabs. Each has its noun (for alt text), signal set, image
// lookup and its own footer notes (things a still photo can't capture).
const segments = [
  {
    id: 'ears',
    label: 'Ears',
    noun: 'ears',
    signals: earSignals,
    images: earImageById,
    notes: [
      {
        tone: 'info',
        icon: 'ph:wave-sine',
        text: "One a photo can't hold: quick ear-flicking or twitching. Usually plain irritation (or a passing fly); if it comes with head-shaking or scratching, check her ears.",
      },
      {
        tone: 'danger',
        icon: 'ph:hand-palm',
        text: 'When the signals say ease off or give space, the kind move is exactly that: no reaching, no scooping. Let her come back to you.',
      },
    ],
  },
  {
    id: 'eyes',
    label: 'Eyes',
    noun: 'eyes',
    signals: eyeSignals,
    images: eyeImageById,
    notes: [
      {
        tone: 'info',
        icon: 'ph:wave-sine',
        text: "Two things a still can't show: a hard, unblinking stare (a challenge, so look away and don't stare back) and the third eyelid sliding across the inner corner (often tiredness, sometimes illness).",
      },
      {
        tone: 'danger',
        icon: 'ph:first-aid',
        text: 'Eyes are also health tells. Unequal pupils that do not settle, a suddenly cloudy, red or weepy eye, constant squinting, or pawing at one eye are a vet call, not a mood.',
      },
    ],
  },
];

// tone → how to treat it, driving the corner dot + mood chip colours.
const dotTone: Record<string, string> = {
  calm: 'bg-blush-600',
  alert: 'bg-ink-400',
  wary: 'bg-amber-500',
  danger: 'bg-red-600',
};
const chipTone: Record<string, string> = {
  calm: 'bg-blush-100 text-blush-700 dark:bg-plum-800 dark:text-blush-300',
  alert: 'bg-paper-200 text-ink-600 dark:bg-plum-800 dark:text-ink-400',
  wary: 'bg-amber-300/40 text-amber-700 dark:bg-amber-700/30 dark:text-amber-300',
  danger: 'bg-red-100 text-red-700 dark:bg-red-950/50 dark:text-red-300',
};
const legend = [
  { tone: 'calm', label: 'Calm' },
  { tone: 'alert', label: 'Alert' },
  { tone: 'wary', label: 'Ease off' },
  { tone: 'danger', label: 'Give space' },
];
---

<Layout
  title="Reading Picha · Picha 🐾"
  description="A field guide to Picha's body language: what her signals mean and how to answer."
  current="tools"
  appTitle="Reading Picha"
>
  <PageHeader
    kicker="Cat to human"
    title="Reading Picha"
    blurb="She says plenty without a sound. Here is how to read Her Fluffiness, and how to answer before she has to repeat herself."
  />

  <section class="mx-auto w-full max-w-3xl px-5 pt-4 pb-10 md:pb-0" aria-label="Body language">
    <!-- Segmented tabs (one per body part) -->
    <SegmentedTabs tabs={segments.map((s) => ({ id: s.id, label: s.label }))} label="Body part" />

    <!-- Tone key -->
    <div
      class="reveal mt-4 flex flex-wrap items-center gap-x-4 gap-y-1.5 text-[11px] font-bold text-ink-400"
    >
      {
        legend.map((l) => (
          <span class="inline-flex items-center gap-1.5">
            <span class:list={['h-2 w-2 rounded-full', dotTone[l.tone]]} />
            {l.label}
          </span>
        ))
      }
    </div>

    {
      segments.map((seg, si) => (
        <div
          id={`seg-panel-${seg.id}`}
          role="tabpanel"
          aria-labelledby={`seg-tab-${seg.id}`}
          data-seg-panel={seg.id}
          class:list={['pt-5', si === 0 ? '' : 'hidden']}
        >
          <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {seg.signals.map((s) => (
              <article class="reveal overflow-hidden rounded-3xl border border-blush-200/70 bg-paper-50 dark:border-plum-700 dark:bg-plum-900">
                <div class="relative aspect-square bg-white">
                  {seg.images[s.id] && (
                    <Image
                      src={seg.images[s.id]}
                      alt={`Picha's ${seg.noun}: ${s.title.toLowerCase()}`}
                      width={320}
                      densities={[1, 2]}
                      class="h-full w-full object-contain"
                    />
                  )}
                  <span
                    class:list={[
                      'absolute top-3 left-3 rounded-full px-2.5 py-0.5 text-[11px] font-bold shadow-sm',
                      chipTone[s.tone],
                    ]}
                  >
                    {s.mood}
                  </span>
                </div>
                <div class="p-4">
                  <h3 class="font-display font-semibold">{s.title}</h3>
                  <p class="mt-1.5 text-sm leading-relaxed text-ink-600 dark:text-ink-400">
                    {s.detail}
                  </p>
                </div>
              </article>
            ))}
          </div>

          <div class="mt-6 space-y-3">
            {seg.notes.map((n) => (
              <p
                class:list={[
                  'reveal flex items-start gap-2 rounded-2xl px-4 py-3 text-xs leading-relaxed',
                  n.tone === 'danger'
                    ? 'bg-red-50 font-medium text-red-700 ring-1 ring-red-200 dark:bg-red-950/40 dark:text-red-300 dark:ring-red-900/50'
                    : 'border border-dashed border-paper-300 bg-paper-50/60 text-ink-500 dark:border-plum-700 dark:bg-plum-900/60',
                ]}
              >
                <Icon name={n.icon} class="mt-0.5 h-4 w-4 shrink-0" aria-hidden="true" />
                <span>{n.text}</span>
              </p>
            ))}
          </div>
        </div>
      ))
    }
  </section>

  <Footer />
</Layout>
