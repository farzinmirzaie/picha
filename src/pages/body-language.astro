---
import type { ImageMetadata } from 'astro';
import { Icon } from 'astro-icon/components';
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import Footer from '../components/Footer.astro';
import SegmentedTabs from '../components/ui/SegmentedTabs.astro';
import SignalCard from '../components/SignalCard.astro';
import { earSignals, eyeSignals, tailSignals } from '../data/picha';
import { getBodyLanguageCopy, localizeSignal } from '../i18n/content';

const locale = Astro.currentLocale ?? 'en';
const c = getBodyLanguageCopy(locale);

// Signal photos, cropped from the reference chart. Match each signal by id
// (<part>-<id>.png). Each body part is a segment/panel; the same pattern
// extends to more parts by adding a segment + its own signal set + crops.
function imagesById(
  glob: Record<string, { default: ImageMetadata }>,
  part: string,
): Record<string, ImageMetadata> {
  const re = new RegExp(`${part}-(.+)\\.png$`);
  const out: Record<string, ImageMetadata> = {};
  for (const [path, mod] of Object.entries(glob)) {
    const id = path.match(re)?.[1];
    if (id) out[id] = mod.default;
  }
  return out;
}
const earImageById = imagesById(
  import.meta.glob<{ default: ImageMetadata }>('../assets/ears/*.png', { eager: true }),
  'ear',
);
const eyeImageById = imagesById(
  import.meta.glob<{ default: ImageMetadata }>('../assets/eyes/*.png', { eager: true }),
  'eye',
);
const tailImageById = imagesById(
  import.meta.glob<{ default: ImageMetadata }>('../assets/tails/*.png', { eager: true }),
  'tail',
);

// Segments = the tabs. Facts (signal set, image lookup, how the photo sits, and
// each note's tone/icon) live here; the prose (label, noun, note text, and each
// signal's title/mood/detail) comes from the locale copy, zipped by order.
// `part` is the singular asset/copy prefix (ear/eye/tail); `id` is the plural
// segment/panel id (ears/eyes/tails).
const segFacts = [
  {
    id: 'ears',
    part: 'ear',
    objectPosition: 'center' as const,
    signals: earSignals,
    images: earImageById,
    noteMeta: [
      { tone: 'info', icon: 'ph:wave-sine' },
      { tone: 'danger', icon: 'ph:hand-palm' },
    ],
  },
  {
    id: 'eyes',
    part: 'eye',
    objectPosition: 'center' as const,
    signals: eyeSignals,
    images: eyeImageById,
    noteMeta: [
      { tone: 'info', icon: 'ph:wave-sine' },
      { tone: 'danger', icon: 'ph:first-aid' },
    ],
  },
  {
    id: 'tails',
    part: 'tail',
    objectPosition: 'left' as const,
    signals: tailSignals,
    images: tailImageById,
    noteMeta: [
      { tone: 'info', icon: 'ph:wave-sine' },
      { tone: 'danger', icon: 'ph:hand-palm' },
    ],
  },
];
const segments = segFacts.map((f) => {
  const copy = c.segments.find((s) => s.id === f.id)!;
  return {
    ...f,
    label: copy.label,
    noun: copy.noun,
    signals: f.signals.map((s) => localizeSignal(f.part, s, locale)),
    notes: f.noteMeta.map((m, i) => ({ ...m, text: copy.notes[i] })),
  };
});
---

<Layout
  title={c.metaTitle}
  description={c.metaDescription}
  current="tools"
  appTitle={c.title}
>
  <PageHeader kicker={c.kicker} title={c.title} blurb={c.blurb} />

  <section class="mx-auto w-full max-w-3xl px-5 pt-4 pb-10 md:pb-0" aria-label="Body language">
    <!-- Segmented tabs (one per body part) -->
    <SegmentedTabs tabs={segments.map((s) => ({ id: s.id, label: s.label }))} label={c.bodyPartLabel} />

    {
      segments.map((seg, si) => (
        <div
          id={`seg-panel-${seg.id}`}
          role="tabpanel"
          aria-labelledby={`seg-tab-${seg.id}`}
          data-seg-panel={seg.id}
          class:list={['pt-5', si === 0 ? '' : 'hidden']}
        >
          <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {seg.signals.map((s) => (
              <SignalCard
                signal={s}
                image={seg.images[s.id]}
                noun={seg.noun}
                objectPosition={seg.objectPosition}
              />
            ))}
          </div>

          <div class="mt-6 space-y-3">
            {seg.notes.map((n) => (
              <p
                class:list={[
                  'reveal flex items-start gap-2 rounded-2xl px-4 py-3 text-xs leading-relaxed',
                  n.tone === 'danger'
                    ? 'bg-red-50 font-medium text-red-700 ring-1 ring-red-200 dark:bg-red-950/40 dark:text-red-300 dark:ring-red-900/50'
                    : 'border border-dashed border-paper-300 bg-paper-50/60 text-ink-500 dark:border-plum-700 dark:bg-plum-900/60',
                ]}
              >
                <Icon name={n.icon} class="mt-0.5 h-4 w-4 shrink-0" aria-hidden="true" />
                <span>{n.text}</span>
              </p>
            ))}
          </div>
        </div>
      ))
    }
  </section>

  <Footer />
</Layout>
