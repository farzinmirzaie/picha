---
import { Icon } from 'astro-icon/components';
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Footer from '../../components/Footer.astro';
import SectionLabel from '../../components/ui/SectionLabel.astro';
import IconBadge from '../../components/ui/IconBadge.astro';
import Button from '../../components/ui/Button.astro';
import { supabaseClient } from '../../data/supabase';
---

<Layout
  title="Staff · Picha 🐾"
  description="Staff quarters: the registrar PIN lives here, for the humans on payroll."
  current="tools"
  appTitle="Staff"
>
  <PageHeader
    kicker="Members only"
    title="The staff room"
    blurb="Where the humans keep the treats, the coffee and the registrar PIN. Sign in to reach the staff-only controls management would never hand to just anyone."
  />

  <section
    class="mx-auto w-full max-w-2xl px-5 pt-4 pb-8 md:pb-0"
    aria-label="Staff controls"
    data-staff
    data-supabase-url={supabaseClient?.url}
    data-supabase-key={supabaseClient?.key}
  >
    <!-- Locked: the PIN gate. Shown until a PIN is present on this device.
         Centred vertically so it sits mid-screen, not tucked under the header. -->
    <div data-staff-lock class="reveal flex min-h-[55vh] items-center justify-center py-6">
      <form
        data-staff-form
        autocomplete="off"
        class="w-full max-w-sm rounded-3xl border border-blush-200/70 bg-paper-50 p-6 text-center shadow-sm sm:p-8 dark:border-plum-700 dark:bg-plum-900"
      >
        <IconBadge icon="ph:lock-key" size="lg" class="mx-auto" />
        <h2 class="font-display mt-4 text-xl font-semibold">Staff only</h2>
        <p class="mt-1.5 text-sm leading-relaxed text-ink-600 dark:text-ink-400">
          Registrar PIN, please. The treat cupboard is staff only. Enter it once
          and this device remembers you.
        </p>
        <label class="mt-5 block text-left">
          <span class="text-[10px] font-bold tracking-[0.14em] text-ink-400 uppercase">
            Registrar PIN
          </span>
          <input
            type="password"
            name="pin"
            required
            autocomplete="off"
            inputmode="numeric"
            placeholder="staff PIN"
            class="mt-1 w-full rounded-xl border border-blush-200/70 bg-paper-100 px-3 py-2 text-center text-lg font-bold tracking-[0.3em] outline-none focus:border-blush-400 dark:border-plum-700 dark:bg-plum-950"
          />
        </label>
        <p
          class="mt-2 hidden text-left text-xs font-bold text-red-500"
          data-staff-error
          aria-live="polite"
        >
        </p>
        <Button block type="submit" icon="ph:lock-key-open" class="mt-4">
          <span data-staff-submit-label>Unlock</span>
        </Button>
      </form>
    </div>

    <!-- Unlocked: staff controls. Revealed once a PIN is present. -->
    <div data-staff-panel hidden>
      <div
        class="flex items-center gap-3 rounded-2xl border border-blush-200/70 bg-blush-100/40 px-5 py-3.5 dark:border-plum-700 dark:bg-plum-800/40"
      >
        <Icon
          name="ph:shield-check"
          class="h-5 w-5 shrink-0 text-blush-600 dark:text-blush-300"
          aria-hidden="true"
        />
        <p class="text-sm font-bold text-blush-700 dark:text-blush-300">
          You're in; treats are in the top drawer. This device can now log
          weigh-ins, Academy progress and daily rounds.
        </p>
      </div>

      <SectionLabel class="mt-8 mb-2">Reminders</SectionLabel>
      <div
        class="overflow-hidden rounded-3xl border border-blush-200/70 bg-paper-50 dark:border-plum-700 dark:bg-plum-900"
      >
        <button
          type="button"
          data-push-toggle
          class="flex w-full items-center gap-3.5 px-5 py-4 text-left transition-colors active:bg-blush-100/50 disabled:cursor-default disabled:active:bg-transparent dark:active:bg-plum-800/50"
        >
          <IconBadge icon="ph:bell" size="sm" />
          <span class="min-w-0 flex-1">
            <span class="block font-bold text-ink-900 dark:text-paper-100">
              Reminders on this device
            </span>
            <span class="block text-xs leading-relaxed text-ink-400" data-push-sub>
              A nudge every few hours while daily rounds are still pending.
            </span>
          </span>
          <span
            data-push-state
            class="shrink-0 rounded-full bg-paper-200 px-2.5 py-0.5 text-[11px] font-bold text-ink-600 dark:bg-plum-800 dark:text-ink-400"
          >
            Off
          </span>
        </button>
      </div>
      <p
        class="mt-3 hidden px-1 text-[11px] leading-relaxed text-ink-400"
        data-push-note
        aria-live="polite"
      >
      </p>

      <SectionLabel class="mt-8 mb-2">This device</SectionLabel>
      <div
        class="overflow-hidden rounded-3xl border border-blush-200/70 bg-paper-50 dark:border-plum-700 dark:bg-plum-900"
      >
        <button
          type="button"
          data-staff-forget
          class="flex w-full items-center gap-3.5 px-5 py-4 text-left transition-colors active:bg-blush-100/50 dark:active:bg-plum-800/50"
        >
          <IconBadge icon="ph:sign-out" size="sm" tone="red" />
          <span class="min-w-0 flex-1">
            <span class="block font-bold text-ink-900 dark:text-paper-100">
              Forget the PIN on this device
            </span>
            <span class="block text-xs leading-relaxed text-ink-400">
              Clears the saved PIN here. Other devices are untouched, and the
              PIN itself never changes.
            </span>
          </span>
          <Icon
            name="ph:caret-right"
            class="h-4 w-4 shrink-0 text-ink-400"
            aria-hidden="true"
          />
        </button>
      </div>
      <p class="mt-3 px-1 text-[11px] leading-relaxed text-ink-400">
        More staff controls will move in over time. For now it's mostly a treat
        jar, a kettle and a coat rack.
      </p>
    </div>
  </section>

  <Footer />

  <script>
    // The Staff tool: a PIN gate over staff-only controls, and the ONE place
    // the registrar PIN is entered. The same PIN unlocks the weigh-in ledger,
    // the Academy and the rounds sync (localStorage 'picha-staff-pin'); those
    // pages only read it, never prompt for it. A stored PIN counts as unlocked;
    // entering one verifies against the cloud (check_pin) before saving.
    import { hasStaffPin, setStaffPin, forgetStaffPin, staffPin } from '../../lib/staff';
    import { getPushState, enablePush, disablePush } from '../../lib/push';

    function render() {
      const root = document.querySelector<HTMLElement>('[data-staff]');
      if (!root) return;
      const lock = root.querySelector<HTMLElement>('[data-staff-lock]');
      const panel = root.querySelector<HTMLElement>('[data-staff-panel]');
      if (!lock || !panel) return;
      const unlocked = hasStaffPin();
      lock.hidden = unlocked;
      panel.hidden = !unlocked;
      if (unlocked) renderPush();
    }

    const CHIP_OFF =
      'shrink-0 rounded-full bg-paper-200 px-2.5 py-0.5 text-[11px] font-bold text-ink-600 dark:bg-plum-800 dark:text-ink-400';
    const CHIP_ON =
      'shrink-0 rounded-full bg-blush-600 px-2.5 py-0.5 text-[11px] font-bold text-white';

    // Reflect the current push state onto the toggle. Runs whenever the panel
    // is (re)shown, so returning to the page after granting/blocking in the
    // browser updates the label without a manual refresh.
    async function renderPush() {
      const toggle = document.querySelector<HTMLButtonElement>('[data-push-toggle]');
      const chip = document.querySelector<HTMLElement>('[data-push-state]');
      const note = document.querySelector<HTMLElement>('[data-push-note]');
      if (!toggle || !chip || !note) return;
      const state = await getPushState();
      const on = state === 'subscribed';
      chip.textContent = on ? 'On' : 'Off';
      chip.className = on ? CHIP_ON : CHIP_OFF;
      toggle.disabled = state === 'unsupported';
      const notes: Record<string, string> = {
        unsupported: "This browser can't deliver reminders while the app is closed.",
        denied:
          'Notifications are blocked for this site. Turn them on in your browser settings, then tap again.',
        subscribed:
          'On. A nudge every few hours while rounds are pending (quiet overnight); silent once the list is clear.',
        unsubscribed: 'Off. Tap to get a nudge while daily rounds are still pending.',
        default: 'Off. Tap to get a nudge while daily rounds are still pending.',
      };
      setPushNote(notes[state] ?? '', false);
    }

    function setPushNote(msg: string, isError: boolean) {
      const note = document.querySelector<HTMLElement>('[data-push-note]');
      if (!note) return;
      note.textContent = msg;
      note.classList.toggle('hidden', !msg);
      note.classList.toggle('text-red-500', isError);
      note.classList.toggle('text-ink-400', !isError);
    }

    function showError(msg: string) {
      const el = document.querySelector<HTMLElement>('[data-staff-error]');
      if (!el) return;
      el.textContent = msg;
      el.classList.toggle('hidden', !msg);
    }

    function setupStaff() {
      const root = document.querySelector<HTMLElement>('[data-staff]');
      if (!root || root.dataset.bound) return;
      root.dataset.bound = '1';

      const url = root.dataset.supabaseUrl;
      const key = root.dataset.supabaseKey;

      const form = root.querySelector<HTMLFormElement>('[data-staff-form]');
      form?.addEventListener('submit', async (e) => {
        e.preventDefault();
        showError('');
        const input = form.elements.namedItem('pin') as HTMLInputElement;
        const pin = input.value.trim();
        if (!pin) return;

        const label = form.querySelector<HTMLElement>('[data-staff-submit-label]');
        const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]');

        // Try to verify against the cloud when it's configured. Only an
        // explicit rejection ('wrong pin') blocks sign-in. Any other outcome
        // (check_pin not deployed yet, schema-cache lag, offline) accepts the
        // entry: the write RPCs still enforce the PIN, and a bad one signs the
        // device back out on first use. So a correct PIN never gets stuck on a
        // "couldn't reach the cloud" false alarm.
        if (url && key) {
          if (label) label.textContent = 'Checking…';
          if (submit) submit.disabled = true;
          let wrong = false;
          try {
            const { sbRpc } = await import('../../lib/sb');
            await sbRpc(url, key, 'check_pin', { p_pin: pin });
          } catch (err) {
            wrong = String(err).includes('wrong pin');
          } finally {
            if (submit) submit.disabled = false;
            if (label) label.textContent = 'Unlock';
          }
          if (wrong) {
            showError('That PIN was not recognised. Try again.');
            return;
          }
        }

        setStaffPin(pin);
        input.value = '';
        render();
      });

      const forget = root.querySelector<HTMLButtonElement>('[data-staff-forget]');
      forget?.addEventListener('click', async () => {
        // Turn reminders off with the PIN still available, then forget it.
        if (url && key) await disablePush(url, key).catch(() => {});
        forgetStaffPin();
        showError('');
        render();
      });

      const pushToggle = root.querySelector<HTMLButtonElement>('[data-push-toggle]');
      pushToggle?.addEventListener('click', async () => {
        setPushNote('Working…', false);
        pushToggle.disabled = true;
        let errMsg = '';
        try {
          if (!url || !key) throw new Error('The cloud is not configured.');
          const state = await getPushState();
          if (state === 'subscribed') {
            await disablePush(url, key);
          } else {
            const pin = staffPin();
            if (!pin) throw new Error('Sign in first.');
            await enablePush(url, key, pin);
          }
        } catch (err) {
          errMsg = String(err).includes('wrong pin')
            ? 'That PIN was rejected. Sign out and back in, then try again.'
            : (err as Error).message || 'Could not update reminders.';
        } finally {
          pushToggle.disabled = false;
          await renderPush(); // refresh chip + default note...
          if (errMsg) setPushNote(errMsg, true); // ...then surface any error over it
        }
      });

      render();
    }

    setupStaff();
    document.addEventListener('astro:page-load', setupStaff);
    // Re-check push state when the tab returns to the foreground (permission
    // may have changed in browser settings while we were away).
    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'visible' && hasStaffPin()) renderPush();
    });
  </script>
</Layout>
