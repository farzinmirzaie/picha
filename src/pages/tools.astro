---
import { Icon } from 'astro-icon/components';
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import Footer from '../components/Footer.astro';
import PassportDialog from '../components/PassportDialog.astro';
import ToolCard from '../components/ToolCard.astro';
import SectionLabel from '../components/ui/SectionLabel.astro';
import { getToolsCopy } from '../i18n/content';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const locale = Astro.currentLocale ?? 'en';
const lb = locale === 'en' ? base : `${base}/${locale}`;
const c = getToolsCopy(locale);

// Facts (icon + destination) stay here; titles/details come from the locale
// copy, zipped by order. Future tools: add the href/icon here AND a matching
// entry to every locale's `cards` in i18n/content.ts.
const hrefs = [
  { icon: 'ph:lock-key', href: `${lb}/tools/staff/` },
  { icon: 'ph:chart-line-up', href: `${lb}/weight/` },
  { icon: 'ph:hourglass', href: `${lb}/cat-years/` },
  { icon: 'ph:graduation-cap', href: `${lb}/training/` },
  { icon: 'ph:cat', href: `${lb}/body-language/` },
];
const inService = hrefs.map((h, i) => ({ ...h, ...c.cards[i] }));
---

<Layout title={c.metaTitle} description={c.metaDescription} current="tools">
  <PageHeader kicker={c.kicker} title={c.title} blurb={c.blurb} />

  <!-- In service: tools that already shipped -->
  <section class="mx-auto w-full max-w-2xl px-5 pt-4" aria-label={c.inServiceLabel}>
    <SectionLabel class="reveal">{c.inServiceLabel}</SectionLabel>
    <ToolCard
      icon="ph:identification-card"
      title={c.passport.title}
      detail={c.passport.detail}
      data-passport-open
    />
    {inService.map((t) => <ToolCard {...t} data-astro-prefetch />)}
  </section>

  <section class="mx-auto w-full max-w-2xl px-5 pt-8" aria-label="Workshop note">
    <p
      class="reveal flex items-center gap-2 rounded-2xl border border-dashed border-paper-300 bg-paper-50/60 px-4 py-3 text-xs text-ink-400 dark:border-plum-700 dark:bg-plum-900/60"
    >
      <Icon name="ph:moon-stars" class="h-4 w-4 shrink-0" aria-hidden="true" />
      {c.note}
    </p>
  </section>

  <Footer showOnMobile />
  <PassportDialog />
</Layout>
