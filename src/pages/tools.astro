---
import { Icon } from 'astro-icon/components';
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import Footer from '../components/Footer.astro';
import PassportDialog from '../components/PassportDialog.astro';

// Future tools land here: build the page, then move its entry from this queue
// to a real link (or give it its own nav tab if it earns one).
const queue = [
  {
    icon: 'ph:chat-circle-dots',
    title: 'Body-language decoder',
    detail: 'What the tail, ears and slow blinks actually mean.',
    status: 'Sketching',
  },
  {
    icon: 'ph:calculator',
    title: 'Food calculator',
    detail: 'Portions by weight and age — no more guesswork at the bowl.',
    status: 'On the bench',
  },
  {
    icon: 'ph:chart-line-up',
    title: 'Weight tracker',
    detail: 'The royal waistline, charted over time.',
    status: 'Waiting for parts',
  },
  {
    icon: 'ph:bell',
    title: 'Care reminders',
    detail: 'Boosters, ear drops and nail trims — nudges for the staff.',
    status: 'Queued',
  },
];
---

<Layout title="Tools · Picha 🐾" current="tools">
  <PageHeader
    kicker="Tools"
    title="The workshop"
    blurb="Gadgets for her staff. The passport is already in service — everything else awaits the supervisor's sign-off on the blueprints."
  />

  <!-- In service: tools that already shipped -->
  <section class="mx-auto w-full max-w-2xl px-5 pt-4" aria-label="In service">
    <h2
      class="reveal text-[11px] font-bold tracking-[0.24em] text-blush-500 uppercase dark:text-blush-300"
    >
      In service
    </h2>
    <button
      type="button"
      data-passport-open
      class="reveal mt-3 flex w-full items-center gap-4 rounded-3xl border border-blush-200/70 bg-paper-50 p-5 text-left shadow-sm transition-all duration-200 hover:-translate-y-0.5 hover:shadow-md active:translate-y-0 dark:border-plum-700 dark:bg-plum-900"
    >
      <span
        class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-blush-100 text-blush-600 dark:bg-plum-800 dark:text-blush-300"
        aria-hidden="true"
      >
        <Icon name="ph:identification-card" class="h-5.5 w-5.5" />
      </span>
      <span class="min-w-0 flex-1">
        <span class="font-display text-lg font-semibold">Pet Passport</span>
        <span class="mt-0.5 block text-sm leading-relaxed text-ink-600 dark:text-ink-400">
          Her official document — particulars, microchip and the registrar's paw.
        </span>
      </span>
      <Icon
        name="ph:caret-right"
        class="h-4 w-4 shrink-0 text-ink-400"
        aria-hidden="true"
      />
    </button>
  </section>

  <section class="mx-auto w-full max-w-2xl px-5 pt-10" aria-label="Build queue">
    <h2
      class="reveal text-[11px] font-bold tracking-[0.24em] text-blush-500 uppercase dark:text-blush-300"
    >
      The build queue
    </h2>
    <ol class="mt-3 divide-y divide-paper-300/70 dark:divide-plum-800">
      {
        queue.map((t, i) => (
          <li
            class="reveal flex items-start gap-4 py-5"
            style={`--reveal-delay: ${i * 80}ms`}
          >
            <span
              class="pen mt-1 w-8 shrink-0 text-right text-sm"
              aria-hidden="true"
            >
              {String(i + 1).padStart(2, '0')}
            </span>
            <span
              class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-blush-100 text-blush-600 dark:bg-plum-800 dark:text-blush-300"
              aria-hidden="true"
            >
              <Icon name={t.icon} class="h-5.5 w-5.5" />
            </span>
            <div class="min-w-0">
              <div class="flex flex-wrap items-center gap-2">
                <h3 class="font-display text-lg font-semibold">{t.title}</h3>
                <span class="rounded-full border border-dashed border-blush-300/80 px-2.5 py-0.5 text-[11px] font-bold text-blush-600 dark:border-plum-600 dark:text-blush-300">
                  {t.status}
                </span>
              </div>
              <p class="mt-0.5 text-sm leading-relaxed text-ink-600 dark:text-ink-400">
                {t.detail}
              </p>
            </div>
          </li>
        ))
      }
    </ol>

    <p
      class="reveal mt-6 flex items-center gap-2 rounded-2xl border border-dashed border-paper-300 bg-paper-50/60 px-4 py-3 text-xs text-ink-400 dark:border-plum-700 dark:bg-plum-900/60"
    >
      <Icon name="ph:moon-stars" class="h-4 w-4 shrink-0" aria-hidden="true" />
      The queue is reviewed nightly, during the 3 a.m. zoomies. Priorities are
      subject to Her Fluffiness.
    </p>
  </section>

  <Footer showOnMobile />
  <PassportDialog />
</Layout>
