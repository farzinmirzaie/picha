---
import { Icon } from 'astro-icon/components';
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import Footer from '../components/Footer.astro';
import PassportDialog from '../components/PassportDialog.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Future tools land here: build the page, then add its entry to `inService`
// (or give it its own nav tab if it earns one).
const inService = [
  {
    icon: 'ph:chart-line-up',
    title: 'Weight tracker',
    detail: 'The royal waistline, charted over time.',
    href: `${base}/weight/`,
  },
  {
    icon: 'ph:hourglass',
    title: 'Cat-years converter',
    detail: 'How old is she, really? Works for any cat you know.',
    href: `${base}/cat-years/`,
  },
  {
    icon: 'ph:graduation-cap',
    title: 'The Royal Academy',
    detail: 'Staff certification in advanced cat cooperation, one course at a time.',
    href: `${base}/training/`,
  },
  {
    icon: 'ph:lock-key',
    title: 'Staff room',
    detail: 'Members only: the registrar PIN, kept on your device.',
    href: `${base}/tools/staff/`,
  },
];

---

<Layout
  title="Tools · Picha 🐾"
  description="Picha's toolbox: pet passport, weight tracker, cat-years converter and the Royal Academy."
  current="tools"
>
  <PageHeader
    kicker="Tools"
    title="The royal workshop"
    blurb="Gadgets invented by the staff to serve Her Fluffiness better. Each one enters service only after passing her personal inspection."
  />

  <!-- In service: tools that already shipped -->
  <section class="mx-auto w-full max-w-2xl px-5 pt-4" aria-label="In service">
    <h2
      class="reveal text-[11px] font-bold tracking-[0.24em] text-blush-500 uppercase dark:text-blush-300"
    >
      In service
    </h2>
    <button
      type="button"
      data-passport-open
      class="reveal group mt-3 flex w-full items-center gap-4 rounded-3xl border border-blush-200/70 bg-paper-50 p-5 text-left shadow-sm transition-all duration-200 hover:-translate-y-0.5 hover:shadow-md active:translate-y-0 dark:border-plum-700 dark:bg-plum-900"
    >
      <span
        class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-blush-100 text-blush-600 dark:bg-plum-800 dark:text-blush-300"
        aria-hidden="true"
      >
        <Icon name="ph:identification-card" class="h-5.5 w-5.5" />
      </span>
      <span class="min-w-0 flex-1">
        <span class="font-display text-lg font-semibold">Pet Passport</span>
        <span class="mt-0.5 block text-sm leading-relaxed text-ink-600 dark:text-ink-400">
          Her official document: particulars, microchip and the registrar's paw.
        </span>
      </span>
      <Icon
        name="ph:caret-right"
        class="h-4 w-4 shrink-0 text-ink-400 transition-transform duration-200 group-hover:translate-x-1"
        aria-hidden="true"
      />
    </button>
    {
      inService.map((t) => (
        <a
          href={t.href}
          data-astro-prefetch
          class="reveal group mt-3 flex w-full items-center gap-4 rounded-3xl border border-blush-200/70 bg-paper-50 p-5 text-left shadow-sm transition-all duration-200 hover:-translate-y-0.5 hover:shadow-md active:translate-y-0 dark:border-plum-700 dark:bg-plum-900"
        >
          <span
            class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-blush-100 text-blush-600 dark:bg-plum-800 dark:text-blush-300"
            aria-hidden="true"
          >
            <Icon name={t.icon} class="h-5.5 w-5.5" />
          </span>
          <span class="min-w-0 flex-1">
            <span class="font-display text-lg font-semibold">{t.title}</span>
            <span class="mt-0.5 block text-sm leading-relaxed text-ink-600 dark:text-ink-400">
              {t.detail}
            </span>
          </span>
          <Icon
            name="ph:caret-right"
            class="h-4 w-4 shrink-0 text-ink-400 transition-transform duration-200 group-hover:translate-x-1"
            aria-hidden="true"
          />
        </a>
      ))
    }
  </section>

  <section class="mx-auto w-full max-w-2xl px-5 pt-8" aria-label="Workshop note">
    <p
      class="reveal flex items-center gap-2 rounded-2xl border border-dashed border-paper-300 bg-paper-50/60 px-4 py-3 text-xs text-ink-400 dark:border-plum-700 dark:bg-plum-900/60"
    >
      <Icon name="ph:moon-stars" class="h-4 w-4 shrink-0" aria-hidden="true" />
      More gadgets are in the works. Ideas are reviewed nightly, during the
      3 a.m. zoomies, and prioritised by Her Fluffiness.
    </p>
  </section>

  <Footer showOnMobile />
  <PassportDialog />
</Layout>
