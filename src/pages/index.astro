---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
import pichaPhoto from '../assets/picha.jpg';
import {
  identity,
  microchip,
  personality,
  likes,
  dislikes,
  ageLabel,
} from '../data/picha';

const age = ageLabel();

// Passport booklet fields — modelled on the Malaysian government pet passport
// (Jabatan Perkhidmatan Veterinar layout): bilingual labels, pen-blue values.
const particulars = [
  { my: 'Nama Haiwan Kesayangan', en: "Pet's Name", value: identity.name },
  { my: 'Spesis', en: 'Species', value: 'Feline' },
  { my: 'Baka', en: 'Breed', value: identity.breed },
  { my: 'Jantina', en: 'Sex', value: 'Betina (Female)' },
  { my: 'Mandul', en: 'Neutered', value: 'Ya (Yes)' },
  { my: 'Warna', en: 'Colour', value: identity.colour },
  { my: 'Tarikh Lahir', en: 'Date of Birth', value: identity.bornLabel },
  { my: 'No. Pasport', en: 'Passport No.', value: 'Pending — paperwork filed under her bed' },
];
---

<Layout title="Picha 🐾" description={`Picha — ${identity.breed}. ${identity.tagline}`} current="home">
  <!-- Hero -->
  <header class="mx-auto w-full max-w-2xl px-5 pt-10 text-center sm:pt-14">
    <div class="hero-pop relative mx-auto w-52 sm:w-64">
      <!-- arch-shaped portrait -->
      <div
        class="wiggle-hover relative aspect-[4/5] overflow-hidden rounded-t-full rounded-b-[2.5rem] shadow-xl ring-4 ring-white dark:ring-plum-800"
      >
        <Image
          src={pichaPhoto}
          alt="Picha, an all-white cat with amber eyes and a pink collar, mid-meow"
          width={512}
          densities={[1, 2]}
          class="h-full w-full object-cover"
          style="object-position: 50% 30%"
          loading="eager"
        />
      </div>
      <span
        class="float-slow absolute -right-8 top-6 text-2xl opacity-60"
        aria-hidden="true">🐾</span
      >
      <span
        class="float-slow absolute -left-7 bottom-10 text-xl opacity-40 [animation-delay:1.2s]"
        aria-hidden="true">🐾</span
      >
    </div>

    <h1
      class="font-display mt-6 text-6xl font-semibold tracking-tight text-blush-600 sm:text-7xl dark:text-blush-300"
    >
      Picha
    </h1>
    <p class="font-display mt-2 text-lg italic text-ink-600 sm:text-xl dark:text-ink-400">
      {identity.tagline}
    </p>
    <p class="mt-2 text-sm font-bold text-amber-700 dark:text-amber-300">
      {identity.breed} · <span data-age>{age}</span>
    </p>

    <button
      id="passport-open"
      type="button"
      class="mt-6 inline-flex items-center gap-2 rounded-full border border-blush-300/70 bg-paper-50 px-5 py-2 text-sm font-bold text-blush-700 shadow-sm transition-all duration-200 hover:-translate-y-0.5 hover:shadow-md active:translate-y-0 dark:border-plum-700 dark:bg-plum-900 dark:text-blush-300"
    >
      🛂 View her passport
    </button>
  </header>

  <!-- Story -->
  <section class="mx-auto w-full max-w-2xl px-5 pt-12" aria-label="Her story">
    <p
      class="reveal font-display text-xl leading-relaxed font-medium text-ink-900 sm:text-2xl sm:leading-relaxed dark:text-paper-100"
    >
      {identity.story}
    </p>
    <p class="reveal mt-5 leading-relaxed text-ink-600 dark:text-ink-400">
      {identity.looks}
    </p>
  </section>

  <!-- Likes & dislikes -->
  <section class="mx-auto w-full max-w-2xl px-5 pt-14" aria-label="Likes and dislikes">
    <div class="grid gap-8 sm:grid-cols-2">
      <div>
        <h2
          class="reveal text-[11px] font-bold tracking-[0.24em] text-blush-500 uppercase dark:text-blush-300"
        >
          💗 Loves
        </h2>
        <ul class="mt-3 flex flex-wrap gap-2">
          {
            likes.map((l, i) => (
              <li
                class="reveal rounded-full bg-blush-100 px-3.5 py-1.5 text-sm font-bold text-blush-700 dark:bg-plum-800 dark:text-blush-300"
                style={`--reveal-delay: ${i * 60}ms`}
              >
                {l}
              </li>
            ))
          }
        </ul>
      </div>
      <div>
        <h2
          class="reveal text-[11px] font-bold tracking-[0.24em] text-ink-400 uppercase"
        >
          🙅 Could live without
        </h2>
        <ul class="mt-3 flex flex-wrap gap-2">
          {
            dislikes.map((d, i) => (
              <li
                class="reveal rounded-full border border-paper-300 bg-paper-50 px-3.5 py-1.5 text-sm font-bold text-ink-600 dark:border-plum-700 dark:bg-plum-900 dark:text-ink-400"
                style={`--reveal-delay: ${i * 60}ms`}
              >
                {d}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- Personality -->
  <section class="mx-auto w-full max-w-2xl px-5 pt-14" aria-label="Personality">
    <h2
      class="reveal text-[11px] font-bold tracking-[0.24em] text-blush-500 uppercase dark:text-blush-300"
    >
      What she's like
    </h2>
    <ul class="mt-2 divide-y divide-paper-300/70 dark:divide-plum-800">
      {
        personality.map((p, i) => (
          <li
            class="reveal flex items-start gap-4 py-5"
            style={`--reveal-delay: ${i * 80}ms`}
          >
            <span
              class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-blush-100 text-xl dark:bg-plum-800"
              aria-hidden="true"
            >
              {p.icon}
            </span>
            <div>
              <h3 class="font-display text-lg font-semibold">{p.title}</h3>
              <p class="mt-0.5 text-sm leading-relaxed text-ink-600 dark:text-ink-400">
                {p.detail}
              </p>
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  <Footer />

  <!-- Passport dialog: a physical document, so it stays cream in dark mode -->
  <dialog id="passport" class="passport" aria-labelledby="passport-title">
    <div class="overflow-hidden rounded-2xl bg-[#fbf7ef] text-[#3a3a3a] shadow-2xl">
      <!-- cover strip -->
      <div class="flex items-center justify-between bg-blush-600 px-5 py-3">
        <h2
          id="passport-title"
          class="text-[11px] font-bold tracking-[0.22em] text-white uppercase sm:text-xs"
        >
          Pasport Haiwan · Pet Passport
        </h2>
        <form method="dialog">
          <button
            class="flex h-8 w-8 items-center justify-center rounded-full bg-white/20 text-white transition-colors hover:bg-white/35"
            aria-label="Close passport"
          >
            ✕
          </button>
        </form>
      </div>

      <div class="grid sm:grid-cols-2">
        <!-- left page: particulars -->
        <div class="border-b border-dashed border-[#d8cfc0] p-5 sm:border-r sm:border-b-0 sm:p-6">
          <h3 class="text-[10px] font-bold tracking-[0.18em] uppercase">
            Butiran Haiwan <span class="font-normal italic">/ Pet's Particulars</span>
          </h3>
          <dl class="mt-4 space-y-3">
            {
              particulars.map((f) => (
                <div class="grid grid-cols-[7.5rem_1fr] items-end gap-2 sm:grid-cols-[8.5rem_1fr]">
                  <dt class="text-[10px] leading-tight font-bold">
                    {f.my}
                    <span class="block font-normal italic opacity-70">({f.en})</span>
                  </dt>
                  <dd class="pen border-b border-dotted border-[#b9ad99] pb-0.5 text-xs sm:text-sm">
                    {f.value}
                  </dd>
                </div>
              ))
            }
          </dl>
          <!-- registrar stamp -->
          <div
            class="mt-6 -rotate-3 rounded-lg border-2 border-blush-400/70 px-3 py-2 text-center text-[9px] font-bold tracking-[0.14em] text-blush-500/90 uppercase w-fit"
            aria-hidden="true"
          >
            🐾 Royal Household of Picha<br />
            <span class="font-normal normal-case italic tracking-normal"
              >Tandatangan (Signature): paw on file</span
            >
          </div>
        </div>

        <!-- right page: identity -->
        <div class="p-5 sm:p-6">
          <h3 class="text-[10px] font-bold tracking-[0.18em] uppercase">
            Pengenalan Haiwan <span class="font-normal italic">/ Pet Identity</span>
          </h3>

          <div class="mt-4">
            <p class="text-[10px] font-bold">
              No. Mikrocip <span class="font-normal italic opacity-70">(Microchip No.)</span>
            </p>
            <div class="mt-1.5 rounded-md border border-[#d8cfc0] bg-white px-3 py-2">
              <div class="barcode h-9 w-full" aria-hidden="true"></div>
              <p class="mt-1 text-center font-mono text-xs tracking-[0.28em]">
                {microchip}
              </p>
            </div>
          </div>

          <div class="mt-4 grid grid-cols-[7.5rem_1fr] items-end gap-2 sm:grid-cols-[8.5rem_1fr]">
            <p class="text-[10px] leading-tight font-bold">
              Lokasi Mikrocip Ditanam
              <span class="block font-normal italic opacity-70">(Site of Implant)</span>
            </p>
            <p class="pen border-b border-dotted border-[#b9ad99] pb-0.5 text-xs sm:text-sm">
              Between shoulders
            </p>
          </div>

          <div class="mt-5">
            <p class="text-center text-[10px] font-bold">
              Gambar Haiwan Kesayangan
              <span class="font-normal italic opacity-70">(Pet photo)</span>
            </p>
            <div
              class="mx-auto mt-2 w-40 rotate-1 border-4 border-white shadow-md sm:w-44"
            >
              <Image
                src={pichaPhoto}
                alt="Passport photo of Picha"
                width={352}
                densities={[1, 2]}
                class="aspect-square h-auto w-full object-cover"
                style="object-position: 50% 20%"
              />
            </div>
          </div>
        </div>
      </div>
    </div>
  </dialog>

  <script>
    function setupPassport() {
      const dialog = document.getElementById('passport') as HTMLDialogElement | null;
      const openBtn = document.getElementById('passport-open');
      if (!dialog || !openBtn || openBtn.dataset.bound) return;
      openBtn.dataset.bound = '1';
      openBtn.addEventListener('click', () => dialog.showModal());
      // click on the backdrop (the dialog element itself) closes it
      dialog.addEventListener('click', (e) => {
        if (e.target === dialog) dialog.close();
      });
    }
    setupPassport();
    document.addEventListener('astro:page-load', setupPassport);
  </script>
</Layout>
