---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
import ShareDialog from '../components/ShareDialog.astro';
import {
  identity,
  contact,
  personality,
  likes,
  dislikes,
  ageLabel,
} from '../data/picha';

const age = ageLabel();

// Highlight the household names in the story in the brand pink.
const storyHtml = identity.story.replace(
  /\b(Picha|Farah|Farzin)\b/g,
  '<span class="font-semibold text-blush-600 dark:text-blush-300">$1</span>',
);

// Hero slideshow: every picha*.jpg in assets, picha.jpg first then numerically.
// Drop a new photo in as picha-<n>.jpg and it joins the rotation automatically.
const slideModules = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/picha*.jpg',
  { eager: true },
);
const slideNo = (path: string) => parseInt(path.match(/picha-(\d+)/)?.[1] ?? '0', 10);
const slides = Object.entries(slideModules)
  .sort(([a], [b]) => slideNo(a) - slideNo(b))
  .map(([, m]) => m.default);

---

<Layout title="Picha 🐾" description={`Picha: ${identity.breed}. ${identity.tagline}`} current="home">
  <!-- Hero -->
  <header class="mx-auto w-full max-w-2xl px-5 pt-10 text-center sm:pt-14">
    <div class="hero-pop relative mx-auto w-52 sm:w-64">
      <!-- arch-shaped portrait: crossfading slideshow of her photos -->
      <div
        class="wiggle-hover relative aspect-[4/5] overflow-hidden rounded-t-full rounded-b-[2.5rem] shadow-xl ring-4 ring-white dark:ring-plum-800"
        role="img"
        aria-label="Photos of Picha, an all-white cat with amber eyes and a pink collar"
      >
        {
          slides.map((s, i) => (
            <Image
              src={s}
              alt=""
              width={512}
              densities={[1, 2]}
              class:list={[
                'absolute inset-0 h-full w-full object-cover transition-opacity duration-1000',
                i === 0 ? 'opacity-100' : 'opacity-0',
              ]}
              style="object-position: 50% 30%"
              loading={i === 0 ? 'eager' : 'lazy'}
              data-hero-slide
            />
          ))
        }
      </div>
      <Icon
        name="ph:paw-print"
        class="float-slow absolute -right-8 top-6 h-7 w-7 rotate-12 text-blush-400/70"
        aria-hidden="true"
      />
      <Icon
        name="ph:paw-print"
        class="float-slow absolute -left-7 bottom-10 h-5 w-5 -rotate-12 text-blush-400/50 [animation-delay:1.2s]"
        aria-hidden="true"
      />
      <Icon
        name="ph:cat"
        class="float-slow absolute -left-9 top-10 h-6 w-6 -rotate-6 text-blush-400/60 [animation-delay:0.6s]"
        aria-hidden="true"
      />
      <Icon
        name="ph:cat"
        class="float-slow absolute -right-7 bottom-6 h-5 w-5 rotate-6 text-blush-400/40 [animation-delay:1.8s]"
        aria-hidden="true"
      />
    </div>

    <h1
      class="font-display mt-6 text-6xl font-semibold tracking-tight text-blush-600 sm:text-7xl dark:text-blush-300"
    >
      Picha
    </h1>
    <p class="font-display mt-2 text-lg italic text-ink-600 sm:text-xl dark:text-ink-400">
      {identity.tagline}
    </p>
    <p class="mt-2 text-sm font-bold text-amber-700 dark:text-amber-300">
      {identity.breed} · <span data-age>{age}</span>
    </p>

    <!-- desktop only; on mobile the app bar carries this action -->
    <button
      type="button"
      data-share-open
      class="mt-6 hidden items-center gap-2 rounded-full border border-blush-300/70 bg-paper-50 px-5 py-2 text-sm font-bold text-blush-700 shadow-sm transition-all duration-200 hover:-translate-y-0.5 hover:shadow-md active:translate-y-0 md:inline-flex dark:border-plum-700 dark:bg-plum-900 dark:text-blush-300"
    >
      <Icon name="ph:share-network" class="h-4.5 w-4.5" aria-hidden="true" />
      Share
    </button>
  </header>

  <!-- Story -->
  <section class="mx-auto w-full max-w-2xl px-5 pt-12" aria-label="Her story">
    <p
      class="reveal font-display text-xl leading-relaxed font-medium text-ink-900 sm:text-2xl sm:leading-relaxed dark:text-paper-100"
      set:html={storyHtml}
    />
    <p class="reveal mt-5 leading-relaxed text-ink-600 dark:text-ink-400">
      {identity.looks}
    </p>
  </section>

  <!-- Get to know her -->
  <section class="mx-auto w-full max-w-2xl px-5 pt-14" aria-label="Get to know her">
    <h2
      class="reveal text-[11px] font-bold tracking-[0.24em] text-blush-500 uppercase dark:text-blush-300"
    >
      Get to know her
    </h2>
    <ul class="mt-2 divide-y divide-paper-300/70 dark:divide-plum-800">
      {
        personality.map((p, i) => (
          <li
            class="reveal flex items-start gap-4 py-5"
            style={`--reveal-delay: ${i * 80}ms`}
          >
            <span
              class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-blush-100 text-blush-600 dark:bg-plum-800 dark:text-blush-300"
              aria-hidden="true"
            >
              <Icon name={p.icon} class="h-5.5 w-5.5" />
            </span>
            <div>
              <h3 class="font-display text-lg font-semibold">{p.title}</h3>
              <p class="mt-0.5 text-sm leading-relaxed text-ink-600 dark:text-ink-400">
                {p.detail}
              </p>
            </div>
          </li>
        ))
      }
    </ul>

    <!-- quick intel: two columns; the traits above carry the depth -->
    <div
      class="reveal mt-6 grid grid-cols-2 gap-6 border-t border-paper-300/70 pt-6 dark:border-plum-800"
    >
      <div>
        <h3
          class="flex items-center gap-1.5 text-[11px] font-bold tracking-[0.18em] text-blush-500 uppercase dark:text-blush-300"
        >
          <Icon name="ph:heart" class="h-3.5 w-3.5" aria-hidden="true" /> Loves
        </h3>
        <ul class="mt-2.5 space-y-2">
          {
            likes.map((l) => (
              <li class="flex items-start gap-2.5 text-sm text-ink-600 dark:text-ink-400">
                <span
                  class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-blush-400"
                  aria-hidden="true"
                />
                {l}
              </li>
            ))
          }
        </ul>
      </div>
      <div>
        <h3
          class="flex items-center gap-1.5 text-[11px] font-bold tracking-[0.18em] text-ink-400 uppercase"
        >
          <Icon name="ph:prohibit" class="h-3.5 w-3.5" aria-hidden="true" /> Hard pass
        </h3>
        <ul class="mt-2.5 space-y-2">
          {
            dislikes.map((d) => (
              <li class="flex items-start gap-2.5 text-sm text-ink-600 dark:text-ink-400">
                <span
                  class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-ink-400/60"
                  aria-hidden="true"
                />
                {d}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- If found (home only) -->
  <section
    class="mx-auto w-full max-w-2xl px-5 pt-12 pb-8 text-center md:pb-0"
    aria-label="Contact"
  >
    <p class="text-sm text-ink-600 dark:text-ink-400">
      {identity.name} is staffed by {contact.ownersLabel}. If found, please call
      her people:
    </p>
    <div class="mt-4 flex flex-wrap items-center justify-center gap-2.5">
      {
        contact.owners.map((o) => (
          <a
            href={`tel:${o.phone.replace(/\s/g, '')}`}
            class="inline-flex items-center gap-2 rounded-full border border-blush-300/70 bg-paper-50 px-5 py-2 text-sm font-bold text-blush-700 shadow-sm transition-all duration-200 hover:-translate-y-0.5 hover:shadow-md active:translate-y-0 dark:border-plum-700 dark:bg-plum-900 dark:text-blush-300"
          >
            <Icon name="ph:phone" class="h-4 w-4" aria-hidden="true" />
            {o.name} · {o.phone}
          </a>
        ))
      }
    </div>
  </section>

  <Footer />

  <ShareDialog />


  <script>
    // Hero slideshow: crossfade through her photos every few seconds.
    let slideTimer: ReturnType<typeof setInterval> | undefined;

    function setupSlideshow() {
      clearInterval(slideTimer);
      const slides = Array.from(
        document.querySelectorAll<HTMLElement>('[data-hero-slide]'),
      );
      if (slides.length < 2) return;
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      let current = 0;
      slideTimer = setInterval(() => {
        slides[current]?.classList.replace('opacity-100', 'opacity-0');
        current = (current + 1) % slides.length;
        slides[current]?.classList.replace('opacity-0', 'opacity-100');
      }, 4000);
    }

    setupSlideshow();
    document.addEventListener('astro:page-load', setupSlideshow);
  </script>
</Layout>
