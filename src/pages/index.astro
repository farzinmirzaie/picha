---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
import pichaPhoto from '../assets/picha.jpg';
import {
  identity,
  weight,
  microchip,
  personality,
  ageLabel,
} from '../data/picha';

const age = ageLabel();

const passport = [
  { label: 'Born', value: identity.bornLabel },
  { label: 'Age', value: age, dynamic: true },
  { label: 'Weight', value: weight.current },
  { label: 'Chip', value: microchip },
];
---

<Layout title="Picha 🐾" description={`Picha — ${identity.breed}. ${identity.tagline}`} current="home">
  <!-- Hero -->
  <header class="mx-auto w-full max-w-2xl px-5 pt-10 text-center sm:pt-14">
    <div class="hero-pop relative mx-auto w-52 sm:w-64">
      <!-- arch-shaped portrait -->
      <div
        class="wiggle-hover relative aspect-[4/5] overflow-hidden rounded-t-full rounded-b-[2.5rem] shadow-xl ring-4 ring-white dark:ring-plum-800"
      >
        <Image
          src={pichaPhoto}
          alt="Picha, an all-white cat with amber eyes and a pink collar, mid-meow"
          width={512}
          densities={[1, 2]}
          class="h-full w-full object-cover"
          style="object-position: 50% 30%"
          loading="eager"
        />
      </div>
      <span
        class="float-slow absolute -right-8 top-6 text-2xl opacity-60"
        aria-hidden="true">🐾</span
      >
      <span
        class="float-slow absolute -left-7 bottom-10 text-xl opacity-40 [animation-delay:1.2s]"
        aria-hidden="true">🐾</span
      >
    </div>

    <h1
      class="font-display mt-6 text-6xl font-semibold tracking-tight text-blush-600 sm:text-7xl dark:text-blush-300"
    >
      Picha
    </h1>
    <p class="font-display mt-2 text-lg italic text-ink-600 sm:text-xl dark:text-ink-400">
      {identity.tagline}
    </p>
    <p class="mt-2 text-sm font-bold text-amber-700 dark:text-amber-300">
      {identity.breed} · <span data-age>{age}</span>
    </p>
  </header>

  <!-- Passport ticket -->
  <section class="mx-auto w-full max-w-2xl px-5 pt-10" aria-label="Passport">
    <div
      class="ticket reveal rounded-2xl border-2 border-dashed border-blush-300 bg-paper-50 px-2 py-4 [--ticket-hole:var(--color-paper-100)] sm:px-6 dark:border-plum-700 dark:bg-plum-900 dark:[--ticket-hole:var(--color-plum-950)]"
    >
      <p
        class="mb-3 text-center text-[10px] font-bold tracking-[0.3em] text-blush-400 uppercase dark:text-blush-300/70"
      >
        · Pet Passport ·
      </p>
      <dl class="grid grid-cols-2 gap-x-2 gap-y-4 text-center sm:grid-cols-4">
        {
          passport.map((f) => (
            <div>
              <dt class="text-[10px] font-bold tracking-[0.18em] text-ink-400 uppercase">
                {f.label}
              </dt>
              <dd
                class="font-display mt-1 text-sm font-semibold text-ink-900 sm:text-base dark:text-paper-100"
                {...(f.dynamic ? { 'data-age': true } : {})}
              >
                {f.value}
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- Story -->
  <section class="mx-auto w-full max-w-2xl px-5 pt-12" aria-label="Her story">
    <p
      class="reveal font-display text-xl leading-relaxed font-medium text-ink-900 sm:text-2xl sm:leading-relaxed dark:text-paper-100"
    >
      {identity.story}
    </p>
    <p class="reveal mt-5 leading-relaxed text-ink-600 dark:text-ink-400">
      {identity.looks} Weighs {weight.current} (as of {weight.measuredOn}) — healthy
      adult target {weight.healthyTarget} {weight.note.toLowerCase()}
    </p>
  </section>

  <!-- Personality -->
  <section class="mx-auto w-full max-w-2xl px-5 pt-14" aria-label="Personality">
    <h2
      class="reveal text-[11px] font-bold tracking-[0.24em] text-blush-500 uppercase dark:text-blush-300"
    >
      What she's like
    </h2>
    <ul class="mt-2 divide-y divide-paper-300/70 dark:divide-plum-800">
      {
        personality.map((p, i) => (
          <li
            class="reveal flex items-start gap-4 py-5"
            style={`--reveal-delay: ${i * 80}ms`}
          >
            <span
              class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-blush-100 text-xl dark:bg-plum-800"
              aria-hidden="true"
            >
              {p.icon}
            </span>
            <div>
              <h3 class="font-display text-lg font-semibold">{p.title}</h3>
              <p class="mt-0.5 text-sm leading-relaxed text-ink-600 dark:text-ink-400">
                {p.detail}
              </p>
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  <Footer />
</Layout>
