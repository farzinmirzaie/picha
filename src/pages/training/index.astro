---
import { Icon } from 'astro-icon/components';
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Footer from '../../components/Footer.astro';
import TrainingRules from '../../components/TrainingRules.astro';
import SectionLabel from '../../components/ui/SectionLabel.astro';
import IconBadge from '../../components/ui/IconBadge.astro';
import { trainingCourses } from '../../data/training';
import { supabaseClient } from '../../data/supabase';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Status is derived from Supabase-merged data: graduated when every step is
// passed, in session once startedOn is set, otherwise on the syllabus. The
// client script re-fetches progress on load and regroups the cards, so the
// hub is live without a rebuild.
const status = (c: (typeof trainingCourses)[number]) =>
  c.stepsDone >= c.steps.length ? 'graduated' : c.startedOn ? 'active' : 'syllabus';

const groups = [
  { id: 'active', label: 'In session' },
  { id: 'syllabus', label: 'The syllabus' },
  { id: 'graduated', label: 'Graduated' },
].map((g) => ({ ...g, courses: trainingCourses.filter((c) => status(c) === g.id) }));

// Overall staff progress across every course (steps mastered / total).
const totalSteps = trainingCourses.reduce((n, c) => n + c.steps.length, 0);
const doneSteps = trainingCourses.reduce(
  (n, c) => n + Math.min(Math.max(c.stepsDone, 0), c.steps.length),
  0,
);
const pct = totalSteps ? Math.round((doneSteps / totalSteps) * 100) : 0;
const countOf = (id: string) => groups.find((g) => g.id === id)!.courses.length;
const summaryCaption = (a: number, g: number, s: number) =>
  [`${a} in session`, `${g} graduated`, `${s} on the syllabus`].join(' · ');
---

<Layout
  title="Training · Picha 🐾"
  description="The Royal Academy: Picha's training courses with step-by-step curricula and live progress."
  current="tools"
  appTitle="Academy"
>
  <PageHeader
    kicker="Tools · In service"
    title="The Royal Academy"
    blurb="Courses in advanced cat cooperation. Officially it is the staff being trained and certified; Her Fluffiness merely grades the coursework."
  />

  <!-- Overall staff progress -->
  <section class="mx-auto w-full max-w-2xl px-5 pt-5" aria-label="Overall progress">
    <div
      class="reveal rounded-3xl border border-blush-200/70 bg-paper-50 p-5 dark:border-plum-700 dark:bg-plum-900"
    >
      <div class="flex items-center justify-between gap-2">
        <SectionLabel tag="span">Staff progress</SectionLabel>
        <span class="text-[11px] font-bold text-ink-400" data-academy-count>
          {doneSteps}/{totalSteps} steps
        </span>
      </div>
      <div
        class="mt-3 h-2 overflow-hidden rounded-full bg-paper-200 dark:bg-plum-800"
        role="progressbar"
        aria-valuenow={pct}
        aria-valuemin="0"
        aria-valuemax="100"
        aria-label="Overall training progress"
      >
        <div
          class="h-full rounded-full bg-blush-500 transition-[width] duration-700 ease-out dark:bg-blush-400"
          style={`width: ${pct}%`}
          data-academy-bar
        >
        </div>
      </div>
      <p class="mt-2 text-[11px] leading-relaxed text-ink-400" data-academy-caption>
        {summaryCaption(countOf('active'), countOf('graduated'), countOf('syllabus'))}
      </p>
    </div>
  </section>

  <div
    data-academy
    data-supabase-url={supabaseClient?.url}
    data-supabase-key={supabaseClient?.key}
  >
    {
      groups.map((group) => (
        <section
          class:list={[
            'mx-auto w-full max-w-2xl px-5 pt-6',
            group.courses.length === 0 ? 'hidden' : '',
          ]}
          aria-label={group.label}
          data-group={group.id}
        >
          <SectionLabel class="reveal mb-2">{group.label}</SectionLabel>
          <div class="space-y-3" data-group-list={group.id}>
            {group.courses.map((c) => (
              <a
                href={`${base}/training/${c.slug}/`}
                data-astro-prefetch
                data-course-card={c.slug}
                data-total={c.steps.length}
                class="reveal group flex w-full items-center gap-4 rounded-3xl border border-blush-200/70 bg-paper-50 p-5 text-left shadow-sm transition-all duration-200 hover:-translate-y-0.5 hover:shadow-md active:translate-y-0 dark:border-plum-700 dark:bg-plum-900"
              >
                <IconBadge icon={c.icon} />
                <span class="min-w-0 flex-1">
                  <span class="flex flex-wrap items-center gap-x-2 gap-y-1">
                    <span class="font-display text-lg font-semibold">{c.title}</span>
                    <Icon
                      name="ph:medal"
                      data-course-medal
                      class:list={[
                        'h-4 w-4 text-amber-500',
                        status(c) === 'graduated' ? '' : 'hidden',
                      ]}
                      aria-label="Graduated"
                    />
                  </span>
                  <span class="mt-0.5 block text-sm leading-relaxed text-ink-600 dark:text-ink-400">
                    {c.tagline}
                  </span>
                  <span class="mt-1.5 flex flex-wrap items-center gap-2">
                    <span class="text-[11px] font-bold text-ink-400" data-course-steps>
                      {status(c) === 'syllabus'
                        ? `${c.steps.length} steps · not started`
                        : status(c) === 'graduated'
                          ? `all ${c.steps.length} steps passed`
                          : `step ${c.stepsDone + 1} of ${c.steps.length}`}
                    </span>
                    <span
                      class="inline-flex items-center gap-0.5 text-blush-400 dark:text-blush-300/70"
                      role="img"
                      aria-label={`Management resistance level ${c.resistance} of 3`}
                    >
                      {Array.from({ length: c.resistance }).map(() => (
                        <Icon name="ph:paw-print" class="h-3 w-3" aria-hidden="true" />
                      ))}
                    </span>
                  </span>
                </span>
                <Icon
                  name="ph:caret-right"
                  class="h-4 w-4 shrink-0 text-ink-400 transition-transform duration-200 group-hover:translate-x-1"
                  aria-hidden="true"
                />
              </a>
            ))}
          </div>
        </section>
      ))
    }
  </div>

  <TrainingRules padTop="pt-10">
    <p class="mt-2 px-1 text-[11px] leading-relaxed text-ink-400">
      Milestones are recorded on each course page by PIN-carrying staff and
      land straight in her cloud file.
    </p>
  </TrainingRules>

  <Footer />

  <script>
    // Live progress: re-fetch on load, update step counts and regroup cards
    // (in session / syllabus / graduated). Built HTML is the offline fallback.
    function setupAcademy() {
      const root = document.querySelector<HTMLElement>('[data-academy]');
      if (!root || root.dataset.bound) return;
      root.dataset.bound = '1';
      const url = root.dataset.supabaseUrl;
      const key = root.dataset.supabaseKey;
      if (!url || !key) return;

      (async () => {
        try {
          const { sbSelect } = await import('../../lib/sb');
          const rows = await sbSelect<
            Array<{ slug: string; steps_done: number; started_on: string | null }>
          >(url, key, 'picha_training?select=slug,steps_done,started_on');
          const bySlug = new Map(rows.map((r) => [r.slug, r]));

          const cards = Array.from(
            root.querySelectorAll<HTMLElement>('[data-course-card]'),
          );
          let totalSteps = 0;
          let doneSteps = 0;
          const counts = { active: 0, graduated: 0, syllabus: 0 };
          for (const card of cards) {
            const total = Number(card.dataset.total);
            const row = bySlug.get(card.dataset.courseCard!);
            const stepsDone = row ? Math.min(Math.max(row.steps_done, 0), total) : 0;
            const startedOn = row?.started_on ?? null;
            const group =
              stepsDone >= total ? 'graduated' : startedOn ? 'active' : 'syllabus';
            totalSteps += total;
            doneSteps += stepsDone;
            counts[group] += 1;

            const steps = card.querySelector<HTMLElement>('[data-course-steps]');
            if (steps)
              steps.textContent =
                group === 'graduated'
                  ? `all ${total} steps passed`
                  : group === 'active'
                    ? `step ${stepsDone + 1} of ${total}`
                    : `${total} steps · not started`;
            card
              .querySelector('[data-course-medal]')
              ?.classList.toggle('hidden', group !== 'graduated');

            const list = root.querySelector<HTMLElement>(`[data-group-list="${group}"]`);
            if (list && card.parentElement !== list) list.appendChild(card);
          }

          // show/hide groups by whether they hold cards now
          root.querySelectorAll<HTMLElement>('[data-group]').forEach((section) => {
            const list = section.querySelector('[data-group-list]');
            section.classList.toggle('hidden', !list || list.children.length === 0);
          });

          // overall staff-progress summary
          const pct = totalSteps ? Math.round((doneSteps / totalSteps) * 100) : 0;
          const set = (sel: string, text: string) => {
            const el = document.querySelector<HTMLElement>(sel);
            if (el) el.textContent = text;
          };
          set('[data-academy-count]', `${doneSteps}/${totalSteps} steps`);
          set(
            '[data-academy-caption]',
            `${counts.active} in session · ${counts.graduated} graduated · ${counts.syllabus} on the syllabus`,
          );
          const bar = document.querySelector<HTMLElement>('[data-academy-bar]');
          if (bar) {
            bar.style.width = `${pct}%`;
            bar.closest('[role="progressbar"]')?.setAttribute('aria-valuenow', String(pct));
          }
        } catch {
          /* offline: built grouping stands */
        }
      })();
    }

    setupAcademy();
    document.addEventListener('astro:page-load', setupAcademy);
  </script>
</Layout>
