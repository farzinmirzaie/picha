---
import { Icon } from 'astro-icon/components';
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Footer from '../../components/Footer.astro';
import { trainingCourses, trainingRules } from '../../data/picha';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Status is derived from data: graduated when every step is passed, in
// session once startedOn is set, otherwise it waits on the syllabus.
const status = (c: (typeof trainingCourses)[number]) =>
  c.stepsDone >= c.steps.length ? 'graduated' : c.startedOn ? 'active' : 'syllabus';

const groups = [
  { id: 'active', label: 'In session', courses: trainingCourses.filter((c) => status(c) === 'active') },
  { id: 'syllabus', label: 'The syllabus', courses: trainingCourses.filter((c) => status(c) === 'syllabus') },
  { id: 'graduated', label: 'Graduated', courses: trainingCourses.filter((c) => status(c) === 'graduated') },
].filter((g) => g.courses.length > 0);
---

<Layout title="Training · Picha 🐾" current="tools">
  <PageHeader
    kicker="Tools · In service"
    title="The Royal Academy"
    blurb="Courses in advanced cat cooperation. Officially it is the staff being trained and certified; Her Fluffiness merely grades the coursework."
  />

  {
    groups.map((group) => (
      <section class="mx-auto w-full max-w-2xl px-5 pt-6" aria-label={group.label}>
        <h2 class="reveal mb-2 text-[11px] font-bold tracking-[0.24em] text-blush-500 uppercase dark:text-blush-300">
          {group.label}
        </h2>
        <div class="space-y-3">
          {group.courses.map((c, i) => (
            <a
              href={`${base}/training/${c.slug}/`}
              class="reveal flex w-full items-center gap-4 rounded-3xl border border-blush-200/70 bg-paper-50 p-5 text-left shadow-sm transition-all duration-200 hover:-translate-y-0.5 hover:shadow-md active:translate-y-0 dark:border-plum-700 dark:bg-plum-900"
              style={`--reveal-delay: ${i * 60}ms`}
            >
              <span
                class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-blush-100 text-blush-600 dark:bg-plum-800 dark:text-blush-300"
                aria-hidden="true"
              >
                <Icon name={c.icon} class="h-5.5 w-5.5" />
              </span>
              <span class="min-w-0 flex-1">
                <span class="flex flex-wrap items-center gap-x-2 gap-y-1">
                  <span class="font-display text-lg font-semibold">{c.title}</span>
                  {status(c) === 'graduated' && (
                    <Icon
                      name="ph:medal"
                      class="h-4 w-4 text-amber-500"
                      aria-label="Graduated"
                    />
                  )}
                </span>
                <span class="mt-0.5 block text-sm leading-relaxed text-ink-600 dark:text-ink-400">
                  {c.tagline}
                </span>
                <span class="mt-1.5 flex flex-wrap items-center gap-2">
                  <span class="text-[11px] font-bold text-ink-400">
                    {status(c) === 'syllabus'
                      ? `${c.steps.length} steps · not started`
                      : status(c) === 'graduated'
                        ? `all ${c.steps.length} steps passed`
                        : `step ${c.stepsDone + 1} of ${c.steps.length}`}
                  </span>
                  <span
                    class="inline-flex items-center gap-0.5 text-blush-400 dark:text-blush-300/70"
                    role="img"
                    aria-label={`Management resistance level ${c.resistance} of 3`}
                  >
                    {Array.from({ length: c.resistance }).map(() => (
                      <Icon name="ph:paw-print" class="h-3 w-3" aria-hidden="true" />
                    ))}
                  </span>
                </span>
              </span>
              <Icon
                name="ph:caret-right"
                class="h-4 w-4 shrink-0 text-ink-400"
                aria-hidden="true"
              />
            </a>
          ))}
        </div>
      </section>
    ))
  }

  <!-- House rules for every session -->
  <section class="mx-auto w-full max-w-2xl px-5 pt-10 pb-8 md:pb-0" aria-label="Session rules">
    <h2
      class="reveal mb-2 text-[11px] font-bold tracking-[0.24em] text-blush-500 uppercase dark:text-blush-300"
    >
      Session rules
    </h2>
    <div
      class="reveal overflow-hidden rounded-3xl border border-blush-200/70 bg-paper-50 dark:border-plum-700 dark:bg-plum-900"
    >
      <ul class="divide-y divide-paper-200 dark:divide-plum-800">
        {
          trainingRules.map((r) => (
            <li class="flex items-start gap-3 px-5 py-3.5 text-sm text-ink-600 dark:text-ink-400">
              <Icon
                name="ph:seal-check"
                class="mt-0.5 h-4 w-4 shrink-0 text-blush-500 dark:text-blush-300"
                aria-hidden="true"
              />
              {r}
            </li>
          ))
        }
      </ul>
    </div>
    <p class="mt-2 px-1 text-[11px] leading-relaxed text-ink-400">
      Progress is recorded in her file when a step is truly passed; the
      registrar (the staff) updates it after each milestone.
    </p>
  </section>

  <Footer />
</Layout>
