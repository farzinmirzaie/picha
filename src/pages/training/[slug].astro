---
import { Icon } from 'astro-icon/components';
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Footer from '../../components/Footer.astro';
import TrainingRules from '../../components/TrainingRules.astro';
import SectionLabel from '../../components/ui/SectionLabel.astro';
import Button from '../../components/ui/Button.astro';
import { trainingCourses } from '../../data/training';
import { supabaseClient } from '../../data/supabase';
import { dateLabel } from '../../lib/dates';

export function getStaticPaths() {
  return trainingCourses.map((course) => ({
    params: { slug: course.slug },
    props: { course },
  }));
}

const { course } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Build-time state (Supabase-merged); the client script re-fetches on load
// and re-renders, so milestones recorded elsewhere show up without a rebuild.
const graduated = course.stepsDone >= course.steps.length;
const active = !graduated && Boolean(course.startedOn);
const statusLabel = graduated ? 'Graduated' : active ? 'In session' : 'On the syllabus';
const sinceLabel =
  active && course.startedOn ? `In session since ${dateLabel(course.startedOn)}` : '';
---

<Layout
  title={`${course.title} · Picha 🐾`}
  description={`${course.title} at the Royal Academy: ${course.tagline}`}
  current="tools"
  appTitle={course.title}
>
  <PageHeader kicker="The Royal Academy" title={course.title} blurb={course.tagline} />

  <section class="mx-auto w-full max-w-2xl px-5" aria-label="Course status">
    <a
      href={`${base}/training/`}
      class="reveal inline-flex items-center gap-1.5 text-xs font-bold text-blush-600 dark:text-blush-300"
    >
      <Icon name="ph:arrow-left" class="h-3.5 w-3.5" aria-hidden="true" />
      All courses
    </a>

    <div
      class="reveal mt-4 rounded-3xl border border-blush-200/70 bg-paper-50 p-6 dark:border-plum-700 dark:bg-plum-900"
      data-course
      data-slug={course.slug}
      data-total={course.steps.length}
      data-steps-done={course.stepsDone}
      data-started-on={course.startedOn ?? ''}
      data-supabase-url={supabaseClient?.url}
      data-supabase-key={supabaseClient?.key}
    >
      <div class="flex flex-wrap items-center gap-2">
        <span
          data-status-chip
          class:list={[
            'rounded-full px-2.5 py-0.5 text-[11px] font-bold',
            graduated
              ? 'bg-amber-300/40 text-amber-700 dark:bg-amber-700/30 dark:text-amber-300'
              : active
                ? 'bg-blush-600 text-white'
                : 'bg-paper-200 text-ink-600 dark:bg-plum-800 dark:text-ink-400',
          ]}
        >
          {statusLabel}
        </span>
        <span class="text-[11px] font-bold text-ink-400" data-step-count>
          {
            graduated
              ? `all ${course.steps.length} steps passed`
              : `step ${course.stepsDone + 1} of ${course.steps.length}`
          }
        </span>
        <span
          class="ml-auto inline-flex items-center gap-1 text-[11px] font-bold text-ink-400"
        >
          resistance
          <span
            class="inline-flex items-center gap-0.5 text-blush-400 dark:text-blush-300/70"
            role="img"
            aria-label={`Management resistance level ${course.resistance} of 3`}
          >
            {
              Array.from({ length: course.resistance }).map(() => (
                <Icon name="ph:paw-print" class="h-3 w-3" aria-hidden="true" />
              ))
            }
          </span>
        </span>
      </div>

      <!-- progress dots, one per step -->
      <div class="mt-4 flex gap-1.5" aria-hidden="true" data-dots>
        {
          course.steps.map((_, i) => (
            <span
              class:list={[
                'h-1.5 flex-1 rounded-full transition-colors duration-500',
                i < course.stepsDone
                  ? 'bg-blush-600 dark:bg-blush-400'
                  : 'bg-paper-200 dark:bg-plum-800',
              ]}
            />
          ))
        }
      </div>

      <p
        class:list={['mt-3 text-[11px] font-bold text-ink-400', sinceLabel ? '' : 'hidden']}
        data-since
      >
        {sinceLabel}
      </p>

      <!-- graduation celebration -->
      <div
        class:list={[
          'mt-4 items-center gap-2.5 rounded-2xl bg-amber-300/20 px-4 py-3 text-sm font-bold text-amber-700 dark:bg-amber-700/20 dark:text-amber-300',
          graduated ? 'flex' : 'hidden',
        ]}
        data-grad-banner
      >
        <Icon name="ph:medal" class="h-5 w-5 shrink-0" aria-hidden="true" />
        Graduated with honours. The staff are officially certified.
      </div>

      <p class="mt-4 text-sm leading-relaxed text-ink-600 dark:text-ink-400">
        {course.why}
      </p>

      <button
        type="button"
        data-practice-toggle={course.slug}
        aria-pressed="false"
        class:list={[
          'mt-5 items-center gap-2 rounded-full border border-blush-300/70 bg-paper-50 px-5 py-2 text-sm font-bold text-blush-700 shadow-sm transition-all duration-200 active:translate-y-0.5 dark:border-plum-700 dark:bg-plum-800 dark:text-blush-300',
          active || graduated ? 'inline-flex' : 'hidden',
        ]}
      >
        <Icon name="ph:seal-check" class="h-4.5 w-4.5" aria-hidden="true" />
        <span data-practice-label>Mark today's session done</span>
      </button>

      {
        supabaseClient && (
          <details
            class="group mt-5 border-t border-paper-200 pt-5 print:hidden dark:border-plum-800"
            data-registrar
            data-acc
            data-staff-only
            style="display:none"
          >
            <summary class="flex cursor-pointer list-none items-center gap-1.5 text-[10px] font-bold tracking-[0.14em] text-ink-400 uppercase [&::-webkit-details-marker]:hidden">
              <Icon
                name="ph:caret-right"
                class="h-3 w-3 transition-transform duration-200 group-open:rotate-90"
                aria-hidden="true"
              />
              Registrar controls
            </summary>
            <Button block data-train-action class="mt-2">
              {graduated ? 'Graduated' : active ? `Mark step ${course.stepsDone + 1} passed` : 'Begin the course'}
            </Button>
            <div class="mt-2 flex items-center justify-between gap-3">
              <p class="min-h-4 text-xs font-bold text-ink-400" data-train-status aria-live="polite" />
              <button
                type="button"
                data-train-undo
                class:list={[
                  'text-[11px] font-bold text-ink-400 underline decoration-dotted',
                  active || graduated ? '' : 'hidden',
                ]}
              >
                undo
              </button>
            </div>
            <p class="mt-2 text-[11px] leading-relaxed text-ink-400">
              Milestones are recorded to her cloud file. A step counts as passed
              when she stays relaxed through it on several separate days.
            </p>
          </details>
        )
      }
    </div>
  </section>

  <!-- The step ladder -->
  <section class="mx-auto w-full max-w-2xl px-5 pt-8" aria-label="Steps">
    <SectionLabel class="reveal mb-2">The curriculum</SectionLabel>
    <div
      class="reveal overflow-hidden rounded-3xl border border-blush-200/70 bg-paper-50 dark:border-plum-700 dark:bg-plum-900"
    >
      <ol class="divide-y divide-paper-200 dark:divide-plum-800">
        {
          course.steps.map((s, i) => {
            const done = i < course.stepsDone;
            const current = !graduated && i === course.stepsDone;
            return (
              <li
                data-step-row
                class:list={[
                  'flex items-start gap-3.5 px-5 py-4',
                  current ? 'bg-blush-100/50 dark:bg-plum-800/50' : '',
                  !done && !current ? 'opacity-60' : '',
                ]}
              >
                <span
                  data-step-circle
                  class:list={[
                    'flex h-8 w-8 shrink-0 items-center justify-center rounded-full text-xs font-bold transition-colors duration-300',
                    done
                      ? 'bg-blush-600 text-white'
                      : current
                        ? 'bg-blush-100 text-blush-700 ring-2 ring-blush-400 dark:bg-plum-800 dark:text-blush-300'
                        : 'bg-paper-200 text-ink-400 dark:bg-plum-800',
                  ]}
                  aria-hidden="true"
                >
                  <Icon
                    name="ph:check"
                    data-step-check
                    class:list={['h-4 w-4', done ? '' : 'hidden']}
                  />
                  <span data-step-num class:list={[done ? 'hidden' : '']}>{i + 1}</span>
                </span>
                <div class="min-w-0">
                  <div class="flex flex-wrap items-center gap-2">
                    <h3 class="font-display font-semibold">{s.title}</h3>
                    <span
                      data-step-next
                      class:list={[
                        'rounded-full bg-amber-300/40 px-2.5 py-0.5 text-[11px] font-bold text-amber-700 dark:bg-amber-700/30 dark:text-amber-300',
                        current ? '' : 'hidden',
                      ]}
                    >
                      up next
                    </span>
                  </div>
                  <p class="mt-0.5 text-sm leading-relaxed text-ink-600 dark:text-ink-400">
                    {s.detail}
                  </p>
                </div>
              </li>
            );
          })
        }
      </ol>
    </div>
  </section>

  <TrainingRules />

  <Footer />

  <script>
    // Course state is live: fetched from Supabase on load, written through the
    // PIN-checked log_training RPC, and re-rendered in place. The built HTML
    // is the offline fallback. "Practiced today" stays on-device.
    import { staffPin, forgetStaffPin, applyStaffVisibility } from '../../lib/staff';

    const PRACTICE_KEY = 'picha-training';

    type CourseState = { stepsDone: number; startedOn: string | null };

    function setupCourse() {
      const root = document.querySelector<HTMLElement>('[data-course]');
      if (!root || root.dataset.bound) return;
      root.dataset.bound = '1';

      const slug = root.dataset.slug!;
      const total = Number(root.dataset.total);
      const url = root.dataset.supabaseUrl;
      const key = root.dataset.supabaseKey;
      let state: CourseState = {
        stepsDone: Number(root.dataset.stepsDone),
        startedOn: root.dataset.startedOn || null,
      };

      const q = <T extends HTMLElement>(sel: string) => root.querySelector<T>(sel);
      const chipClasses = {
        base: 'rounded-full px-2.5 py-0.5 text-[11px] font-bold',
        graduated: 'bg-amber-300/40 text-amber-700 dark:bg-amber-700/30 dark:text-amber-300',
        active: 'bg-blush-600 text-white',
        syllabus: 'bg-paper-200 text-ink-600 dark:bg-plum-800 dark:text-ink-400',
      };
      const CIRCLE = {
        all: ['bg-blush-600', 'text-white', 'bg-blush-100', 'text-blush-700', 'ring-2', 'ring-blush-400', 'dark:bg-plum-800', 'dark:text-blush-300', 'bg-paper-200', 'text-ink-400'],
        done: ['bg-blush-600', 'text-white'],
        current: ['bg-blush-100', 'text-blush-700', 'ring-2', 'ring-blush-400', 'dark:bg-plum-800', 'dark:text-blush-300'],
        future: ['bg-paper-200', 'text-ink-400', 'dark:bg-plum-800'],
      };

      let wasGraduated = state.stepsDone >= total;

      const render = () => {
        const graduated = state.stepsDone >= total;
        const active = !graduated && Boolean(state.startedOn);

        const chip = q('[data-status-chip]');
        if (chip) {
          chip.className = `${chipClasses.base} ${
            graduated ? chipClasses.graduated : active ? chipClasses.active : chipClasses.syllabus
          }`;
          chip.textContent = graduated ? 'Graduated' : active ? 'In session' : 'On the syllabus';
        }
        const count = q('[data-step-count]');
        if (count)
          count.textContent = graduated
            ? `all ${total} steps passed`
            : `step ${state.stepsDone + 1} of ${total}`;

        // "in session since" line + graduation banner
        const since = q('[data-since]');
        if (since) {
          const show = active && state.startedOn;
          since.classList.toggle('hidden', !show);
          if (show) {
            const d = new Date(state.startedOn!).toLocaleDateString('en-GB', {
              day: 'numeric',
              month: 'long',
              year: 'numeric',
            });
            since.textContent = `In session since ${d}`;
          }
        }
        const banner = q('[data-grad-banner]');
        if (banner) {
          banner.classList.toggle('hidden', !graduated);
          banner.classList.toggle('flex', graduated);
          // celebrate only on the transition into graduation
          if (graduated && !wasGraduated) {
            banner.classList.remove('praise-pop');
            void banner.offsetWidth;
            banner.classList.add('praise-pop');
          }
        }
        wasGraduated = graduated;

        q('[data-dots]')
          ?.querySelectorAll('span')
          .forEach((dot, i) => {
            dot.classList.toggle('bg-blush-600', i < state.stepsDone);
            dot.classList.toggle('dark:bg-blush-400', i < state.stepsDone);
            dot.classList.toggle('bg-paper-200', i >= state.stepsDone);
            dot.classList.toggle('dark:bg-plum-800', i >= state.stepsDone);
          });

        // practice stays available once begun (active or graduated — mastered
        // skills still need maintenance); hidden only on the syllabus. Toggle
        // display exclusively: a persistent inline-flex would beat `hidden`.
        const showPractice = active || graduated;
        const practice = q('[data-practice-toggle]');
        practice?.classList.toggle('hidden', !showPractice);
        practice?.classList.toggle('inline-flex', showPractice);

        document.querySelectorAll<HTMLElement>('[data-step-row]').forEach((row, i) => {
          const done = i < state.stepsDone;
          const current = !graduated && i === state.stepsDone;
          row.classList.toggle('bg-blush-100/50', current);
          row.classList.toggle('dark:bg-plum-800/50', current);
          row.classList.toggle('opacity-60', !done && !current);
          const circle = row.querySelector<HTMLElement>('[data-step-circle]');
          if (circle) {
            circle.classList.remove(...CIRCLE.all);
            circle.classList.add(...(done ? CIRCLE.done : current ? CIRCLE.current : CIRCLE.future));
          }
          row.querySelector('[data-step-check]')?.classList.toggle('hidden', !done);
          row.querySelector('[data-step-num]')?.classList.toggle('hidden', done);
          row.querySelector('[data-step-next]')?.classList.toggle('hidden', !current);
        });

        const action = q<HTMLButtonElement>('[data-train-action]');
        if (action) {
          action.textContent = graduated
            ? 'Graduated'
            : active
              ? `Mark step ${state.stepsDone + 1} passed`
              : 'Begin the course';
          action.disabled = graduated;
        }
        q('[data-train-undo]')?.classList.toggle(
          'hidden',
          state.stepsDone === 0 && !state.startedOn,
        );
      };

      // show the registrar controls only on a signed-in staff device
      applyStaffVisibility(root);

      // ---- live refresh + writes (only when Supabase config is embedded) ----
      if (url && key) {
        const refresh = async () => {
          try {
            const { sbSelect } = await import('../../lib/sb');
            const [row] = await sbSelect<
              Array<{ steps_done: number; started_on: string | null }>
            >(url, key, `picha_training?select=steps_done,started_on&slug=eq.${slug}`);
            if (row) {
              state = {
                stepsDone: Math.min(Math.max(row.steps_done, 0), total),
                startedOn: row.started_on,
              };
              render();
            }
          } catch {
            /* offline: built state stands */
          }
        };

        // known staff device: keep the controls ready to use
        if (staffPin()) q('[data-registrar]')?.setAttribute('open', '');
        const status = q('[data-train-status]')!;
        const setStatus = (text: string, isError = false) => {
          status.textContent = text;
          status.classList.toggle('text-red-500', isError);
          status.classList.toggle('text-ink-400', !isError);
        };

        const write = async (next: CourseState) => {
          const pin = staffPin();
          if (!pin) {
            // no longer signed in: hide the controls, point to the Staff room
            applyStaffVisibility(root);
            return;
          }
          setStatus('Filing the paperwork…');
          try {
            const { sbRpc } = await import('../../lib/sb');
            await sbRpc(url, key, 'log_training', {
              p_slug: slug,
              p_steps_done: next.stepsDone,
              p_started_on: next.startedOn,
              p_pin: pin,
            });
            state = next;
            render();
            setStatus(
              next.stepsDone >= total
                ? 'Graduated. The academy is very proud.'
                : 'Recorded in her file.',
            );
          } catch (err) {
            if (String(err).includes('wrong pin')) {
              // the stored PIN is no longer valid: sign out and hide controls
              forgetStaffPin();
              applyStaffVisibility(root);
              setStatus('Sign-in expired. Re-enter the PIN in the Staff room.', true);
            } else {
              setStatus('Could not record it. Check the connection and try again.', true);
            }
          } finally {
            setTimeout(() => setStatus(''), 4000);
          }
        };

        q('[data-train-action]')?.addEventListener('click', () => {
          const graduated = state.stepsDone >= total;
          if (graduated) return;
          const today = new Date().toISOString().slice(0, 10);
          if (!state.startedOn) write({ stepsDone: 0, startedOn: today });
          else write({ stepsDone: state.stepsDone + 1, startedOn: state.startedOn });
        });
        q('[data-train-undo]')?.addEventListener('click', () => {
          if (state.stepsDone > 0)
            write({ stepsDone: state.stepsDone - 1, startedOn: state.startedOn });
          else if (state.startedOn) write({ stepsDone: 0, startedOn: null });
        });

        refresh();
      }

      // ---- "practiced today" tick (on-device, daily reset) ----
      const btn = q<HTMLButtonElement>('[data-practice-toggle]');
      if (btn) {
        const label = btn.querySelector<HTMLElement>('[data-practice-label]')!;
        const loadStore = (): { date: string; done: string[] } => {
          const today = new Date().toDateString();
          try {
            const raw = JSON.parse(localStorage.getItem(PRACTICE_KEY) ?? '');
            if (raw && raw.date === today && Array.isArray(raw.done)) return raw;
          } catch {
            /* fresh start */
          }
          return { date: today, done: [] };
        };
        const paint = (store: { done: string[] }) => {
          const done = store.done.includes(slug);
          btn.setAttribute('aria-pressed', String(done));
          btn.classList.toggle('bg-blush-600', done);
          btn.classList.toggle('text-white', done);
          btn.classList.toggle('dark:text-white', done);
          label.textContent = done ? 'Session logged for today' : "Mark today's session done";
        };
        btn.addEventListener('click', () => {
          const store = loadStore();
          store.done = store.done.includes(slug)
            ? store.done.filter((s) => s !== slug)
            : [...store.done, slug];
          localStorage.setItem(PRACTICE_KEY, JSON.stringify(store));
          paint(store);
        });
        paint(loadStore());
      }

      render();
    }

    setupCourse();
    document.addEventListener('astro:page-load', setupCourse);
  </script>
</Layout>
