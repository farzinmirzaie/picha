---
import { Icon } from 'astro-icon/components';
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import Footer from '../components/Footer.astro';
import { weightHistory, weightTarget, weight } from '../data/picha';

// Everything renders at build time from `weightHistory` (data/picha.ts):
// weigh-ins change only via a push, and every push rebuilds, so a static SVG
// chart keeps the zero-JS baseline. No entry UI yet; the staff edit the data.
const entries = [...weightHistory].sort((a, b) => a.date.localeCompare(b.date));
const kgs = entries.map((e) => e.kg);
const heaviest = entries.reduce((a, b) => (b.kg >= a.kg ? b : a));
const lightest = entries.reduce((a, b) => (b.kg <= a.kg ? b : a));
const average = kgs.reduce((sum, k) => sum + k, 0) / kgs.length;
const latest = entries[entries.length - 1];
const previous = entries.length > 1 ? entries[entries.length - 2] : undefined;
const deltaG = previous ? Math.round((latest.kg - previous.kg) * 1000) : 0;

const fmt = new Intl.DateTimeFormat('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
const fmtShort = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'short' });
const dateLabel = (iso: string) => fmt.format(new Date(iso));
const shortLabel = (iso: string) => fmtShort.format(new Date(iso));

// ---- chart geometry (viewBox units) ----
const W = 640;
const H = 320;
const PAD = { top: 26, right: 18, bottom: 40, left: 46 };
const innerW = W - PAD.left - PAD.right;
const innerH = H - PAD.top - PAD.bottom;

// y-domain follows the data but always peeks into the adult band, so the
// chart tells the growth story without squashing the actual line.
const yLo = Math.floor((Math.min(...kgs) - 0.15) * 2) / 2;
const yHi = Math.ceil(Math.max(Math.max(...kgs) + 0.15, weightTarget.min + 0.25) * 2) / 2;
const tickStep = yHi - yLo <= 1.5 ? 0.25 : 0.5;
const ticks: number[] = [];
for (let t = yLo; t <= yHi + 1e-9; t += tickStep) ticks.push(+t.toFixed(2));

const t0 = Date.parse(entries[0].date);
const t1 = Date.parse(entries[entries.length - 1].date);
const x = (iso: string) =>
  t1 === t0
    ? PAD.left + innerW / 2
    : PAD.left + ((Date.parse(iso) - t0) / (t1 - t0)) * innerW;
const y = (kg: number) => PAD.top + (1 - (kg - yLo) / (yHi - yLo)) * innerH;

const points = entries.map((e, idx) => ({ ...e, idx, px: x(e.date), py: y(e.kg) }));
const linePath = points
  .map((p, i) => `${i === 0 ? 'M' : 'L'}${p.px.toFixed(1)} ${p.py.toFixed(1)}`)
  .join(' ');
const areaPath =
  points.length > 1
    ? `${linePath} L${points[points.length - 1].px.toFixed(1)} ${H - PAD.bottom} L${points[0].px.toFixed(1)} ${H - PAD.bottom} Z`
    : '';

// The slice of the healthy adult band visible in the current domain.
const bandVisible = weightTarget.min < yHi;
const bandTopY = Math.max(y(Math.min(weightTarget.max, yHi)), PAD.top);
const bandBottomY = y(weightTarget.min);

// Direct labels stay selective: highest, lowest and the latest audit only.
const labelled = new Set([heaviest.date, lightest.date, latest.date]);
// Date labels under every point while the record is short; ends only once it grows.
const xLabelled = entries.length <= 8 ? points : [points[0], points[points.length - 1]];

const stats = [
  {
    icon: 'ph:scales',
    label: 'Current',
    value: weight.current,
    sub: `weighed ${shortLabel(latest.date)}`,
  },
  {
    icon: 'ph:trend-up',
    label: 'Heaviest',
    value: `${heaviest.kg} kg`,
    sub: `peak floof, ${shortLabel(heaviest.date)}`,
  },
  {
    icon: 'ph:feather',
    label: 'Lightest',
    value: `${lightest.kg} kg`,
    sub: `featherweight, ${shortLabel(lightest.date)}`,
  },
  {
    icon: 'ph:equals',
    label: 'Average',
    value: `${average.toFixed(2)} kg`,
    sub: `across ${entries.length} audit${entries.length === 1 ? '' : 's'}`,
  },
  {
    icon: 'ph:calendar-check',
    label: 'Next audit',
    value: shortLabel(
      new Date(Date.parse(latest.date) + weight.auditEveryDays * 86_400_000)
        .toISOString()
        .slice(0, 10),
    ),
    sub: weight.auditEveryLabel,
  },
];

const ledger = [...points].reverse();
---

<Layout title="Weight · Picha 🐾" current="tools">
  <PageHeader
    kicker="Tools · In service"
    title="The royal waistline"
    blurb={`Every audit on the books, charted. Measured meals keep the trend honest; this page keeps the staff honest. ${weight.note}`}
  />

  <!-- Stat strip: same snap-scroll tiles as the Health vitals -->
  <section aria-label="Weight stats" class="mx-auto w-full max-w-2xl pt-5">
    <div
      class="no-scrollbar flex snap-x snap-mandatory gap-3 overflow-x-auto scroll-px-5 px-5 pb-1"
    >
      {
        stats.map((s, i) => (
          <div
            class="reveal min-w-[8.5rem] shrink-0 snap-start rounded-2xl border border-blush-200/70 bg-paper-50 p-4 dark:border-plum-700 dark:bg-plum-900"
            style={`--reveal-delay: ${i * 60}ms`}
          >
            <div class="flex items-center gap-1.5 text-blush-500 dark:text-blush-300">
              <Icon name={s.icon} class="h-4 w-4" aria-hidden="true" />
              <span class="text-[10px] font-bold tracking-[0.14em] uppercase">
                {s.label}
              </span>
            </div>
            <p class="font-display mt-1.5 text-xl font-semibold">{s.value}</p>
            <p class="mt-0.5 text-[11px] leading-tight text-ink-400">{s.sub}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- The chart -->
  <section class="mx-auto w-full max-w-2xl px-5 pt-8" aria-label="Weight over time">
    <div
      class="reveal rounded-3xl border border-blush-200/70 bg-paper-50 p-5 sm:p-6 dark:border-plum-700 dark:bg-plum-900"
    >
      <div class="flex flex-wrap items-center justify-between gap-2">
        <h2 class="font-display text-lg font-semibold">The trend</h2>
        {
          previous && (
            <span class="inline-flex items-center gap-1 rounded-full bg-paper-200 px-2.5 py-0.5 text-[11px] font-bold text-ink-600 dark:bg-plum-800 dark:text-ink-400">
              <Icon
                name={deltaG >= 0 ? 'ph:trend-up' : 'ph:trend-down'}
                class="h-3.5 w-3.5"
                aria-hidden="true"
              />
              {Math.abs(deltaG)} g {deltaG >= 0 ? 'up' : 'down'} since the last audit
            </span>
          )
        }
      </div>

      <svg
        viewBox={`0 0 ${W} ${H}`}
        class="mt-3 h-auto w-full"
        role="img"
        aria-label={`Line chart of Picha's weight: ${entries.length} weigh-ins from ${dateLabel(entries[0].date)} to ${dateLabel(latest.date)}, currently ${weight.current}. Full figures are in the ledger below.`}
      >
        <!-- healthy adult band (the part visible in this domain) -->
        {
          bandVisible && (
            <>
              <rect
                x={PAD.left}
                y={bandTopY}
                width={innerW}
                height={bandBottomY - bandTopY}
                class="fill-amber-300/15 dark:fill-amber-700/15"
              />
              <line
                x1={PAD.left}
                x2={PAD.left + innerW}
                y1={bandBottomY}
                y2={bandBottomY}
                stroke-dasharray="5 5"
                stroke-width="1.5"
                class="stroke-amber-500/70"
              />
              <text
                x={PAD.left + innerW - 6}
                y={bandBottomY - 7}
                text-anchor="end"
                class="fill-amber-700 text-[10px] font-bold tracking-[0.08em] uppercase dark:fill-amber-300"
              >
                healthy adult range
              </text>
            </>
          )
        }

        <!-- gridlines + y ticks -->
        {
          ticks.map((t) => (
            <>
              <line
                x1={PAD.left}
                x2={PAD.left + innerW}
                y1={y(t)}
                y2={y(t)}
                stroke-width="1"
                class="stroke-paper-300/80 dark:stroke-plum-700/80"
              />
              <text
                x={PAD.left - 8}
                y={y(t) + 3.5}
                text-anchor="end"
                class="fill-ink-400 text-[10px] font-bold"
              >
                {String(t)}
              </text>
            </>
          ))
        }
        <text
          x={PAD.left - 8}
          y={PAD.top - 10}
          text-anchor="end"
          class="fill-ink-400 text-[10px] font-bold"
        >
          kg
        </text>

        <!-- the waistline itself -->
        {areaPath && <path d={areaPath} class="fill-blush-600/10 dark:fill-blush-500/15" />}
        <path
          d={linePath}
          fill="none"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="stroke-blush-600 dark:stroke-blush-500"
        />
        {
          points.map((p) => (
            <>
              <circle
                cx={p.px}
                cy={p.py}
                r="5"
                stroke-width="2.5"
                class="fill-blush-600 stroke-paper-50 dark:fill-blush-500 dark:stroke-plum-900"
              />
              {labelled.has(p.date) && (
                <text
                  x={p.px}
                  y={p.py - 12}
                  text-anchor="middle"
                  class="fill-ink-900 text-[11px] font-bold dark:fill-paper-100"
                >
                  {p.kg}
                </text>
              )}
            </>
          ))
        }

        <!-- x axis -->
        <line
          x1={PAD.left}
          x2={PAD.left + innerW}
          y1={H - PAD.bottom}
          y2={H - PAD.bottom}
          stroke-width="1"
          class="stroke-paper-300 dark:stroke-plum-700"
        />
        {
          xLabelled.map((p) => (
            <text
              x={p.px}
              y={H - PAD.bottom + 18}
              text-anchor="middle"
              class="fill-ink-400 text-[10px] font-bold"
            >
              {shortLabel(p.date)}
            </text>
          ))
        }
      </svg>

      <p class="mt-3 text-[11px] leading-relaxed text-ink-400">
        The amber band is the healthy adult range ({weight.healthyTarget}).
        {weight.note} Sitting under it, for now, is entirely by design.
      </p>
    </div>
  </section>

  <!-- The ledger: every audit, newest first (doubles as the accessible table) -->
  <section class="mx-auto w-full max-w-2xl px-5 pt-10" aria-label="Weigh-in ledger">
    <h2
      class="reveal mb-2 text-[11px] font-bold tracking-[0.24em] text-blush-500 uppercase dark:text-blush-300"
    >
      The ledger
    </h2>
    <div
      class="reveal overflow-hidden rounded-3xl border border-blush-200/70 bg-paper-50 dark:border-plum-700 dark:bg-plum-900"
    >
      <ul class="divide-y divide-paper-200 dark:divide-plum-800">
        {
          ledger.map((p, i) => {
            const prev = p.idx > 0 ? entries[p.idx - 1] : undefined;
            const rowDelta = prev ? Math.round((p.kg - prev.kg) * 1000) : undefined;
            return (
              <li class="flex items-center gap-3.5 px-5 py-4">
                <span
                  class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-blush-100 text-blush-600 dark:bg-plum-800 dark:text-blush-300"
                  aria-hidden="true"
                >
                  <Icon name="ph:scales" class="h-5 w-5" />
                </span>
                <div class="min-w-0 flex-1">
                  <p class="font-display font-semibold">{dateLabel(p.date)}</p>
                  <p class="text-xs text-ink-400">
                    audit no. {String(p.idx + 1).padStart(2, '0')}
                    {i === 0 && ' · latest'}
                  </p>
                </div>
                <div class="text-right">
                  <p class="font-display text-lg font-semibold">{p.kg} kg</p>
                  <p class="flex items-center justify-end gap-1 text-[11px] font-bold text-ink-400">
                    {rowDelta === undefined ? (
                      'opening entry'
                    ) : (
                      <>
                        <Icon
                          name={rowDelta >= 0 ? 'ph:trend-up' : 'ph:trend-down'}
                          class="h-3 w-3"
                          aria-hidden="true"
                        />
                        {Math.abs(rowDelta)} g
                      </>
                    )}
                  </p>
                </div>
              </li>
            );
          })
        }
      </ul>
    </div>
    <p class="mt-2 px-1 text-[11px] text-ink-400">
      New audits are added to the record after each monthly weigh-in. A proper
      entry form is pending management approval; the paperwork is under her bed.
    </p>
  </section>

  <Footer />
</Layout>
