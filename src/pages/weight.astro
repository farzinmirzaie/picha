---
import { Icon } from 'astro-icon/components';
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import Footer from '../components/Footer.astro';
import WeighInForm from '../components/WeighInForm.astro';
import IconButton from '../components/ui/IconButton.astro';
import SheetHeader from '../components/ui/SheetHeader.astro';
import StatStrip from '../components/ui/StatStrip.astro';
import StatTile from '../components/ui/StatTile.astro';
import SectionLabel from '../components/ui/SectionLabel.astro';
import IconBadge from '../components/ui/IconBadge.astro';
import { weightTarget, weight } from '../data/picha';
import { weightHistory, currentWeight } from '../data/weights';
import { supabaseClient } from '../data/supabase';
import {
  CHART,
  chartSvg,
  chartAriaLabel,
  weightStats,
  deltaLabel,
  rowDeltaLabel,
} from '../lib/weight-viz';
import { dateLabel, shortLabel } from '../lib/dates';
import { getWeightCopy } from '../i18n/content';

const locale = Astro.currentLocale ?? 'en';
const c = getWeightCopy(locale);

// Build-time render from the Supabase ledger (seed fallback) via the shared
// weight-viz module; the client script re-fetches on load and re-renders with
// the SAME module, so the page is live without a rebuild. New entries go
// through the PIN-checked log_weight RPC (see supabase/schema.sql).
const { entries, heaviest, lightest, average, latest, previous, deltaG } =
  weightStats(weightHistory);
const auditWord = (n: number) => (n === 1 ? c.auditWord : c.auditWordPlural);

const stats = [
  {
    id: 'current',
    icon: 'ph:scales',
    label: c.statCurrent,
    value: currentWeight.label,
    sub: `${c.weighedPre} ${shortLabel(latest.date, locale)}`,
  },
  {
    id: 'heaviest',
    icon: 'ph:trend-up',
    label: c.statHeaviest,
    value: `${heaviest.kg} kg`,
    sub: `${c.peakFloofPre} ${shortLabel(heaviest.date, locale)}`,
  },
  {
    id: 'lightest',
    icon: 'ph:feather',
    label: c.statLightest,
    value: `${lightest.kg} kg`,
    sub: `${c.featherweightPre} ${shortLabel(lightest.date, locale)}`,
  },
  {
    id: 'average',
    icon: 'ph:equals',
    label: c.statAverage,
    value: `${average.toFixed(2)} kg`,
    sub: `${c.acrossPre} ${entries.length} ${auditWord(entries.length)}`,
  },
];

const ledger = [...entries].reverse();

// The band footnote follows where she actually is relative to the range.
const bandNote =
  latest.kg < weightTarget.min
    ? c.bandNote.under
    : latest.kg <= weightTarget.max
      ? c.bandNote.in
      : c.bandNote.over;
---

<Layout
  title={c.metaTitle}
  description={c.metaDescription}
  current="tools"
  appTitle={c.appTitle}
>
  {
    supabaseClient && (
      <IconButton
        slot="app-action"
        icon="ph:plus-circle"
        label={c.logWeighIn}
        data-weigh-open
        data-staff-only
        style="display:none"
      />
    )
  }
  <PageHeader kicker={c.kicker} title={c.title} blurb={`${c.blurb} ${c.note}`} />

  <!-- Stat strip: same snap-scroll tiles as the Health vitals -->
  <StatStrip label="Weight stats" class="pt-5">
    {
      stats.map((s) => (
        <StatTile
          icon={s.icon}
          label={s.label}
          value={s.value}
          valueAttrs={{ 'data-stat': s.id }}
          sub={s.sub}
          subAttrs={{ 'data-stat-sub': s.id }}
        />
      ))
    }
  </StatStrip>

  <!-- The chart -->
  <section class="mx-auto w-full max-w-2xl px-5 pt-8" aria-label="Weight over time">
    <div
      class="reveal rounded-3xl border border-blush-200/70 bg-paper-50 p-5 sm:p-6 dark:border-plum-700 dark:bg-plum-900"
    >
      <div class="flex flex-wrap items-center justify-between gap-2">
        <h2 class="font-display text-lg font-semibold">{c.trend}</h2>
        <span
          class:list={[
            'items-center gap-1 rounded-full bg-paper-200 px-2.5 py-0.5 text-[11px] font-bold text-ink-600 dark:bg-plum-800 dark:text-ink-400',
            previous ? 'inline-flex' : 'hidden',
          ]}
          data-delta-chip
        >
          <Icon
            name="ph:trend-up"
            class:list={['h-3.5 w-3.5', deltaG > 0 ? '' : 'hidden']}
            data-delta-up
            aria-hidden="true"
          />
          <Icon
            name="ph:trend-down"
            class:list={['h-3.5 w-3.5', deltaG < 0 ? '' : 'hidden']}
            data-delta-down
            aria-hidden="true"
          />
          <span data-delta-text>{deltaLabel(deltaG, locale)}</span>
        </span>
      </div>

      <svg
        viewBox={`0 0 ${CHART.W} ${CHART.H}`}
        class="mt-3 h-auto w-full"
        role="img"
        aria-label={chartAriaLabel(entries, locale)}
        data-weight-chart
        set:html={chartSvg(entries, weightTarget, locale)}
      />

      <p class="mt-3 text-[11px] leading-relaxed text-ink-400">
        {c.bandFootnotePre}{weight.healthyTarget}{c.bandFootnotePost}
        {c.note} {bandNote}
      </p>
    </div>
  </section>

  <!-- The ledger: every audit, newest first (doubles as the accessible table) -->
  <section
    class="mx-auto w-full max-w-2xl px-5 pt-10 pb-8 md:pb-0"
    aria-label="Weigh-in ledger"
  >
    <SectionLabel class="reveal mb-2">{c.ledgerLabel}</SectionLabel>
    <div
      class="reveal overflow-hidden rounded-3xl border border-blush-200/70 bg-paper-50 dark:border-plum-700 dark:bg-plum-900"
    >
      <ul class="divide-y divide-paper-200 dark:divide-plum-800" data-ledger>
        {
          ledger.map((p, i) => {
            const idx = entries.length - 1 - i;
            const prev = idx > 0 ? entries[idx - 1] : undefined;
            const rowDelta = prev ? Math.round((p.kg - prev.kg) * 1000) : undefined;
            return (
              <li class="flex items-center gap-3.5 px-5 py-4">
                <IconBadge icon="ph:scales" size="sm" />
                <div class="min-w-0 flex-1">
                  <p class="font-display font-semibold" data-row-date>
                    {dateLabel(p.date, locale)}
                  </p>
                  <p class="text-xs text-ink-400" data-row-sub>
                    {c.auditNoPre} {String(idx + 1).padStart(2, '0')}
                    {i === 0 && ` · ${c.latest}`}
                  </p>
                </div>
                <div class="text-right">
                  <p class="font-display text-lg font-semibold" data-row-kg>
                    {p.kg} kg
                  </p>
                  <p class="flex items-center justify-end gap-1 text-[11px] font-bold text-ink-400">
                    <Icon
                      name="ph:trend-up"
                      class:list={[
                        'h-3 w-3',
                        rowDelta !== undefined && rowDelta > 0 ? '' : 'hidden',
                      ]}
                      data-row-up
                      aria-hidden="true"
                    />
                    <Icon
                      name="ph:trend-down"
                      class:list={[
                        'h-3 w-3',
                        rowDelta !== undefined && rowDelta < 0 ? '' : 'hidden',
                      ]}
                      data-row-down
                      aria-hidden="true"
                    />
                    <span data-row-delta>{rowDeltaLabel(rowDelta, locale)}</span>
                  </p>
                </div>
              </li>
            );
          })
        }
      </ul>
    </div>
  </section>

  {
    supabaseClient && (
      <>
        {/* desktop: accordion after the ledger (staff-only) */}
        <section
          class="mx-auto hidden w-full max-w-2xl px-5 pt-10 md:block print:hidden"
          aria-label="Log a weigh-in"
          data-staff-only
          style="display:none"
        >
          <SectionLabel class="mb-2">
            {c.logWeighIn} <span class="font-bold tracking-normal normal-case text-ink-400">· {c.staffOnly}</span>
          </SectionLabel>
          <WeighInForm />
        </section>

        {/* mobile: dialog, opened from the app-bar action */}
        <dialog id="weigh" class="sheet md:hidden" aria-labelledby="weigh-title">
          <div class="rounded-2xl bg-paper-50 shadow-2xl max-md:rounded-b-none max-md:pb-[env(safe-area-inset-bottom)] dark:bg-plum-900">
            <SheetHeader title={c.logWeighIn} titleId="weigh-title" />
            <div class="p-4">
              <WeighInForm flush />
            </div>
          </div>
        </dialog>
      </>
    )
  }

  <Footer />

  <script>
    import { weightTarget, type WeightEntry } from '../data/picha';
    import {
      chartSvg,
      chartAriaLabel,
      weightStats,
      deltaLabel,
      rowDeltaLabel,
    } from '../lib/weight-viz';
    import { dateLabel, shortLabel } from '../lib/dates';
    import { sbSelect, sbRpc } from '../lib/sb';
    import { staffPin, forgetStaffPin, applyStaffVisibility } from '../lib/staff';
    import { getWeightCopy } from '../i18n/content';

    const wLocale = () => document.documentElement.lang || 'en';

    // Set by setupWeightLive to the latest live re-fetch, so the foreground
    // listeners below can call it without threading closures around.
    let liveRefresh: (() => void) | null = null;

    function render(entries: WeightEntry[]) {
      if (!entries.length) return;
      const { heaviest, lightest, average, latest, previous, deltaG } =
        weightStats(entries);
      const locale = wLocale();
      const c = getWeightCopy(locale);
      const auditWord = entries.length === 1 ? c.auditWord : c.auditWordPlural;

      // chart
      const svg = document.querySelector<SVGElement>('[data-weight-chart]');
      if (svg) {
        svg.innerHTML = chartSvg(entries, weightTarget, locale);
        svg.setAttribute('aria-label', chartAriaLabel(entries, locale));
      }

      // stat tiles
      const set = (sel: string, text: string) => {
        const el = document.querySelector<HTMLElement>(sel);
        if (el) el.textContent = text;
      };
      set('[data-stat=current]', `${latest.kg} kg`);
      set('[data-stat-sub=current]', `${c.weighedPre} ${shortLabel(latest.date, locale)}`);
      set('[data-stat=heaviest]', `${heaviest.kg} kg`);
      set('[data-stat-sub=heaviest]', `${c.peakFloofPre} ${shortLabel(heaviest.date, locale)}`);
      set('[data-stat=lightest]', `${lightest.kg} kg`);
      set('[data-stat-sub=lightest]', `${c.featherweightPre} ${shortLabel(lightest.date, locale)}`);
      set('[data-stat=average]', `${average.toFixed(2)} kg`);
      set('[data-stat-sub=average]', `${c.acrossPre} ${entries.length} ${auditWord}`);

      // delta chip
      const chip = document.querySelector<HTMLElement>('[data-delta-chip]');
      if (chip) {
        chip.classList.toggle('hidden', !previous);
        chip.classList.toggle('inline-flex', Boolean(previous));
        chip.querySelector('[data-delta-up]')?.classList.toggle('hidden', deltaG <= 0);
        chip.querySelector('[data-delta-down]')?.classList.toggle('hidden', deltaG >= 0);
        const text = chip.querySelector('[data-delta-text]');
        if (text) text.textContent = deltaLabel(deltaG, locale);
      }

      // ledger: clone the first row as a template, then rebuild
      const list = document.querySelector<HTMLElement>('[data-ledger]');
      const proto = list?.querySelector('li');
      if (!list || !proto) return;
      const rows = [...entries].reverse().map((p, i) => {
        const idx = entries.length - 1 - i;
        const prev = idx > 0 ? entries[idx - 1] : undefined;
        const rowDelta = prev ? Math.round((p.kg - prev.kg) * 1000) : undefined;
        const li = proto.cloneNode(true) as HTMLElement;
        const q = (sel: string) => li.querySelector<HTMLElement>(sel);
        q('[data-row-date]')!.textContent = dateLabel(p.date, locale);
        q('[data-row-sub]')!.textContent =
          `${c.auditNoPre} ${String(idx + 1).padStart(2, '0')}${i === 0 ? ` · ${c.latest}` : ''}`;
        q('[data-row-kg]')!.textContent = `${p.kg} kg`;
        q('[data-row-up]')?.classList.toggle(
          'hidden',
          rowDelta === undefined || rowDelta <= 0,
        );
        q('[data-row-down]')?.classList.toggle(
          'hidden',
          rowDelta === undefined || rowDelta >= 0,
        );
        q('[data-row-delta]')!.textContent = rowDeltaLabel(rowDelta, locale);
        return li;
      });
      list.replaceChildren(...rows);
    }

    function bindForm(form: HTMLFormElement, refresh: () => Promise<void>) {
      const url = form.dataset.supabaseUrl!;
      const key = form.dataset.supabaseKey!;

      const dateInput = form.elements.namedItem('date') as HTMLInputElement;
      dateInput.value = new Date().toISOString().slice(0, 10);
      dateInput.max = dateInput.value; // audits are recorded, not scheduled

      const status = form.querySelector<HTMLElement>('[data-form-status]')!;
      const setStatus = (text: string, isError = false) => {
        status.textContent = text;
        status.classList.toggle('text-red-500', isError);
        status.classList.toggle('text-ink-400', !isError);
      };
      const fc = () => getWeightCopy(wLocale()).form;
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const kgInput = form.elements.namedItem('kg') as HTMLInputElement;
        const button = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
        button.disabled = true;
        setStatus(fc().filing);
        try {
          await sbRpc(url, key, 'log_weight', {
            p_date: dateInput.value,
            p_kg: Number(kgInput.value),
            p_pin: staffPin() ?? '',
          });
          kgInput.value = '';
          setStatus(fc().recorded);
          await refresh();
          // when logged from the mobile dialog, show the result behind it
          const dialog = form.closest('dialog');
          if (dialog?.open) {
            const { animatedClose } = await import('../lib/dialog');
            setTimeout(() => animatedClose(dialog), 900);
          }
        } catch (err) {
          if (String(err).includes('wrong pin')) {
            // the stored PIN is no longer valid: sign out and hide the form
            forgetStaffPin();
            applyStaffVisibility();
            setStatus(fc().signExpired, true);
          } else {
            setStatus(fc().couldNotRecord, true);
          }
        } finally {
          button.disabled = false;
          setTimeout(() => setStatus(''), 4000);
        }
      });
    }

    async function setupWeightLive() {
      // show the weigh-in affordances only on a signed-in staff device
      applyStaffVisibility();
      const forms = Array.from(
        document.querySelectorAll<HTMLFormElement>('[data-weight-form]:not([data-bound])'),
      );
      if (!forms.length) return;
      const { supabaseUrl: url, supabaseKey: key } = forms[0].dataset as {
        supabaseUrl: string;
        supabaseKey: string;
      };

      const refresh = async () => {
        try {
          const rows = await sbSelect<Array<{ date: string; kg: number | string }>>(
            url,
            key,
            'picha_weights?select=date,kg&order=date.asc',
          );
          if (Array.isArray(rows) && rows.length) {
            render(rows.map((r) => ({ date: r.date, kg: Number(r.kg) })));
          }
        } catch {
          /* offline or blocked: the built-in data stands */
        }
      };
      liveRefresh = refresh;

      forms.forEach((form) => {
        form.dataset.bound = '1';
        bindForm(form, refresh);
      });

      // the mobile dialog + its app-bar opener
      const dialog = document.getElementById('weigh') as HTMLDialogElement | null;
      if (dialog) {
        const { bindDialog } = await import('../lib/dialog');
        bindDialog(dialog);
        document.querySelectorAll<HTMLElement>('[data-weigh-open]').forEach((btn) => {
          if (btn.dataset.bound) return;
          btn.dataset.bound = '1';
          btn.addEventListener('click', () => dialog.showModal());
        });
      }

      refresh();
    }

    setupWeightLive();
    document.addEventListener('astro:page-load', setupWeightLive);

    // Re-pull the ledger when the tab/app returns to the foreground (resumed
    // from background, refocused, or restored from the back-forward cache), so
    // a weigh-in logged elsewhere shows up without a manual reload.
    const revalidate = () => {
      if (document.querySelector('[data-weight-chart]')) liveRefresh?.();
    };
    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'visible') revalidate();
    });
    window.addEventListener('pageshow', (e) => {
      if ((e as PageTransitionEvent).persisted) revalidate();
    });
  </script>
</Layout>
