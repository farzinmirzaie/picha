---
import { Icon } from 'astro-icon/components';
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import Footer from '../components/Footer.astro';
import { weightTarget, weight } from '../data/picha';
import { weightHistory, currentWeight } from '../data/weights';
import { supabaseClient } from '../data/supabase';
import { CHART, chartSvg, chartAriaLabel, weightStats } from '../lib/weight-viz';
import { dateLabel, shortLabel } from '../lib/dates';

// Build-time render from the Supabase ledger (seed fallback) via the shared
// weight-viz module; the client script re-fetches on load and re-renders with
// the SAME module, so the page is live without a rebuild. New entries go
// through the PIN-checked log_weight RPC (see supabase/schema.sql).
const { entries, heaviest, lightest, average, latest, previous, deltaG } =
  weightStats(weightHistory);

const stats = [
  {
    id: 'current',
    icon: 'ph:scales',
    label: 'Current',
    value: currentWeight.label,
    sub: `weighed ${shortLabel(latest.date)}`,
  },
  {
    id: 'heaviest',
    icon: 'ph:trend-up',
    label: 'Heaviest',
    value: `${heaviest.kg} kg`,
    sub: `peak floof, ${shortLabel(heaviest.date)}`,
  },
  {
    id: 'lightest',
    icon: 'ph:feather',
    label: 'Lightest',
    value: `${lightest.kg} kg`,
    sub: `featherweight, ${shortLabel(lightest.date)}`,
  },
  {
    id: 'average',
    icon: 'ph:equals',
    label: 'Average',
    value: `${average.toFixed(2)} kg`,
    sub: `across ${entries.length} audit${entries.length === 1 ? '' : 's'}`,
  },
];

const ledger = [...entries].reverse();

// The band footnote follows where she actually is relative to the range.
const bandNote =
  latest.kg < weightTarget.min
    ? 'Sitting under it, for now, is entirely by design.'
    : latest.kg <= weightTarget.max
      ? 'She has arrived. The waistline committee is satisfied.'
      : 'She is above it; the portion policy is under formal review.';
---

<Layout
  title="Weight · Picha 🐾"
  description="Picha's weight tracker: every weigh-in charted, with stats and the full ledger."
  current="tools"
  appTitle="Weight"
>
  <PageHeader
    kicker="Tools · In service"
    title="The royal waistline"
    blurb={`Every audit on the books, charted. Measured meals keep the trend honest; this page keeps the staff honest. ${weight.note}`}
  />

  <!-- Stat strip: same snap-scroll tiles as the Health vitals -->
  <section aria-label="Weight stats" class="mx-auto w-full max-w-2xl pt-5">
    <div
      class="no-scrollbar flex snap-x snap-mandatory gap-3 overflow-x-auto scroll-px-5 px-5 pb-1"
    >
      {
        stats.map((s, i) => (
          <div
            class="reveal min-w-[8.5rem] shrink-0 snap-start rounded-2xl border border-blush-200/70 bg-paper-50 p-4 dark:border-plum-700 dark:bg-plum-900"
            style={`--reveal-delay: ${i * 60}ms`}
          >
            <div class="flex items-center gap-1.5 text-blush-500 dark:text-blush-300">
              <Icon name={s.icon} class="h-4 w-4" aria-hidden="true" />
              <span class="text-[10px] font-bold tracking-[0.14em] uppercase">
                {s.label}
              </span>
            </div>
            <p class="font-display mt-1.5 text-xl font-semibold" data-stat={s.id}>
              {s.value}
            </p>
            <p class="mt-0.5 text-[11px] leading-tight text-ink-400" data-stat-sub={s.id}>
              {s.sub}
            </p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- The chart -->
  <section class="mx-auto w-full max-w-2xl px-5 pt-8" aria-label="Weight over time">
    <div
      class="reveal rounded-3xl border border-blush-200/70 bg-paper-50 p-5 sm:p-6 dark:border-plum-700 dark:bg-plum-900"
    >
      <div class="flex flex-wrap items-center justify-between gap-2">
        <h2 class="font-display text-lg font-semibold">The trend</h2>
        <span
          class:list={[
            'inline-flex items-center gap-1 rounded-full bg-paper-200 px-2.5 py-0.5 text-[11px] font-bold text-ink-600 dark:bg-plum-800 dark:text-ink-400',
            previous ? '' : 'hidden',
          ]}
          data-delta-chip
        >
          <Icon
            name="ph:trend-up"
            class:list={['h-3.5 w-3.5', deltaG >= 0 ? '' : 'hidden']}
            data-delta-up
            aria-hidden="true"
          />
          <Icon
            name="ph:trend-down"
            class:list={['h-3.5 w-3.5', deltaG < 0 ? '' : 'hidden']}
            data-delta-down
            aria-hidden="true"
          />
          <span data-delta-text>
            {Math.abs(deltaG)} g {deltaG >= 0 ? 'up' : 'down'} since the last audit
          </span>
        </span>
      </div>

      <svg
        viewBox={`0 0 ${CHART.W} ${CHART.H}`}
        class="mt-3 h-auto w-full"
        role="img"
        aria-label={chartAriaLabel(entries)}
        data-weight-chart
        set:html={chartSvg(entries, weightTarget)}
      />

      <p class="mt-3 text-[11px] leading-relaxed text-ink-400">
        The amber band is the healthy adult range ({weight.healthyTarget}).
        {weight.note} {bandNote}
      </p>
    </div>
  </section>

  <!-- Log a weigh-in: PIN-gated write through the log_weight RPC -->
  {
    supabaseClient && (
      <section
        class="mx-auto w-full max-w-2xl px-5 pt-10 print:hidden"
        aria-label="Log a weigh-in"
      >
        <details class="reveal group">
          <summary class="mb-2 flex cursor-pointer list-none items-center gap-1.5 text-[11px] font-bold tracking-[0.24em] text-blush-500 uppercase dark:text-blush-300 [&::-webkit-details-marker]:hidden">
            <Icon
              name="ph:caret-right"
              class="h-3.5 w-3.5 transition-transform duration-200 group-open:rotate-90"
              aria-hidden="true"
            />
            Log a weigh-in
            <span class="font-bold tracking-normal normal-case text-ink-400">
              · staff only
            </span>
          </summary>
          <form
          data-weight-form
          data-supabase-url={supabaseClient.url}
          data-supabase-key={supabaseClient.key}
          class="reveal rounded-3xl border border-blush-200/70 bg-paper-50 p-5 sm:p-6 dark:border-plum-700 dark:bg-plum-900"
        >
          <!-- 2×2 on every screen: date | weight, then PIN | submit -->
          <div class="grid grid-cols-2 gap-3">
            <label class="block">
              <span class="text-[10px] font-bold tracking-[0.14em] text-ink-400 uppercase">
                Date
              </span>
              <input
                type="date"
                name="date"
                required
                class="mt-1 w-full rounded-xl border border-blush-200/70 bg-paper-100 px-3 py-2 text-sm font-bold outline-none focus:border-blush-400 dark:border-plum-700 dark:bg-plum-950"
              />
            </label>
            <label class="block">
              <span class="text-[10px] font-bold tracking-[0.14em] text-ink-400 uppercase">
                Weight (kg)
              </span>
              <input
                type="number"
                name="kg"
                required
                step="0.01"
                min="0.5"
                max="15"
                inputmode="decimal"
                placeholder="2.75"
                class="mt-1 w-full rounded-xl border border-blush-200/70 bg-paper-100 px-3 py-2 text-sm font-bold outline-none focus:border-blush-400 dark:border-plum-700 dark:bg-plum-950"
              />
            </label>
            <label class="block">
              <span class="text-[10px] font-bold tracking-[0.14em] text-ink-400 uppercase">
                Registrar PIN
              </span>
              <input
                type="password"
                name="pin"
                required
                autocomplete="off"
                placeholder="staff only"
                class="mt-1 w-full rounded-xl border border-blush-200/70 bg-paper-100 px-3 py-2 text-sm font-bold outline-none focus:border-blush-400 dark:border-plum-700 dark:bg-plum-950"
              />
            </label>
            <div class="flex items-end">
              <button
                type="submit"
                class="inline-flex w-full items-center justify-center gap-2 rounded-xl bg-blush-600 px-4 py-2 text-sm font-bold text-white shadow-sm transition-all duration-200 hover:-translate-y-0.5 hover:bg-blush-700 hover:shadow-md active:translate-y-0 disabled:opacity-50"
              >
                <Icon name="ph:scales" class="h-4.5 w-4.5" aria-hidden="true" />
                Record the audit
              </button>
            </div>
          </div>
          <p
            class="mt-3 min-h-4 text-xs font-bold text-ink-400"
            data-form-status
            aria-live="polite"
          >
          </p>
          <p class="mt-3 text-[11px] leading-relaxed text-ink-400">
            Staff only: entries need the registrar's PIN (it is remembered on
            this device after the first successful audit). Same-date entries
            update the existing row.
          </p>
          </form>
        </details>
      </section>
    )
  }

  <!-- The ledger: every audit, newest first (doubles as the accessible table) -->
  <section
    class="mx-auto w-full max-w-2xl px-5 pt-10 pb-8 md:pb-0"
    aria-label="Weigh-in ledger"
  >
    <h2
      class="reveal mb-2 text-[11px] font-bold tracking-[0.24em] text-blush-500 uppercase dark:text-blush-300"
    >
      The ledger
    </h2>
    <div
      class="reveal overflow-hidden rounded-3xl border border-blush-200/70 bg-paper-50 dark:border-plum-700 dark:bg-plum-900"
    >
      <ul class="divide-y divide-paper-200 dark:divide-plum-800" data-ledger>
        {
          ledger.map((p, i) => {
            const idx = entries.length - 1 - i;
            const prev = idx > 0 ? entries[idx - 1] : undefined;
            const rowDelta = prev ? Math.round((p.kg - prev.kg) * 1000) : undefined;
            return (
              <li class="flex items-center gap-3.5 px-5 py-4">
                <span
                  class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-blush-100 text-blush-600 dark:bg-plum-800 dark:text-blush-300"
                  aria-hidden="true"
                >
                  <Icon name="ph:scales" class="h-5 w-5" />
                </span>
                <div class="min-w-0 flex-1">
                  <p class="font-display font-semibold" data-row-date>
                    {dateLabel(p.date)}
                  </p>
                  <p class="text-xs text-ink-400" data-row-sub>
                    audit no. {String(idx + 1).padStart(2, '0')}
                    {i === 0 && ' · latest'}
                  </p>
                </div>
                <div class="text-right">
                  <p class="font-display text-lg font-semibold" data-row-kg>
                    {p.kg} kg
                  </p>
                  <p class="flex items-center justify-end gap-1 text-[11px] font-bold text-ink-400">
                    <Icon
                      name="ph:trend-up"
                      class:list={[
                        'h-3 w-3',
                        rowDelta !== undefined && rowDelta >= 0 ? '' : 'hidden',
                      ]}
                      data-row-up
                      aria-hidden="true"
                    />
                    <Icon
                      name="ph:trend-down"
                      class:list={[
                        'h-3 w-3',
                        rowDelta !== undefined && rowDelta < 0 ? '' : 'hidden',
                      ]}
                      data-row-down
                      aria-hidden="true"
                    />
                    <span data-row-delta>
                      {rowDelta === undefined ? 'opening entry' : `${Math.abs(rowDelta)} g`}
                    </span>
                  </p>
                </div>
              </li>
            );
          })
        }
      </ul>
    </div>
    <p class="mt-2 px-1 text-[11px] text-ink-400">
      The ledger lives in the cloud and refreshes on every visit. Audits are
      recorded above by PIN-carrying staff, or in the Supabase dashboard.
    </p>
  </section>

  <Footer />

  <script>
    import { weightTarget, type WeightEntry } from '../data/picha';
    import { chartSvg, chartAriaLabel, weightStats } from '../lib/weight-viz';
    import { dateLabel, shortLabel } from '../lib/dates';
    import { sbSelect, sbRpc } from '../lib/sb';

    // Shared registrar PIN across tools (weight + training).
    const PIN_KEY = 'picha-staff-pin';

    function render(entries: WeightEntry[]) {
      if (!entries.length) return;
      const { heaviest, lightest, average, latest, previous, deltaG } =
        weightStats(entries);

      // chart
      const svg = document.querySelector<SVGElement>('[data-weight-chart]');
      if (svg) {
        svg.innerHTML = chartSvg(entries, weightTarget);
        svg.setAttribute('aria-label', chartAriaLabel(entries));
      }

      // stat tiles
      const set = (sel: string, text: string) => {
        const el = document.querySelector<HTMLElement>(sel);
        if (el) el.textContent = text;
      };
      set('[data-stat=current]', `${latest.kg} kg`);
      set('[data-stat-sub=current]', `weighed ${shortLabel(latest.date)}`);
      set('[data-stat=heaviest]', `${heaviest.kg} kg`);
      set('[data-stat-sub=heaviest]', `peak floof, ${shortLabel(heaviest.date)}`);
      set('[data-stat=lightest]', `${lightest.kg} kg`);
      set('[data-stat-sub=lightest]', `featherweight, ${shortLabel(lightest.date)}`);
      set('[data-stat=average]', `${average.toFixed(2)} kg`);
      set('[data-stat-sub=average]', `across ${entries.length} audit${entries.length === 1 ? '' : 's'}`);

      // delta chip
      const chip = document.querySelector<HTMLElement>('[data-delta-chip]');
      if (chip) {
        chip.classList.toggle('hidden', !previous);
        chip.querySelector('[data-delta-up]')?.classList.toggle('hidden', deltaG < 0);
        chip.querySelector('[data-delta-down]')?.classList.toggle('hidden', deltaG >= 0);
        const text = chip.querySelector('[data-delta-text]');
        if (text)
          text.textContent = ` ${Math.abs(deltaG)} g ${deltaG >= 0 ? 'up' : 'down'} since the last audit`;
      }

      // ledger: clone the first row as a template, then rebuild
      const list = document.querySelector<HTMLElement>('[data-ledger]');
      const proto = list?.querySelector('li');
      if (!list || !proto) return;
      const rows = [...entries].reverse().map((p, i) => {
        const idx = entries.length - 1 - i;
        const prev = idx > 0 ? entries[idx - 1] : undefined;
        const rowDelta = prev ? Math.round((p.kg - prev.kg) * 1000) : undefined;
        const li = proto.cloneNode(true) as HTMLElement;
        const q = (sel: string) => li.querySelector<HTMLElement>(sel);
        q('[data-row-date]')!.textContent = dateLabel(p.date);
        q('[data-row-sub]')!.textContent =
          `audit no. ${String(idx + 1).padStart(2, '0')}${i === 0 ? ' · latest' : ''}`;
        q('[data-row-kg]')!.textContent = `${p.kg} kg`;
        q('[data-row-up]')?.classList.toggle(
          'hidden',
          rowDelta === undefined || rowDelta < 0,
        );
        q('[data-row-down]')?.classList.toggle(
          'hidden',
          rowDelta === undefined || rowDelta >= 0,
        );
        q('[data-row-delta]')!.textContent =
          rowDelta === undefined ? 'opening entry' : `${Math.abs(rowDelta)} g`;
        return li;
      });
      list.replaceChildren(...rows);
    }

    function setupWeightLive() {
      const form = document.querySelector<HTMLFormElement>('[data-weight-form]');
      if (!form || form.dataset.bound) return;
      form.dataset.bound = '1';
      const url = form.dataset.supabaseUrl!;
      const key = form.dataset.supabaseKey!;

      const refresh = async () => {
        try {
          const rows = await sbSelect<Array<{ date: string; kg: number | string }>>(
            url,
            key,
            'picha_weights?select=date,kg&order=date.asc',
          );
          if (Array.isArray(rows) && rows.length) {
            render(rows.map((r) => ({ date: r.date, kg: Number(r.kg) })));
          }
        } catch {
          /* offline or blocked: the built-in data stands */
        }
      };

      // defaults + remembered PIN
      const dateInput = form.elements.namedItem('date') as HTMLInputElement;
      const pinInput = form.elements.namedItem('pin') as HTMLInputElement;
      dateInput.value = new Date().toISOString().slice(0, 10);
      dateInput.max = dateInput.value; // audits are recorded, not scheduled
      pinInput.value = localStorage.getItem(PIN_KEY) ?? '';
      // known staff device: keep the form ready to use
      if (pinInput.value) form.closest('details')?.setAttribute('open', '');

      const status = form.querySelector<HTMLElement>('[data-form-status]')!;
      const setStatus = (text: string, isError = false) => {
        status.textContent = text;
        status.classList.toggle('text-red-500', isError);
        status.classList.toggle('text-ink-400', !isError);
      };
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const kgInput = form.elements.namedItem('kg') as HTMLInputElement;
        const button = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
        button.disabled = true;
        setStatus('Filing the paperwork…');
        try {
          await sbRpc(url, key, 'log_weight', {
            p_date: dateInput.value,
            p_kg: Number(kgInput.value),
            p_pin: pinInput.value,
          });
          localStorage.setItem(PIN_KEY, pinInput.value);
          kgInput.value = '';
          setStatus('Recorded. Management has been weighed.');
          await refresh();
        } catch (err) {
          setStatus(
            String(err).includes('wrong pin')
              ? 'Wrong PIN. The registrar is unimpressed.'
              : 'Could not record it. Check the connection and try again.',
            true,
          );
        } finally {
          button.disabled = false;
          setTimeout(() => setStatus(''), 4000);
        }
      });

      refresh();
    }

    setupWeightLive();
    document.addEventListener('astro:page-load', setupWeightLive);
  </script>
</Layout>
