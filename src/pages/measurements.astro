---
import { Icon } from 'astro-icon/components';
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import Footer from '../components/Footer.astro';
import MeasureForm from '../components/MeasureForm.astro';
import IconButton from '../components/ui/IconButton.astro';
import SheetHeader from '../components/ui/SheetHeader.astro';
import SectionLabel from '../components/ui/SectionLabel.astro';
import IconBadge from '../components/ui/IconBadge.astro';
import { measurementDims } from '../data/picha';
import { measurementHistory, currentMeasurements, hasMeasurements } from '../data/measurements';
import { currentWeight } from '../data/weights';
import { supabaseClient } from '../data/supabase';
import { dateLabel, shortLabel } from '../lib/dates';
import { getMeasureCopy } from '../i18n/content';

const locale = Astro.currentLocale ?? 'en';
const c = getMeasureCopy(locale);

// One summary line per past session: "Back 32.0 · Chest 28.5 cm" for the
// dimensions recorded that day. Shared shape with the client re-render.
const sessionSummary = (e: (typeof measurementHistory)[number]) =>
  measurementDims
    .filter((d) => e[d.id] !== undefined && e[d.id] !== null)
    .map((d) => `${c.dims[d.id].label} ${e[d.id]}`)
    .join(' · ');

const ledger = [...measurementHistory].reverse(); // newest first
---

<Layout title={c.metaTitle} description={c.metaDescription} current="tools" appTitle={c.appTitle}>
  {
    supabaseClient && (
      <IconButton
        slot="app-action"
        icon="ph:plus-circle"
        label={c.logLabel}
        data-measure-open
        data-staff-only
        style="display:none"
      />
    )
  }
  <PageHeader kicker={c.kicker} title={c.title} blurb={`${c.blurb} ${c.note}`} />

  <!-- Current sizes: grouped inset list, one row per dimension + weight. Each
       row's value/date update live (client re-fetch). -->
  <section class="mx-auto w-full max-w-2xl px-5 pt-5" aria-label={c.cardLabel}>
    <div class="reveal mb-2 flex items-center justify-between gap-3">
      <SectionLabel class="!mb-0">{c.cardLabel}</SectionLabel>
      <div
        role="group"
        aria-label={c.unitsLabel}
        data-unit-toggle
        class="inline-flex overflow-hidden rounded-full border border-blush-200/70 text-[11px] font-bold dark:border-plum-700"
      >
        <button type="button" data-unit-btn="cm" class="bg-blush-600 px-2.5 py-1 text-white transition-colors">cm</button>
        <button type="button" data-unit-btn="in" class="px-2.5 py-1 text-ink-500 transition-colors dark:text-ink-400">in</button>
      </div>
    </div>
    <div
      class="reveal overflow-hidden rounded-3xl border border-blush-200/70 bg-paper-50 dark:border-plum-700 dark:bg-plum-900"
      data-supabase-url={supabaseClient?.url}
      data-supabase-key={supabaseClient?.key}
    >
      <ul class="divide-y divide-paper-200 dark:divide-plum-800">
        {
          measurementDims.map((d) => {
            const cur = currentMeasurements[d.id];
            return (
              <li class="flex items-center gap-3.5 px-5 py-4" data-dim={d.id}>
                <IconBadge icon={d.icon} size="sm" />
                <div class="min-w-0 flex-1">
                  <p class="font-display font-semibold">{c.dims[d.id].label}</p>
                  <p class="text-xs text-ink-400" data-dim-date>
                    {cur ? `${c.measuredPre} ${shortLabel(cur.date, locale)}` : c.notMeasured}
                  </p>
                </div>
                <p
                  class="font-display text-lg font-semibold whitespace-nowrap"
                  data-dim-value
                  {...(cur ? { 'data-cm': cur.cm } : {})}
                >
                  {cur ? `${cur.cm} ${c.unit}` : '—'}
                </p>
              </li>
            );
          })
        }
        <!-- Weight, pulled from the tracker (reference for size charts) -->
        <li class="flex items-center gap-3.5 px-5 py-4">
          <IconBadge icon="ph:scales" size="sm" />
          <div class="min-w-0 flex-1">
            <p class="font-display font-semibold">{c.weightLabel}</p>
            <p class="text-xs text-ink-400">{c.weightSub}</p>
          </div>
          <p class="font-display text-lg font-semibold whitespace-nowrap">{currentWeight.label}</p>
        </li>
      </ul>
    </div>
    <p class="mt-3 px-1 text-[11px] leading-relaxed text-ink-400">{c.shopNote}</p>
  </section>

  <!-- How to measure -->
  <section class="mx-auto w-full max-w-2xl px-5 pt-10" aria-label={c.guideLabel}>
    <SectionLabel class="reveal mb-2" icon="ph:ruler">{c.guideLabel}</SectionLabel>
    <div
      class="reveal rounded-3xl border border-blush-200/70 bg-paper-50 p-5 sm:p-6 dark:border-plum-700 dark:bg-plum-900"
    >
      <p class="text-sm leading-relaxed text-ink-600 dark:text-ink-400">{c.guideIntro}</p>
      <dl class="mt-4 space-y-3">
        {
          measurementDims.map((d) => (
            <div class="flex items-start gap-3">
              <Icon
                name={d.icon}
                class="mt-0.5 h-4 w-4 shrink-0 text-blush-500 dark:text-blush-300"
                aria-hidden="true"
              />
              <div>
                <dt class="font-display text-sm font-semibold">{c.dims[d.id].label}</dt>
                <dd class="text-xs leading-relaxed text-ink-600 dark:text-ink-400">
                  {c.dims[d.id].how}
                </dd>
              </div>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- Measurement log: past sessions, newest first. Hidden until there is one;
       the client reveals + fills it after a live re-fetch. -->
  <section
    class="mx-auto w-full max-w-2xl px-5 pt-10 pb-8 md:pb-0"
    aria-label={c.historyLabel}
    data-measure-history
    hidden={!hasMeasurements}
  >
    <SectionLabel class="mb-2">{c.historyLabel}</SectionLabel>
    <div
      class="overflow-hidden rounded-3xl border border-blush-200/70 bg-paper-50 dark:border-plum-700 dark:bg-plum-900"
    >
      <ul class="divide-y divide-paper-200 dark:divide-plum-800" data-measure-ledger>
        {
          ledger.map((e) => (
            <li class="flex items-start gap-3.5 px-5 py-4">
              <IconBadge icon="ph:ruler" size="sm" />
              <div class="min-w-0 flex-1">
                <p class="font-display font-semibold" data-row-date>
                  {dateLabel(e.date, locale)}
                </p>
                <p class="mt-0.5 text-xs leading-relaxed text-ink-400" data-row-dims>
                  {sessionSummary(e)} {c.unit}
                </p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {
    supabaseClient && (
      <>
        {/* desktop: accordion (staff-only) */}
        <section
          class="mx-auto hidden w-full max-w-2xl px-5 pt-10 md:block print:hidden"
          aria-label={c.logLabel}
          data-staff-only
          style="display:none"
        >
          <SectionLabel class="mb-2">
            {c.logLabel}{' '}
            <span class="font-bold tracking-normal normal-case text-ink-400">· {c.staffOnly}</span>
          </SectionLabel>
          <MeasureForm />
        </section>

        {/* mobile: dialog, opened from the app-bar action */}
        <dialog id="measure" class="sheet md:hidden" aria-labelledby="measure-title">
          <div class="rounded-2xl bg-paper-50 shadow-2xl max-md:rounded-b-none max-md:pb-[env(safe-area-inset-bottom)] dark:bg-plum-900">
            <SheetHeader title={c.logLabel} titleId="measure-title" />
            <div class="p-4">
              <MeasureForm flush />
            </div>
          </div>
        </dialog>
      </>
    )
  }

  {/* a little breathing room above the mobile tab bar (last section varies) */}
  <div class="h-8 md:hidden" aria-hidden="true"></div>

  <Footer />

  <script>
    import { measurementDims } from '../data/picha';
    import { sbSelect, sbRpc } from '../lib/sb';
    import { staffPin, forgetStaffPin, applyStaffVisibility } from '../lib/staff';
    import { dateLabel, shortLabel } from '../lib/dates';
    import { getMeasureCopy } from '../i18n/content';

    type Row = { date: string; [k: string]: string | number | null };
    const mLocale = () => document.documentElement.lang || 'en';
    const COLS = measurementDims.map((d) => ({ id: d.id, col: `${d.id}_cm` }));

    let liveRefresh: (() => Promise<void>) | null = null;
    let lastRows: Row[] | null = null;

    // cm/inch display toggle (remembered per device; facts stay cm).
    const UNIT_KEY = 'picha-measure-unit';
    let unitMem: 'cm' | 'in' | null = null;
    const curUnit = (): 'cm' | 'in' => {
      if (unitMem) return unitMem;
      try {
        return localStorage.getItem(UNIT_KEY) === 'in' ? 'in' : 'cm';
      } catch {
        return 'cm';
      }
    };
    const setUnit = (u: 'cm' | 'in') => {
      unitMem = u;
      try {
        localStorage.setItem(UNIT_KEY, u);
      } catch {
        /* private mode: the in-memory choice still applies */
      }
    };
    const unitLabel = (unit: 'cm' | 'in', c: { unit: string }) =>
      unit === 'in' ? 'in' : c.unit;
    const toDisplay = (cm: number, unit: 'cm' | 'in') =>
      unit === 'in' ? (cm / 2.54).toFixed(1) : String(cm);

    // Latest value + date per dimension across all sessions.
    function currentOf(rows: Row[]) {
      const cur: Record<string, { cm: number; date: string } | null> = {};
      for (const { id, col } of COLS) {
        cur[id] = null;
        for (let i = rows.length - 1; i >= 0; i--) {
          const v = rows[i][col];
          if (v !== undefined && v !== null && v !== '') {
            cur[id] = { cm: Number(v), date: rows[i].date };
            break;
          }
        }
      }
      return cur;
    }

    function render(rows: Row[]) {
      lastRows = rows;
      const locale = mLocale();
      const unit = curUnit();
      const c = getMeasureCopy(locale);
      const cur = currentOf(rows);

      // current-sizes rows
      for (const { id } of COLS) {
        const row = document.querySelector<HTMLElement>(`[data-dim="${id}"]`);
        if (!row) continue;
        const v = cur[id];
        const val = row.querySelector<HTMLElement>('[data-dim-value]');
        const date = row.querySelector<HTMLElement>('[data-dim-date]');
        if (val) {
          if (v) val.setAttribute('data-cm', String(v.cm));
          else val.removeAttribute('data-cm');
          val.textContent = v ? `${toDisplay(v.cm, unit)} ${unitLabel(unit, c)}` : '—';
        }
        if (date) date.textContent = v ? `${c.measuredPre} ${shortLabel(v.date, locale)}` : c.notMeasured;
      }

      // history ledger
      const section = document.querySelector<HTMLElement>('[data-measure-history]');
      const list = document.querySelector<HTMLElement>('[data-measure-ledger]');
      const proto = list?.querySelector('li');
      if (section && list && proto) {
        const sorted = [...rows].sort((a, b) => b.date.localeCompare(a.date));
        if (!sorted.length) {
          section.hidden = true;
        } else {
          section.hidden = false;
          const nodes = sorted.map((e) => {
            const li = proto.cloneNode(true) as HTMLElement;
            li.querySelector<HTMLElement>('[data-row-date]')!.textContent = dateLabel(e.date, locale);
            const dims = measurementDims
              .filter((d) => e[`${d.id}_cm`] !== undefined && e[`${d.id}_cm`] !== null && e[`${d.id}_cm`] !== '')
              .map((d) => `${c.dims[d.id].label} ${toDisplay(Number(e[`${d.id}_cm`]), unit)}`)
              .join(' · ');
            li.querySelector<HTMLElement>('[data-row-dims]')!.textContent = `${dims} ${unitLabel(unit, c)}`;
            return li;
          });
          list.replaceChildren(...nodes);
        }
      }
    }

    // Apply the active unit to the toggle, the card, the history and the forms.
    function applyUnit() {
      const unit = curUnit();
      const c = getMeasureCopy(mLocale());
      document.querySelectorAll<HTMLElement>('[data-unit-btn]').forEach((btn) => {
        const active = btn.dataset.unitBtn === unit;
        btn.classList.toggle('bg-blush-600', active);
        btn.classList.toggle('text-white', active);
        btn.classList.toggle('text-ink-500', !active);
        btn.classList.toggle('dark:text-ink-400', !active);
      });
      document
        .querySelectorAll<HTMLElement>('[data-unit-label]')
        .forEach((el) => (el.textContent = unitLabel(unit, c)));
      document
        .querySelectorAll<HTMLFormElement>('[data-measure-form]')
        .forEach((f) => (f.dataset.unit = unit));
      if (lastRows) render(lastRows);
      else
        document.querySelectorAll<HTMLElement>('[data-dim-value][data-cm]').forEach((el) => {
          el.textContent = `${toDisplay(Number(el.dataset.cm), unit)} ${unitLabel(unit, c)}`;
        });
    }

    function bindUnitToggle() {
      document
        .querySelectorAll<HTMLElement>('[data-unit-btn]:not([data-bound])')
        .forEach((btn) => {
          btn.dataset.bound = '1';
          btn.addEventListener('click', () => {
            setUnit(btn.dataset.unitBtn === 'in' ? 'in' : 'cm');
            applyUnit();
          });
        });
    }

    function bindForm(form: HTMLFormElement, refresh: () => Promise<void>) {
      const url = form.dataset.supabaseUrl!;
      const key = form.dataset.supabaseKey!;
      const dateInput = form.elements.namedItem('date') as HTMLInputElement;
      dateInput.value = new Date().toISOString().slice(0, 10);
      dateInput.max = dateInput.value;

      const status = form.querySelector<HTMLElement>('[data-form-status]')!;
      const setStatus = (text: string, isError = false) => {
        status.textContent = text;
        status.classList.toggle('text-red-500', isError);
        status.classList.toggle('text-ink-400', !isError);
      };
      const fc = () => getMeasureCopy(mLocale()).form;

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        // The form shows whatever unit is active, but we always store cm.
        const toCm = form.dataset.unit === 'in';
        const num = (name: string) => {
          const el = form.elements.namedItem(name) as HTMLInputElement | null;
          if (!el || el.value.trim() === '') return null;
          const n = Number(el.value);
          return toCm ? Math.round(n * 2.54 * 10) / 10 : n;
        };
        const vals = {
          p_back: num('back'),
          p_chest: num('chest'),
          p_neck: num('neck'),
          p_belly: num('belly'),
          p_leg: num('leg'),
        };
        if (Object.values(vals).every((v) => v === null)) {
          setStatus(fc().nothingEntered, true);
          setTimeout(() => setStatus(''), 4000);
          return;
        }
        const button = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
        button.disabled = true;
        setStatus(fc().filing);
        try {
          await sbRpc(url, key, 'log_measurement', {
            p_date: dateInput.value,
            ...vals,
            p_pin: staffPin() ?? '',
          });
          form.reset();
          dateInput.value = new Date().toISOString().slice(0, 10);
          setStatus(fc().recorded);
          await refresh();
          const dialog = form.closest('dialog');
          if (dialog?.open) {
            const { animatedClose } = await import('../lib/dialog');
            setTimeout(() => animatedClose(dialog), 900);
          }
        } catch (err) {
          if (String(err).includes('wrong pin')) {
            forgetStaffPin();
            applyStaffVisibility();
            setStatus(fc().signExpired, true);
          } else {
            setStatus(fc().couldNotRecord, true);
          }
        } finally {
          button.disabled = false;
          setTimeout(() => setStatus(''), 4000);
        }
      });
    }

    async function setup() {
      applyStaffVisibility();
      bindUnitToggle();
      applyUnit();
      const root = document.querySelector<HTMLElement>('[data-supabase-url][data-supabase-key]');
      const url = root?.dataset.supabaseUrl;
      const key = root?.dataset.supabaseKey;
      if (!url || !key) return;

      const refresh = async () => {
        try {
          const rows = await sbSelect<Row[]>(
            url,
            key,
            'picha_measurements?select=date,back_cm,chest_cm,neck_cm,belly_cm,leg_cm&order=date.asc',
          );
          if (Array.isArray(rows)) render(rows);
        } catch {
          /* offline: the built-in data stands */
        }
      };
      liveRefresh = refresh;

      document
        .querySelectorAll<HTMLFormElement>('[data-measure-form]:not([data-bound])')
        .forEach((form) => {
          form.dataset.bound = '1';
          bindForm(form, refresh);
        });

      const dialog = document.getElementById('measure') as HTMLDialogElement | null;
      if (dialog) {
        const { bindDialog } = await import('../lib/dialog');
        bindDialog(dialog);
        document.querySelectorAll<HTMLElement>('[data-measure-open]').forEach((btn) => {
          if (btn.dataset.bound) return;
          btn.dataset.bound = '1';
          btn.addEventListener('click', () => dialog.showModal());
        });
      }

      refresh();
    }

    setup();
    document.addEventListener('astro:page-load', setup);
    const revalidate = () => {
      if (document.querySelector('[data-measure-ledger]')) liveRefresh?.();
    };
    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'visible') revalidate();
    });
    window.addEventListener('pageshow', (e) => {
      if ((e as PageTransitionEvent).persisted) revalidate();
    });
  </script>
</Layout>
