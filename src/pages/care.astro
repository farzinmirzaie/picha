---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import Footer from '../components/Footer.astro';
import pichaPhoto from '../assets/picha.jpg';
import {
  identity,
  treatment,
  food,
  grooming,
  litter,
  safety,
  toxicItems,
  microchip,
  contact,
} from '../data/picha';

// The routine, arranged as a day rhythm: ongoing treatment first, then
// grooming sorted from most to least frequent (data keeps its own order).
const rhythm = [...treatment, ...grooming];
---

<Layout title="Care · Picha 🐾" current="care">
  <PageHeader
    kicker="Daily Care"
    title="A day with Picha"
    blurb="Serving Picha is a full-time position. The daily protocol — and the house rules — as dictated by management."
  />

  <!-- The rhythm -->
  <section class="mx-auto w-full max-w-2xl px-5 pt-6" aria-label="Routine">
    <ul class="divide-y divide-paper-300/70 dark:divide-plum-800">
      {
        rhythm.map((item, i) => (
          <li
            class="reveal flex items-start gap-4 py-5"
            style={`--reveal-delay: ${i * 70}ms`}
          >
            <span
              class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-blush-100 text-blush-600 dark:bg-plum-800 dark:text-blush-300"
              aria-hidden="true"
            >
              <Icon name={item.icon} class="h-5.5 w-5.5" />
            </span>
            <div class="min-w-0">
              <div class="flex flex-wrap items-center gap-2">
                <h3 class="font-display text-lg font-semibold">{item.title}</h3>
                {item.cadence && (
                  <span class="rounded-full bg-blush-100 px-2.5 py-0.5 text-[11px] font-bold whitespace-nowrap text-blush-700 dark:bg-plum-800 dark:text-blush-300">
                    {item.cadence}
                  </span>
                )}
              </div>
              <p class="mt-0.5 text-sm leading-relaxed text-ink-600 dark:text-ink-400">
                {item.detail}
              </p>
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- On the menu -->
  <section class="mx-auto w-full max-w-2xl px-5 pt-10" aria-label="Food">
    <div
      class="reveal rounded-3xl border border-blush-200/70 bg-paper-50 p-6 sm:p-8 dark:border-plum-700 dark:bg-plum-900"
    >
      <p
        class="text-center text-[10px] font-bold tracking-[0.3em] text-blush-400 uppercase dark:text-blush-300/70"
      >
        · On the menu ·
      </p>
      <ul class="mt-5 space-y-5">
        {
          food.map((f) => (
            <li>
              <div class="flex items-baseline gap-2">
                <Icon
                  name={f.icon}
                  class="h-4.5 w-4.5 shrink-0 translate-y-0.5 text-blush-500 dark:text-blush-300"
                  aria-hidden="true"
                />
                <h3 class="font-display font-semibold">{f.title}</h3>
                <span
                  class="mx-1 flex-1 border-b border-dotted border-ink-400/40"
                  aria-hidden="true"
                />
              </div>
              <p class="mt-1 pl-7 text-sm leading-relaxed text-ink-600 dark:text-ink-400">
                {f.detail}
              </p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Litter corner -->
  <section class="mx-auto w-full max-w-2xl px-5 pt-10" aria-label="Litter">
    <h2
      class="reveal text-[11px] font-bold tracking-[0.24em] text-blush-500 uppercase dark:text-blush-300"
    >
      The litter corner
    </h2>
    <div class="mt-3 space-y-4">
      {
        litter.map((l) => (
          <p class="reveal flex gap-2.5 text-sm leading-relaxed text-ink-600 dark:text-ink-400">
            <Icon
              name={l.icon}
              class="mt-0.5 h-4.5 w-4.5 shrink-0 text-blush-500 dark:text-blush-300"
              aria-hidden="true"
            />
            <span>
              <strong class="font-semibold text-ink-900 dark:text-paper-100">
                {l.title}:
              </strong>{' '}
              {l.detail}
            </span>
          </p>
        ))
      }
    </div>
  </section>

  <!-- House rules (formerly the Safety tab) -->
  <section class="mx-auto w-full max-w-2xl px-5 pt-12" aria-label="House rules">
    <h2
      class="reveal text-[11px] font-bold tracking-[0.24em] text-blush-500 uppercase dark:text-blush-300"
    >
      House rules
    </h2>
    <ul class="divide-y divide-paper-300/70 dark:divide-plum-800">
      {
        safety.map((s, i) => (
          <li
            class="reveal flex items-start gap-4 py-5"
            style={`--reveal-delay: ${i * 80}ms`}
          >
            <span
              class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-blush-100 text-blush-600 dark:bg-plum-800 dark:text-blush-300"
              aria-hidden="true"
            >
              <Icon name={s.icon} class="h-5.5 w-5.5" />
            </span>
            <div>
              <h3 class="font-display text-lg font-semibold">{s.title}</h3>
              <p class="mt-0.5 text-sm leading-relaxed text-ink-600 dark:text-ink-400">
                {s.detail}
              </p>
            </div>
          </li>
        ))
      }
    </ul>

    <!-- Toxic list: deliberately plain-spoken. -->
    <h3
      class="reveal mt-6 flex items-center gap-1.5 text-[11px] font-bold tracking-[0.24em] text-red-500 uppercase dark:text-red-300"
    >
      <Icon name="ph:prohibit" class="h-3.5 w-3.5" aria-hidden="true" />
      Never within reach
    </h3>
    <ul class="mt-3 flex flex-wrap gap-2">
      {
        toxicItems.map((t, i) => (
          <li
            class="reveal rounded-full bg-red-50 px-3.5 py-1.5 text-sm font-bold text-red-700 ring-1 ring-red-200 dark:bg-red-950/40 dark:text-red-300 dark:ring-red-900/50"
            style={`--reveal-delay: ${i * 60}ms`}
          >
            {t}
          </li>
        ))
      }
    </ul>
  </section>

  <!-- If found -->
  <section class="mx-auto w-full max-w-2xl px-5 pt-12" aria-label="If found">
    <div
      class="reveal overflow-hidden rounded-3xl border-2 border-dashed border-blush-300 bg-paper-50 dark:border-plum-700 dark:bg-plum-900"
    >
      <div class="flex items-center gap-4 p-6 sm:p-7">
        <div
          class="h-20 w-20 shrink-0 overflow-hidden rounded-2xl ring-2 ring-blush-200 dark:ring-plum-700"
        >
          <Image
            src={pichaPhoto}
            alt=""
            width={160}
            densities={[1, 2]}
            class="h-full w-full object-cover"
            style="object-position: 50% 22%"
          />
        </div>
        <div class="min-w-0">
          <p
            class="text-[10px] font-bold tracking-[0.24em] text-blush-400 uppercase dark:text-blush-300/70"
          >
            If found
          </p>
          <h2 class="font-display flex items-center gap-1.5 text-xl font-semibold">
            This is {identity.name}
            <Icon
              name="ph:paw-print"
              class="h-4.5 w-4.5 text-blush-500 dark:text-blush-300"
              aria-hidden="true"
            />
          </h2>
          <p class="select-text mt-0.5 truncate text-xs text-ink-600 dark:text-ink-400">
            Microchip {microchip}
          </p>
        </div>
      </div>
      <div class="grid sm:grid-cols-2">
        {
          contact.owners.map((o) => (
            <a
              href={`tel:${o.phone.replace(/\s/g, '')}`}
              class="flex items-center justify-center gap-2 bg-blush-600 py-3.5 text-center text-sm font-bold text-white transition-colors duration-200 first:border-b first:border-blush-500/50 hover:bg-blush-700 sm:first:border-r sm:first:border-b-0"
            >
              <Icon name="ph:phone" class="h-4 w-4" aria-hidden="true" />
              {o.name} · {o.phone}
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <Footer />
</Layout>
