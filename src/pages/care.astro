---
import { Icon } from 'astro-icon/components';
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import Footer from '../components/Footer.astro';
import { dailyChecklist, food, grooming, litter, safety, toxicItems } from '../data/picha';
import { supabaseClient } from '../data/supabase';
---

<Layout
  title="Care · Picha 🐾"
  description="Picha's daily care guide: routine, food, grooming, litter and house rules."
  current="care"
>
  <PageHeader
    kicker="Daily Care"
    title="A day with Picha"
    blurb="Serving Picha is a full-time position. Check off today's rounds; she is keeping score."
  />

  <!-- Today's rounds: interactive checklist (localStorage, resets daily) -->
  <section class="mx-auto w-full max-w-2xl px-5 pt-4" aria-label="Today's rounds">
    <div class="mb-2 flex items-baseline justify-between">
      <h2
        class="reveal text-[11px] font-bold tracking-[0.24em] text-blush-500 uppercase dark:text-blush-300"
      >
        Today's rounds
      </h2>
      <span
        class="text-xs font-bold text-ink-400"
        data-check-count
        aria-live="polite">0/{dailyChecklist.length}</span
      >
    </div>
    <div
      class="reveal overflow-hidden rounded-3xl border border-blush-200/70 bg-paper-50 dark:border-plum-700 dark:bg-plum-900"
      data-rounds
      data-supabase-url={supabaseClient?.url}
      data-supabase-key={supabaseClient?.key}
    >
      <ul class="divide-y divide-paper-200 dark:divide-plum-800">
        {
          dailyChecklist.map((item) => (
            <li>
              <button
                type="button"
                data-check-item={item.id}
                aria-pressed="false"
                class="flex w-full items-center gap-3.5 px-5 py-3.5 text-left transition-colors active:bg-blush-100/50 dark:active:bg-plum-800/50"
              >
                <span
                  class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-blush-100 text-blush-600 dark:bg-plum-800 dark:text-blush-300"
                  aria-hidden="true"
                >
                  <Icon name={item.icon} class="h-5 w-5" />
                </span>
                <span class="min-w-0 flex-1">
                  <span
                    class="block font-bold text-ink-900 transition-colors dark:text-paper-100"
                    data-check-label
                  >
                    {item.label}
                  </span>
                  <span class="block truncate text-xs text-ink-400">{item.hint}</span>
                </span>
                <span
                  class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full border-2 border-blush-200 text-white transition-all duration-200 dark:border-plum-600"
                  data-check-box
                  aria-hidden="true"
                >
                  <Icon name="ph:check" class="h-3.5 w-3.5 opacity-0 transition-opacity" />
                </span>
              </button>
            </li>
          ))
        }
      </ul>
      <p
        class="hidden items-center gap-2 border-t border-paper-200 bg-blush-100/40 px-5 py-3 text-xs font-bold text-blush-700 dark:border-plum-800 dark:bg-plum-800/40 dark:text-blush-300"
        data-check-praise
      >
        <Icon name="ph:paw-print" class="h-4 w-4 shrink-0" aria-hidden="true" />
        All rounds complete. Management is pleased and will nap accordingly.
      </p>
    </div>
    <p class="mt-2 px-1 text-[11px] leading-relaxed text-ink-400" data-rounds-note></p>
  </section>

  <!-- Zone 2: the care manual (everything a stand-in needs) -->
  <section class="mx-auto w-full max-w-2xl px-5 pt-12" aria-label="The care manual">
    <div class="reveal border-t border-paper-300/70 pt-8 dark:border-plum-800">
      <p
        class="text-[11px] font-bold tracking-[0.24em] text-blush-500 uppercase dark:text-blush-300"
      >
        Reference
      </p>
      <h2 class="font-display mt-1 text-2xl font-semibold tracking-tight">
        The care manual
      </h2>
      <p class="mt-1.5 text-sm leading-relaxed text-ink-600 dark:text-ink-400">
        Everything a stand-in needs while the regular staff are off duty:
        grooming, meals, the litter corner and the house rules.
      </p>
    </div>
  </section>

  <!-- Grooming -->
  <section class="mx-auto w-full max-w-2xl px-5 pt-6" aria-label="Grooming">
    <h2
      class="reveal mb-2 text-[11px] font-bold tracking-[0.24em] text-blush-500 uppercase dark:text-blush-300"
    >
      Grooming
    </h2>
    <div
      class="reveal overflow-hidden rounded-3xl border border-blush-200/70 bg-paper-50 dark:border-plum-700 dark:bg-plum-900"
    >
      <ul class="divide-y divide-paper-200 dark:divide-plum-800">
        {
          grooming.map((item) => (
            <li class="flex items-start gap-3.5 px-5 py-4">
              <span
                class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-blush-100 text-blush-600 dark:bg-plum-800 dark:text-blush-300"
                aria-hidden="true"
              >
                <Icon name={item.icon} class="h-5 w-5" />
              </span>
              <div class="min-w-0">
                <div class="flex flex-wrap items-center gap-2">
                  <h3 class="font-display font-semibold">{item.title}</h3>
                  {item.cadence && (
                    <span class="rounded-full bg-blush-100 px-2 py-0.5 text-[10px] font-bold whitespace-nowrap text-blush-700 dark:bg-plum-800 dark:text-blush-300">
                      {item.cadence}
                    </span>
                  )}
                </div>
                <p class="mt-0.5 text-sm leading-relaxed text-ink-600 dark:text-ink-400">
                  {item.detail}
                </p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- On the menu -->
  <section class="mx-auto w-full max-w-2xl px-5 pt-8" aria-label="Food">
    <div
      class="reveal rounded-3xl border border-blush-200/70 bg-paper-50 p-6 sm:p-8 dark:border-plum-700 dark:bg-plum-900"
    >
      <p
        class="text-center text-[10px] font-bold tracking-[0.3em] text-blush-400 uppercase dark:text-blush-300/70"
      >
        · On the menu ·
      </p>
      <ul class="mt-5 space-y-5">
        {
          food.map((f) => (
            <li>
              <div class="flex items-baseline gap-2">
                <Icon
                  name={f.icon}
                  class="h-4.5 w-4.5 shrink-0 translate-y-0.5 text-blush-500 dark:text-blush-300"
                  aria-hidden="true"
                />
                <h3 class="font-display font-semibold">{f.title}</h3>
                <span
                  class="mx-1 flex-1 border-b border-dotted border-ink-400/40"
                  aria-hidden="true"
                />
              </div>
              <p class="mt-1 pl-7 text-sm leading-relaxed text-ink-600 dark:text-ink-400">
                {f.detail}
              </p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Litter corner + house rules, one grouped card each -->
  <section class="mx-auto w-full max-w-2xl px-5 pt-8" aria-label="Litter">
    <h2
      class="reveal mb-2 text-[11px] font-bold tracking-[0.24em] text-blush-500 uppercase dark:text-blush-300"
    >
      The litter corner
    </h2>
    <div
      class="reveal overflow-hidden rounded-3xl border border-blush-200/70 bg-paper-50 dark:border-plum-700 dark:bg-plum-900"
    >
      <ul class="divide-y divide-paper-200 dark:divide-plum-800">
        {
          litter.map((l) => (
            <li class="flex items-start gap-3.5 px-5 py-4">
              <span
                class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-blush-100 text-blush-600 dark:bg-plum-800 dark:text-blush-300"
                aria-hidden="true"
              >
                <Icon name={l.icon} class="h-5 w-5" />
              </span>
              <div>
                <h3 class="font-display font-semibold">{l.title}</h3>
                <p class="mt-0.5 text-sm leading-relaxed text-ink-600 dark:text-ink-400">
                  {l.detail}
                </p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="mx-auto w-full max-w-2xl px-5 pt-8" aria-label="House rules">
    <h2
      class="reveal mb-2 text-[11px] font-bold tracking-[0.24em] text-blush-500 uppercase dark:text-blush-300"
    >
      House rules
    </h2>
    <div
      class="reveal overflow-hidden rounded-3xl border border-blush-200/70 bg-paper-50 dark:border-plum-700 dark:bg-plum-900"
    >
      <ul class="divide-y divide-paper-200 dark:divide-plum-800">
        {
          safety.map((s) => (
            <li class="flex items-start gap-3.5 px-5 py-4">
              <span
                class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-blush-100 text-blush-600 dark:bg-plum-800 dark:text-blush-300"
                aria-hidden="true"
              >
                <Icon name={s.icon} class="h-5 w-5" />
              </span>
              <div>
                <h3 class="font-display font-semibold">{s.title}</h3>
                <p class="mt-0.5 text-sm leading-relaxed text-ink-600 dark:text-ink-400">
                  {s.detail}
                </p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>

    <!-- Toxic list: deliberately plain-spoken. -->
    <h3
      class="reveal mt-6 flex items-center gap-1.5 text-[11px] font-bold tracking-[0.24em] text-red-500 uppercase dark:text-red-300"
    >
      <Icon name="ph:prohibit" class="h-3.5 w-3.5" aria-hidden="true" />
      Never within reach
    </h3>
    <ul class="mt-3 flex flex-wrap gap-2">
      {
        toxicItems.map((t) => (
          <li
            class="reveal rounded-full bg-red-50 px-3.5 py-1.5 text-sm font-bold text-red-700 ring-1 ring-red-200 dark:bg-red-950/40 dark:text-red-300 dark:ring-red-900/50"
          >
            {t}
          </li>
        ))
      }
    </ul>
  </section>

  <Footer />

  <script>
    // "Today's rounds" checklist. Completion is shared across the staff's
    // devices via Supabase (picha_rounds, one row per day of done ids) with a
    // localStorage cache for offline/optimistic use; both reset each day. Item
    // ids come from dailyChecklist in picha.ts — the store only tracks ids, so
    // adding/removing items never touches the DB. Writes are PIN-gated (the
    // shared registrar PIN); a device without the PIN just stays local.
    const STORE_KEY = 'picha-rounds';
    const PIN_KEY = 'picha-staff-pin';

    type Store = { date: string; done: string[] };

    const todayIso = () => new Date().toISOString().slice(0, 10);

    function loadStore(): Store {
      const today = new Date().toDateString();
      try {
        const raw = JSON.parse(localStorage.getItem(STORE_KEY) ?? '');
        if (raw && raw.date === today && Array.isArray(raw.done)) return raw;
      } catch {
        /* fresh start */
      }
      return { date: today, done: [] };
    }

    function saveStore(done: string[]) {
      localStorage.setItem(
        STORE_KEY,
        JSON.stringify({ date: new Date().toDateString(), done }),
      );
    }

    // Pull today's shared state from Supabase (server is the source of truth
    // for the shared list); falls back to the local cache when offline.
    async function pullRounds() {
      const root = document.querySelector<HTMLElement>('[data-rounds]');
      const url = root?.dataset.supabaseUrl;
      const key = root?.dataset.supabaseKey;
      if (url && key) {
        try {
          const { sbSelect } = await import('../lib/sb');
          const rows = await sbSelect<Array<{ done: string[] }>>(
            url,
            key,
            `picha_rounds?select=done&date=eq.${todayIso()}`,
          );
          saveStore(Array.isArray(rows) && rows[0]?.done ? rows[0].done : []);
        } catch {
          /* offline: the local cache stands */
        }
      }
      paint();
    }

    // Sync-state footer: tells the staff whether ticks are shared, and points a
    // local-only device to the Staff room to enter the registrar PIN (the one
    // place PIN entry lives now).
    const staffHref = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/tools/staff/`;

    function updateNote(override?: string) {
      const note = document.querySelector<HTMLElement>('[data-rounds-note]');
      if (!note) return;
      const root = document.querySelector<HTMLElement>('[data-rounds]');
      const configured = Boolean(root?.dataset.supabaseUrl && root?.dataset.supabaseKey);
      note.textContent = '';
      note.classList.remove('text-red-500');
      note.classList.add('text-ink-400');
      if (override) {
        note.textContent = override;
        if (override.toLowerCase().includes('pin') || override.toLowerCase().includes("couldn't")) {
          note.classList.add('text-red-500');
          note.classList.remove('text-ink-400');
        }
        return;
      }
      if (!configured) {
        note.textContent = 'Ticks reset every morning.';
        return;
      }
      if (localStorage.getItem(PIN_KEY)) {
        note.textContent = "Shared across the staff's devices; resets every morning.";
        return;
      }
      note.append('Ticks stay on this device. ');
      const link = document.createElement('a');
      link.href = staffHref;
      link.className =
        'font-bold text-blush-600 underline decoration-dotted dark:text-blush-300';
      link.textContent = 'Turn on sync';
      note.append(link);
    }

    // Stateless: every paint reads the store fresh, so a day rollover always
    // shows the right state without threading a shared variable around.
    function paint() {
      const items = Array.from(
        document.querySelectorAll<HTMLButtonElement>('[data-check-item]'),
      );
      if (!items.length) return;
      const store = loadStore();
      items.forEach((btn) => {
        const checked = store.done.includes(btn.dataset.checkItem!);
        btn.setAttribute('aria-pressed', String(checked));
        const box = btn.querySelector<HTMLElement>('[data-check-box]')!;
        const tick = box.querySelector('svg');
        const label = btn.querySelector<HTMLElement>('[data-check-label]')!;
        box.classList.toggle('bg-blush-600', checked);
        box.classList.toggle('border-blush-600', checked);
        tick?.classList.toggle('opacity-0', !checked);
        label.classList.toggle('line-through', checked);
        label.classList.toggle('opacity-60', checked);
      });
      const count = document.querySelector('[data-check-count]');
      if (count) count.textContent = `${store.done.length}/${items.length}`;
      const complete = store.done.length === items.length;
      const praise = document.querySelector('[data-check-praise]');
      praise?.classList.toggle('hidden', !complete);
      praise?.classList.toggle('flex', complete);
      praise?.classList.toggle('praise-pop', complete);
    }

    function setupChecklist() {
      const root = document.querySelector<HTMLElement>('[data-rounds]');
      const items = Array.from(
        document.querySelectorAll<HTMLButtonElement>('[data-check-item]'),
      );
      if (!items.length) return;
      const url = root?.dataset.supabaseUrl;
      const key = root?.dataset.supabaseKey;

      items.forEach((btn) => {
        if (btn.dataset.bound) return;
        btn.dataset.bound = '1';
        btn.addEventListener('click', async () => {
          const store = loadStore(); // re-check the date on every tap
          const id = btn.dataset.checkItem!;
          const nowDone = !store.done.includes(id);
          store.done = nowDone
            ? [...store.done, id]
            : store.done.filter((d) => d !== id);
          saveStore(store.done); // optimistic
          paint();
          // sync to the shared store; the note explains a local-only fallback
          if (!url || !key) return;
          const pin = localStorage.getItem(PIN_KEY);
          if (!pin) {
            updateNote();
            return;
          }
          try {
            const { sbRpc } = await import('../lib/sb');
            await sbRpc(url, key, 'set_round', {
              p_date: todayIso(),
              p_item: id,
              p_done: nowDone,
              p_pin: pin,
            });
            updateNote();
          } catch (err) {
            // keep the optimistic local state, but tell the staff why
            if (String(err).includes('wrong pin')) {
              localStorage.removeItem(PIN_KEY);
              updateNote('That PIN was rejected. Open the Staff room to re-enter.');
            } else {
              updateNote("Saved on this device; couldn't reach the cloud.");
            }
          }
        });
      });

      pullRounds();
      updateNote();
    }

    setupChecklist();
    document.addEventListener('astro:page-load', setupChecklist);
    // Refocus (incl. a rollover past midnight, or a sibling device's change):
    // re-pull the shared state and repaint.
    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'visible') pullRounds();
    });
  </script>
</Layout>
