---
import { Icon } from 'astro-icon/components';
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import Footer from '../components/Footer.astro';
import SectionLabel from '../components/ui/SectionLabel.astro';
import IconBadge from '../components/ui/IconBadge.astro';
import Chip from '../components/ui/Chip.astro';
import { dailyChecklist, feedingSchedule, grooming } from '../data/picha';
import { supabaseClient } from '../data/supabase';
import { getCareCopy } from '../i18n/content';

const locale = Astro.currentLocale ?? 'en';
const c = getCareCopy(locale);
---

<Layout title={c.metaTitle} description={c.metaDescription} current="care">
  <PageHeader kicker={c.kicker} title={c.title} blurb={c.blurb} />

  <!-- Today's rounds: interactive checklist (localStorage, resets daily) -->
  <section class="mx-auto w-full max-w-2xl px-5 pt-4" aria-label="Today's rounds">
    <div class="mb-2 flex items-baseline justify-between">
      <SectionLabel class="reveal">{c.roundsLabel}</SectionLabel>
      <span
        class="text-xs font-bold text-ink-400"
        data-check-count
        aria-live="polite">0/{dailyChecklist.length}</span
      >
    </div>
    <div
      class="reveal overflow-hidden rounded-3xl border border-blush-200/70 bg-paper-50 dark:border-plum-700 dark:bg-plum-900"
      data-rounds
      data-supabase-url={supabaseClient?.url}
      data-supabase-key={supabaseClient?.key}
    >
      <ul class="divide-y divide-paper-200 dark:divide-plum-800">
        {
          dailyChecklist.map((item) => (
            <li>
              <button
                type="button"
                data-check-item={item.id}
                aria-pressed="false"
                class="flex w-full items-center gap-3.5 px-5 py-3.5 text-left transition-colors active:bg-blush-100/50 disabled:cursor-default disabled:active:bg-transparent dark:active:bg-plum-800/50"
              >
                <IconBadge icon={item.icon} size="sm" />
                <span class="min-w-0 flex-1">
                  <span
                    class="block font-bold text-ink-900 transition-colors dark:text-paper-100"
                    data-check-label
                  >
                    {c.checklist[item.id]?.label ?? item.label}
                  </span>
                  <span class="block text-xs leading-snug text-ink-400">
                    {c.checklist[item.id]?.hint ?? item.hint}
                  </span>
                </span>
                <span
                  class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full border-2 border-blush-200 text-white transition-all duration-200 dark:border-plum-600"
                  data-check-box
                  aria-hidden="true"
                >
                  <Icon name="ph:check" class="h-3.5 w-3.5 opacity-0 transition-opacity" />
                </span>
              </button>
            </li>
          ))
        }
      </ul>
      <p
        class="hidden items-center gap-2 border-t border-paper-200 bg-blush-100/40 px-5 py-3 text-xs font-bold text-blush-700 dark:border-plum-800 dark:bg-plum-800/40 dark:text-blush-300"
        data-check-praise
      >
        <Icon name="ph:paw-print" class="h-4 w-4 shrink-0" aria-hidden="true" />
        {c.praise}
      </p>
    </div>
    <p class="mt-2 px-1 text-[11px] leading-relaxed text-ink-400" data-rounds-note></p>
  </section>

  <!-- The menu: daily feeding timetable (automatic kibble + hand-served wet) -->
  <section class="mx-auto w-full max-w-2xl px-5 pt-12" aria-label="The menu">
    <SectionLabel class="reveal mb-2">{c.menuLabel}</SectionLabel>
    <div
      class="reveal overflow-hidden rounded-3xl border border-blush-200/70 bg-paper-50 dark:border-plum-700 dark:bg-plum-900"
    >
      <ul class="divide-y divide-paper-200 dark:divide-plum-800">
        {
          feedingSchedule.map((slot, i) => (
            <li class="flex items-start gap-3.5 px-5 py-4">
              <IconBadge icon={slot.icon} size="sm" />
              <div class="min-w-0 flex-1">
                <div class="flex items-baseline justify-between gap-3">
                  <h3 class="font-display font-semibold">{c.meals[i]?.title ?? slot.title}</h3>
                  <Chip tone="neutral" class="shrink-0 whitespace-nowrap tabular-nums">
                    {slot.time}
                  </Chip>
                </div>
                <p class="mt-0.5 text-sm leading-relaxed text-ink-600 dark:text-ink-400">
                  {c.meals[i]?.detail ?? slot.detail}
                </p>
                <div class="mt-1.5">
                  {slot.auto ? (
                    <Chip tone="neutral" icon="ph:timer">
                      {slot.amount} · {c.feeder}
                    </Chip>
                  ) : (
                    <Chip tone="blushSolid" icon="ph:hand-heart">
                      {c.byHand}
                    </Chip>
                  )}
                </div>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Grooming -->
  <section class="mx-auto w-full max-w-2xl px-5 pt-12 pb-10 md:pb-0" aria-label="Grooming">
    <SectionLabel class="reveal mb-2">{c.groomingLabel}</SectionLabel>
    <div
      class="reveal overflow-hidden rounded-3xl border border-blush-200/70 bg-paper-50 dark:border-plum-700 dark:bg-plum-900"
    >
      <ul class="divide-y divide-paper-200 dark:divide-plum-800">
        {
          grooming.map((item, i) => (
            <li class="flex items-start gap-3.5 px-5 py-4">
              <IconBadge icon={item.icon} size="sm" />
              <div class="min-w-0 flex-1">
                <div class="flex items-baseline justify-between gap-3">
                  <h3 class="font-display font-semibold">{c.grooming[i]?.title ?? item.title}</h3>
                  {item.cadence && (
                    <Chip
                      tone={item.planned ? 'amber' : 'neutral'}
                      class="shrink-0 whitespace-nowrap"
                    >
                      {c.grooming[i]?.cadence ?? item.cadence}
                    </Chip>
                  )}
                </div>
                <p class="mt-0.5 text-sm leading-relaxed text-ink-600 dark:text-ink-400">
                  {c.grooming[i]?.detail ?? item.detail}
                </p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <Footer />

  <script>
    // "Today's rounds" checklist. Completion is shared across the staff's
    // devices via Supabase (picha_rounds, one row per day of done ids) with a
    // localStorage cache for offline/optimistic use; both reset each day. Item
    // ids come from dailyChecklist in picha.ts — the store only tracks ids, so
    // adding/removing items never touches the DB. Writes are PIN-gated (the
    // shared registrar PIN); a device without the PIN just stays local.
    import { staffPin, hasStaffPin, forgetStaffPin } from '../lib/staff';
    import { getCareCopy } from '../i18n/content';

    // Note strings in the active locale (html lang is set per route + kept in
    // sync by ClientRouter swaps), read fresh so a locale change is picked up.
    const careNotes = () => getCareCopy(document.documentElement.lang || 'en').notes;

    const STORE_KEY = 'picha-rounds';

    type Store = { date: string; done: string[] };

    // The rounds roll over at midnight Malaysia time (UTC+8), the same wall
    // clock the staff live on — not at each device's own local midnight, so
    // every device agrees on which day is "today". Adding 8h to "now" and
    // taking the UTC date yields the MYT calendar date, which flips exactly at
    // 00:00 MYT. The reset is entirely this date key: a new day queries a date
    // with no row (or no matching cache), so the list comes up empty. The
    // build doesn't clear anything — old picha_rounds rows just sit as history.
    const MYT_OFFSET_MS = 8 * 60 * 60 * 1000; // MYT = UTC+8
    const careDayKey = () =>
      new Date(Date.now() + MYT_OFFSET_MS).toISOString().slice(0, 10);

    function loadStore(): Store {
      const today = careDayKey();
      try {
        const raw = JSON.parse(localStorage.getItem(STORE_KEY) ?? '');
        if (raw && raw.date === today && Array.isArray(raw.done)) return raw;
      } catch {
        /* fresh start */
      }
      return { date: today, done: [] };
    }

    function saveStore(done: string[]) {
      localStorage.setItem(
        STORE_KEY,
        JSON.stringify({ date: careDayKey(), done }),
      );
    }

    // Dim + pulse the list while the first shared pull is in flight, so it
    // reads as "loading" rather than a wrong (empty) answer. Later refetches
    // (refocus, pageshow) are silent since the cached list is already shown.
    let hydrated = false;
    function setListLoading(on: boolean) {
      const list = document.querySelector<HTMLElement>('[data-rounds] ul');
      list?.classList.toggle('animate-pulse', on);
      list?.classList.toggle('opacity-60', on);
    }

    // Pulse the tapped item's tickbox while its write is in flight, and mark it
    // pending so a second tap can't race the first.
    function setItemPending(btn: HTMLButtonElement, on: boolean) {
      btn.dataset.pending = on ? '1' : '';
      btn.querySelector<HTMLElement>('[data-check-box]')?.classList.toggle('animate-pulse', on);
    }

    // Pull today's shared state from Supabase (server is the source of truth
    // for the shared list); falls back to the local cache when offline.
    async function pullRounds() {
      const root = document.querySelector<HTMLElement>('[data-rounds]');
      const url = root?.dataset.supabaseUrl;
      const key = root?.dataset.supabaseKey;
      paint(); // show whatever we already have (cache / SSR) right away
      if (!url || !key) {
        updateNote();
        return;
      }
      const firstLoad = !hydrated;
      if (firstLoad) {
        setListLoading(true);
        updateNote(careNotes().loading);
      }
      try {
        const { sbSelect } = await import('../lib/sb');
        // Bound the wait so a stalled network can't leave the list pulsing
        // forever; on timeout we fall back to the cached copy.
        const rows = await Promise.race([
          sbSelect<Array<{ done: string[] }>>(
            url,
            key,
            `picha_rounds?select=done&date=eq.${careDayKey()}`,
          ),
          new Promise<never>((_, reject) =>
            setTimeout(() => reject(new Error('timeout')), 8000),
          ),
        ]);
        saveStore(Array.isArray(rows) && rows[0]?.done ? rows[0].done : []);
        updateNote();
      } catch {
        // offline / stalled / fetch failed: the local cache stands, but say so.
        updateNote(careNotes().offline, 'warn');
      } finally {
        hydrated = true;
        setListLoading(false);
        paint();
      }
    }

    // Sync-state footer: for staff it confirms the ticks are shared; for
    // everyone else it explains the list is read-only and points to the Staff
    // room to sign in (the one place the registrar PIN is entered now).
    const staffBase = import.meta.env.BASE_URL.replace(/\/$/, '');
    const staffLoc = document.documentElement.lang && document.documentElement.lang !== 'en'
      ? `/${document.documentElement.lang}`
      : '';
    const staffHref = `${staffBase}${staffLoc}/tools/staff/`;

    type NoteTone = 'muted' | 'warn' | 'error';
    function updateNote(override?: string, tone: NoteTone = 'muted') {
      const note = document.querySelector<HTMLElement>('[data-rounds-note]');
      if (!note) return;
      const root = document.querySelector<HTMLElement>('[data-rounds]');
      const configured = Boolean(root?.dataset.supabaseUrl && root?.dataset.supabaseKey);
      note.textContent = '';
      note.classList.remove(
        'text-ink-400',
        'text-amber-700',
        'dark:text-amber-300',
        'text-red-500',
      );
      const setTone = (t: NoteTone) => {
        if (t === 'error') note.classList.add('text-red-500');
        else if (t === 'warn') note.classList.add('text-amber-700', 'dark:text-amber-300');
        else note.classList.add('text-ink-400');
      };
      if (override) {
        note.textContent = override;
        setTone(tone);
        return;
      }
      setTone('muted');
      const n = careNotes();
      if (!configured) {
        note.textContent = n.resetsNightly;
        return;
      }
      if (hasStaffPin()) {
        note.textContent = n.sharedResets;
        return;
      }
      note.append(n.staffOnlyPre);
      const link = document.createElement('a');
      link.href = staffHref;
      link.className =
        'font-bold text-blush-600 underline decoration-dotted dark:text-blush-300';
      link.textContent = n.signIn;
      note.append(link);
      note.append(n.staffOnlyPost);
    }

    // Stateless: every paint reads the store fresh, so a day rollover always
    // shows the right state without threading a shared variable around.
    function paint() {
      const items = Array.from(
        document.querySelectorAll<HTMLButtonElement>('[data-check-item]'),
      );
      if (!items.length) return;
      const store = loadStore();
      // Only staff (a registrar PIN on the device) may tick items; everyone
      // else sees the shared list read-only. Without Supabase (dev builds)
      // there's no shared list, so local ticking stays enabled.
      const root = document.querySelector<HTMLElement>('[data-rounds]');
      const configured = Boolean(root?.dataset.supabaseUrl && root?.dataset.supabaseKey);
      const editable = !configured || hasStaffPin();
      items.forEach((btn) => {
        const checked = store.done.includes(btn.dataset.checkItem!);
        btn.disabled = !editable;
        btn.setAttribute('aria-pressed', String(checked));
        const box = btn.querySelector<HTMLElement>('[data-check-box]')!;
        const tick = box.querySelector('svg');
        const label = btn.querySelector<HTMLElement>('[data-check-label]')!;
        box.classList.toggle('bg-blush-600', checked);
        box.classList.toggle('border-blush-600', checked);
        tick?.classList.toggle('opacity-0', !checked);
        label.classList.toggle('line-through', checked);
        label.classList.toggle('opacity-60', checked);
      });
      const count = document.querySelector('[data-check-count]');
      if (count) count.textContent = `${store.done.length}/${items.length}`;
      const complete = store.done.length === items.length;
      const praise = document.querySelector('[data-check-praise]');
      praise?.classList.toggle('hidden', !complete);
      praise?.classList.toggle('flex', complete);
      praise?.classList.toggle('praise-pop', complete);
    }

    function setupChecklist() {
      const root = document.querySelector<HTMLElement>('[data-rounds]');
      const items = Array.from(
        document.querySelectorAll<HTMLButtonElement>('[data-check-item]'),
      );
      if (!items.length) return;
      const url = root?.dataset.supabaseUrl;
      const key = root?.dataset.supabaseKey;

      items.forEach((btn) => {
        if (btn.dataset.bound) return;
        btn.dataset.bound = '1';
        btn.addEventListener('click', async () => {
          if (btn.disabled || btn.dataset.pending === '1') return; // read-only / mid-write
          const store = loadStore(); // re-check the date on every tap
          const id = btn.dataset.checkItem!;
          const nowDone = !store.done.includes(id);
          store.done = nowDone
            ? [...store.done, id]
            : store.done.filter((d) => d !== id);
          saveStore(store.done); // optimistic
          paint();
          // sync to the shared store; the note explains a local-only fallback
          if (!url || !key) return;
          const pin = staffPin();
          if (!pin) {
            updateNote();
            return;
          }
          setItemPending(btn, true); // pulse the box while the write is in flight
          try {
            const { sbRpc } = await import('../lib/sb');
            await sbRpc(url, key, 'set_round', {
              p_date: careDayKey(),
              p_item: id,
              p_done: nowDone,
              p_pin: pin,
            });
            updateNote();
          } catch (err) {
            // keep the optimistic local state, but tell the staff why
            if (String(err).includes('wrong pin')) {
              forgetStaffPin();
              updateNote(careNotes().pinRejected, 'error');
            } else {
              updateNote(careNotes().savedLocal, 'warn');
            }
          } finally {
            setItemPending(btn, false);
          }
        });
      });

      pullRounds(); // owns the sync-state note (loading / normal / offline)
    }

    setupChecklist();
    document.addEventListener('astro:page-load', setupChecklist);
    // Re-pull the shared state on every return to the page so it never shows a
    // stale list: on refocus (incl. a rollover past midnight, or a sibling
    // device's change) and on back/forward-cache restores (pageshow).
    document.addEventListener('visibilitychange', () => {
      // Re-pull on refocus: a PIN may have been entered at the Staff room, a
      // sibling device may have ticked something, or the day may have rolled
      // over. pullRounds repaints and refreshes the note.
      if (document.visibilityState === 'visible') pullRounds();
    });
    window.addEventListener('pageshow', () => pullRounds());
  </script>
</Layout>
