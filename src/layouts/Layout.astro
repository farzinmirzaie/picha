---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}
const { title, description = 'Picha the cat — profile & daily care guide.' } =
  Astro.props;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ec7ba8" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <title>{title}</title>

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
  </head>
  <body
    class="min-h-screen bg-cream-100 text-slate-700 dark:bg-slate-950 dark:text-slate-200"
  >
    <div
      class="pointer-events-none fixed inset-0 -z-10 bg-[radial-gradient(60%_50%_at_50%_0%,var(--color-blush-100),transparent)] dark:bg-[radial-gradient(60%_50%_at_50%_0%,#3b1d2e,transparent)]"
    >
    </div>
    <slot />
  </body>
</html>
