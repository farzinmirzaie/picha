---
import '@fontsource-variable/fraunces';
import '@fontsource-variable/nunito';
import '../styles/global.css';
import { Icon } from 'astro-icon/components';
import { ClientRouter } from 'astro:transitions';
import Nav from '../components/Nav.astro';

interface Props {
  title: string;
  description?: string;
  /** Active tab id for the nav. */
  current: 'home' | 'health' | 'care' | 'tools';
}
const {
  title,
  description = 'Picha the cat: profile & daily care guide.',
  current,
} = Astro.props;

// BASE_URL is "/picha/" in production; join without doubling the slash.
const asset = (p: string) => `${import.meta.env.BASE_URL.replace(/\/$/, '')}/${p}`;
const ogImage = new URL(asset('icon-512.png'), Astro.site);

// Mobile app-bar label per tab.
const appTitle = { home: 'Picha', health: 'Health', care: 'Care', tools: 'Tools' }[
  current
];
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover"
    />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#faf3ec" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#171014" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/svg+xml" href={asset('favicon.svg')} />
    <link rel="sitemap" type="application/xml" href={asset('sitemap-index.xml')} />
    <!-- whole site as one markdown doc, for AI agents (llmstxt.org) -->
    <link
      rel="alternate"
      type="text/plain"
      href={asset('llms.txt')}
      title="llms.txt"
    />
    <title>{title}</title>

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImage} />

    <!-- PWA: installable on phone/desktop -->
    <link rel="manifest" href={asset('manifest.webmanifest')} />
    <link rel="apple-touch-icon" href={asset('apple-touch-icon.png')} />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="Picha" />

    <ClientRouter />
  </head>
  <body
    class="min-h-screen bg-paper-100 pb-20 font-sans text-ink-900 md:pb-0 dark:bg-plum-950 dark:text-paper-100"
  >
    <!-- ambient blush glow -->
    <div
      class="pointer-events-none fixed inset-0 -z-10 bg-[radial-gradient(70%_45%_at_50%_-5%,var(--color-blush-100),transparent)] dark:bg-[radial-gradient(70%_45%_at_50%_-5%,#3b1d2e,transparent)]"
    >
    </div>

    <!-- mobile: app bar -->
    <header
      class="sticky top-0 z-40 border-b border-paper-300/50 bg-paper-100/85 pt-[env(safe-area-inset-top)] backdrop-blur-md md:hidden dark:border-plum-800/60 dark:bg-plum-950/85"
    >
      <div class="flex h-14 items-center px-5">
        <span class="font-display text-lg font-semibold tracking-tight">
          {appTitle}
        </span>
        {
          current === 'home' && (
            <button
              type="button"
              data-share-open
              aria-label="Share her profile"
              class="-mr-2 ml-auto flex h-10 w-10 items-center justify-center rounded-full text-blush-600 transition-colors duration-200 active:bg-blush-100 dark:text-blush-300 dark:active:bg-plum-800"
            >
              <Icon name="ph:share-network" class="h-6 w-6" aria-hidden="true" />
            </button>
          )
        }
      </div>
    </header>

    <Nav current={current} />

    <main>
      <slot />
    </main>

    <script>
      import { ageLabel, inDaysLabel } from '../data/picha';

      // Everything here re-runs after ClientRouter page swaps (astro:page-load).
      function hydrate() {
        // Age computed against the visitor's date, never the build date.
        const label = ageLabel();
        document.querySelectorAll<HTMLElement>('[data-age]').forEach((el) => {
          el.textContent = label;
        });

        // Relative day-count for date-anchored notes.
        const today = new Date();
        today.setHours(0, 0, 0, 0);
        document.querySelectorAll<HTMLElement>('[data-until]').forEach((el) => {
          const raw = el.getAttribute('data-until');
          if (!raw) return;
          const days = Math.round(
            (new Date(raw).getTime() - today.getTime()) / 86_400_000,
          );
          el.textContent =
            days >= 0
              ? ` (${inDaysLabel(days)})`
              : ' (past the estimate, confirm with the vet)';
        });

        // Scroll-reveal: stagger via --reveal-delay set inline per element.
        const revealables = document.querySelectorAll<HTMLElement>('.reveal:not(.in)');
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
          revealables.forEach((el) => el.classList.add('in'));
          return;
        }
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                (e.target as HTMLElement).classList.add('in');
                io.unobserve(e.target);
              }
            });
          },
          { threshold: 0.15 },
        );
        revealables.forEach((el) => io.observe(el));
      }

      hydrate();
      document.addEventListener('astro:page-load', hydrate);

      // Haptic tick on interactive taps — native-app feel on Android
      // (navigator.vibrate is a no-op / absent on iOS, so this degrades safely).
      document.addEventListener(
        'pointerdown',
        (e) => {
          const el = e.target as Element | null;
          if (el?.closest('a, button')) navigator.vibrate?.(8);
        },
        { passive: true },
      );
    </script>

    <script>
      // Register the service worker (enables install + offline). Scope: /picha/.
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker
            .register(`${import.meta.env.BASE_URL.replace(/\/$/, '')}/sw.js`)
            .catch(() => {});
        });
      }
    </script>
  </body>
</html>
