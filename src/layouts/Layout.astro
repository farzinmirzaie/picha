---
import '@fontsource-variable/fraunces';
import '@fontsource-variable/nunito';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Nav from '../components/Nav.astro';
import LangPicker from '../components/LangPicker.astro';
import IconButton from '../components/ui/IconButton.astro';
import { t as tr } from '../i18n/ui';
import { supabaseClient } from '../data/supabase';
import { nextDueHealth } from '../lib/health';

// The soonest health due-date (build-time). The client reads this off the body
// and decides "due soon" against the visitor's own clock, so the Due soon card,
// the Health tab badge and the PWA app badge all go live (see the script).
const healthNextDue = nextDueHealth()?.item.date;

interface Props {
  title: string;
  description?: string;
  /** Active tab id for the nav ('none' highlights nothing, e.g. the 404). */
  current: 'home' | 'health' | 'care' | 'tools' | 'none';
  /** Mobile app-bar label override (sub-pages of a tab, e.g. "Weight"). */
  appTitle?: string;
}
const {
  title,
  description = 'Picha the cat: profile & daily care guide.',
  current,
  appTitle: appTitleProp,
} = Astro.props;

// BASE_URL is "/picha/" in production; join without doubling the slash.
const asset = (p: string) => `${import.meta.env.BASE_URL.replace(/\/$/, '')}/${p}`;
const ogImage = new URL(asset('icon-512.png'), Astro.site);
const ogUrl = new URL(Astro.url.pathname, Astro.site);

// Mobile app-bar label: the tab name (localized), unless the page names itself.
const locale = Astro.currentLocale ?? 'en';
const appTitle =
  appTitleProp ?? (current === 'home' || current === 'none' ? 'Picha' : tr(locale, `nav.${current}`));
---

<!doctype html>
<html lang={locale} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <!-- zoom intentionally disabled for a native PWA feel; viewport-fit=cover for the notch -->
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover"
    />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#faf3ec" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#171014" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/svg+xml" href={asset('favicon.svg')} />
    <link rel="sitemap" type="application/xml" href={asset('sitemap-index.xml')} />
    <!-- whole site as one markdown doc, for AI agents (llmstxt.org) -->
    <link
      rel="alternate"
      type="text/plain"
      href={asset('llms.txt')}
      title="llms.txt"
    />
    <title>{title}</title>

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={ogUrl} />
    <meta property="og:site_name" content="Picha" />
    <meta name="twitter:card" content="summary" />

    <!-- warm up the TLS handshake for the live-data fetches -->
    {supabaseClient && <link rel="preconnect" href={supabaseClient.url} crossorigin />}

    <!-- PWA: installable on phone/desktop -->
    <link rel="manifest" href={asset('manifest.webmanifest')} />
    <link rel="apple-touch-icon" href={asset('apple-touch-icon.png')} />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="Picha" />

    <ClientRouter />
  </head>
  <body
    class="min-h-screen bg-paper-100 pb-20 font-sans text-ink-900 md:pb-0 dark:bg-plum-950 dark:text-paper-100"
    data-health-next={healthNextDue}
  >
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:rounded-full focus:bg-blush-600 focus:px-4 focus:py-2 focus:text-sm focus:font-bold focus:text-white"
    >
      Skip to content
    </a>
    <!-- ambient blush glow -->
    <div
      class="pointer-events-none fixed inset-0 -z-10 bg-[radial-gradient(70%_45%_at_50%_-5%,var(--color-blush-100),transparent)] dark:bg-[radial-gradient(70%_45%_at_50%_-5%,#3b1d2e,transparent)]"
    >
    </div>

    <!-- mobile: app bar -->
    <header
      class="sticky top-0 z-40 border-b border-paper-300/50 bg-paper-100/85 pt-[env(safe-area-inset-top)] backdrop-blur-md md:hidden print:hidden dark:border-plum-800/60 dark:bg-plum-950/85"
    >
      <div class="flex h-14 items-center px-5">
        <span
          class="font-display truncate text-lg font-semibold tracking-tight text-blush-600 dark:text-blush-300"
        >
          {appTitle}
        </span>
        <div class="-mr-2 ml-auto flex items-center">
          <IconButton icon="ph:translate" label="Language" data-lang-open />
          <slot name="app-action" />
          {
            current === 'home' && (
              <IconButton icon="ph:share-network" label="Share her profile" data-share-open />
            )
          }
        </div>
      </div>
    </header>

    <Nav current={current} />

    <main id="main">
      <slot />
    </main>

    <LangPicker />

    <script>
      import { inDaysLabel } from '../lib/dates';
      import { t as tr } from '../i18n/ui';
      import { ageLabelI18n } from '../i18n/content';

      // Everything here re-runs after ClientRouter page swaps (astro:page-load).
      function hydrate() {
        const locale = document.documentElement.lang || 'en';
        // Age computed against the visitor's date, never the build date.
        const label = ageLabelI18n(locale);
        document.querySelectorAll<HTMLElement>('[data-age]').forEach((el) => {
          el.textContent = label;
        });

        // Relative day-count for date-anchored notes.
        const today = new Date();
        today.setHours(0, 0, 0, 0);
        document.querySelectorAll<HTMLElement>('[data-until]').forEach((el) => {
          const raw = el.getAttribute('data-until');
          if (!raw) return;
          const days = Math.round(
            (new Date(raw).getTime() - today.getTime()) / 86_400_000,
          );
          // Countdowns only for near events; far-off dates speak for themselves.
          el.textContent =
            days > 60
              ? ''
              : days >= 0
                ? ` (${inDaysLabel(days, locale)})`
                : el.dataset.overdue
                  ? ` (${el.dataset.overdue})`
                  : ` (${tr(locale, 'date.confirmVet')})`;
        });

        // Scroll-reveal: elements arriving in the same intersection batch get
        // a short relative stagger (capped), so fast scrolling never waits on
        // long fixed per-item delays.
        const revealables = document.querySelectorAll<HTMLElement>('.reveal:not(.in)');
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
          revealables.forEach((el) => el.classList.add('in'));
          return;
        }
        const io = new IntersectionObserver(
          (entries) => {
            entries
              .filter((e) => e.isIntersecting)
              .forEach((e, i) => {
                const el = e.target as HTMLElement;
                const delay = Math.min(i * 60, 240);
                el.style.transitionDelay = `${delay}ms`;
                el.classList.add('in');
                io.unobserve(el);
                // once revealed, hand transitions back to the element's own
                // utilities (hover lifts etc. must not inherit reveal timing)
                setTimeout(() => {
                  el.classList.remove('reveal', 'in');
                  el.style.transitionDelay = '';
                }, delay + 650);
              });
          },
          { threshold: 0.15 },
        );
        revealables.forEach((el) => io.observe(el));
      }

      // "Due soon" is decided here, on the client, against the visitor's own
      // clock — so the Due soon card, the Health tab badge and the PWA app-icon
      // badge flip live (even across midnight, on refocus) without waiting for
      // a rebuild. The soonest due-date is stamped on <body data-health-next> at
      // build time; only the date is server-rendered, the threshold is client.
      const DUE_SOON_DAYS = 2; // within 2 days, or overdue (negative)
      function applyDueSoon() {
        const iso = document.body.dataset.healthNext;
        let due = false;
        if (iso) {
          const today = new Date();
          today.setHours(0, 0, 0, 0);
          const days = Math.round((new Date(iso).getTime() - today.getTime()) / 86_400_000);
          due = days <= DUE_SOON_DAYS;
        }
        // Health tab badge (dot + sr-only text, desktop + mobile)
        document
          .querySelectorAll<HTMLElement>('[data-health-badge]')
          .forEach((el) => el.classList.toggle('hidden', !due));
        // Health page "Due soon" card (present only on /health/). It can't use
        // `.reveal` in markup (the scroll observer never fires for an
        // initially-hidden element), so play the matching fade-up KEYFRAME when
        // it (re)appears — a keyframe fires reliably on class-add even right
        // after un-hiding, where a transition often wouldn't.
        const card = document.querySelector<HTMLElement>('[data-due-soon]');
        if (card) {
          const wasHidden = card.hidden;
          card.hidden = !due;
          if (due && (wasHidden || !card.dataset.shown)) {
            card.dataset.shown = '1';
            card.classList.remove('fade-up-in');
            void card.offsetWidth; // restart the animation on re-show
            card.classList.add('fade-up-in');
          } else if (!due) {
            delete card.dataset.shown;
          }
        }
        // PWA app-icon badge (Badging API; installed apps only, no-op elsewhere)
        const nav = navigator as Navigator & {
          setAppBadge?: (n?: number) => Promise<void>;
          clearAppBadge?: () => Promise<void>;
        };
        if (nav.setAppBadge) {
          if (due) nav.setAppBadge().catch(() => {});
          else nav.clearAppBadge?.().catch(() => {});
        }
      }

      hydrate();
      applyDueSoon();
      document.addEventListener('astro:page-load', () => {
        hydrate();
        applyDueSoon();
      });
      // Re-evaluate when the tab/app returns to the foreground (e.g. across
      // midnight, or after the app was backgrounded).
      document.addEventListener('visibilitychange', () => {
        if (document.visibilityState === 'visible') applyDueSoon();
      });

      // Haptic tick on a completed tap — fires on touch RELEASE (not press),
      // touch pointers only, and only when the finger barely moved (so
      // scrolling and swipes never buzz). One global handler, so every
      // interactive control behaves the same. navigator.vibrate is a no-op /
      // absent on iOS, so this degrades safely.
      const TAP = 'a, button, summary';
      let tapStart: { x: number; y: number; el: Element | null } | null = null;
      document.addEventListener(
        'pointerdown',
        (e) => {
          if (e.pointerType !== 'touch') return;
          tapStart = { x: e.clientX, y: e.clientY, el: (e.target as Element)?.closest(TAP) };
        },
        { passive: true },
      );
      document.addEventListener(
        'pointerup',
        (e) => {
          if (e.pointerType !== 'touch' || !tapStart) return;
          const { x, y, el } = tapStart;
          tapStart = null;
          if (!el || Math.hypot(e.clientX - x, e.clientY - y) > 10) return;
          // release must land on the same control the press started on
          if ((e.target as Element)?.closest(TAP) === el) navigator.vibrate?.(8);
        },
        { passive: true },
      );
    </script>

    <script>
      // Register the service worker (enables install + offline). Scope: /picha/.
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker
            .register(`${import.meta.env.BASE_URL.replace(/\/$/, '')}/sw.js`)
            .catch(() => {});
        });
      }
    </script>
  </body>
</html>
