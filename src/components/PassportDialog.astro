---
/**
 * The pet-passport dialog. Include once per page; any element on that page
 * with `data-passport-open` will open it (the Tools "in service" row).
 */
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import SheetHeader from './ui/SheetHeader.astro';
import pichaPhoto from '../assets/picha.jpg';
import { identity, microchip, microchipRegistry } from '../data/picha';
import { getPassportCopy } from '../i18n/content';

const c = getPassportCopy(Astro.currentLocale);

// Layout modelled on the official pet passport: dotted fields, pen-blue values.
const particulars = [
  { label: c.labels.name, value: identity.name },
  { label: c.labels.species, value: c.species },
  { label: c.labels.breed, value: identity.breed },
  { label: c.labels.sex, value: c.sexFemale },
  { label: c.labels.neutered, value: c.yes },
  { label: c.labels.colour, value: identity.colour },
  { label: c.labels.dob, value: identity.bornLabel },
  { label: c.labels.passportNo, value: c.pending },
];
---

<!-- A physical document, so it stays cream in dark mode -->
<dialog id="passport" class="sheet" aria-labelledby="passport-title">
  <div class="rounded-2xl bg-[#fbf7ef] text-[#3a3a3a] shadow-2xl max-md:rounded-b-none max-md:pb-[env(safe-area-inset-bottom)]">
    <!-- cover strip (stays fixed while the document scrolls) -->
    <SheetHeader title={c.sheetTitle} titleId="passport-title" closeLabel={c.closeLabel} />

    <div class="grid sm:grid-cols-2">
      <!-- left page: particulars -->
      <div class="border-b border-dashed border-[#d8cfc0] p-5 sm:border-r sm:border-b-0 sm:p-6">
        <h3 class="text-[10px] font-bold tracking-[0.18em] uppercase">
          {c.particularsHeading}
        </h3>
        <dl class="mt-4 space-y-3.5">
          {
            particulars.map((f) => (
              <div class="grid grid-cols-[6.5rem_1fr] items-end gap-2 sm:grid-cols-[7.5rem_1fr]">
                <dt class="text-[10px] leading-tight font-bold">{f.label}</dt>
                <dd class="pen border-b border-dotted border-[#b9ad99] pb-0.5 text-[11px] sm:text-xs">
                  {f.value}
                </dd>
              </div>
            ))
          }
        </dl>
        <!-- registrar stamp -->
        <div
          class="mt-6 w-fit -rotate-3 rounded-lg border-2 border-blush-400/70 px-3 py-2 text-center text-[9px] font-bold tracking-[0.14em] text-blush-500/90 uppercase"
          aria-hidden="true"
        >
          <span class="inline-flex items-center gap-1">
            <Icon name="ph:paw-print" class="h-3 w-3" /> {c.household}
          </span><br />
          <span class="font-normal normal-case italic tracking-normal"
            >{c.signature}</span
          >
        </div>
      </div>

      <!-- right page: identity -->
      <div class="p-5 sm:p-6">
        <h3 class="text-[10px] font-bold tracking-[0.18em] uppercase">
          {c.identityHeading}
        </h3>

        <div class="mt-4">
          <p class="text-[10px] font-bold">{c.microchipNo}</p>
          <div class="mt-1.5 rounded-md border border-[#d8cfc0] bg-white px-3 py-2">
            <div class="barcode h-9 w-full" aria-hidden="true"></div>
            <p class="select-text mt-1 text-center font-mono text-xs tracking-[0.28em]">
              {microchip}
            </p>
          </div>
        </div>

        <div class="mt-4 grid grid-cols-[6.5rem_1fr] items-end gap-2 sm:grid-cols-[7.5rem_1fr]">
          <p class="text-[10px] leading-tight font-bold">{c.siteOfImplant}</p>
          <p class="pen border-b border-dotted border-[#b9ad99] pb-0.5 text-[11px] sm:text-xs">
            {c.betweenShoulders}
          </p>
          <p class="text-[10px] leading-tight font-bold">{c.registeredAt}</p>
          <a
            href={microchipRegistry.url}
            target="_blank"
            rel="noopener"
            class="pen border-b border-dotted border-[#b9ad99] pb-0.5 text-[11px] underline sm:text-xs"
          >
            {microchipRegistry.name}
          </a>
        </div>

        <div class="mt-5">
          <p class="text-center text-[10px] font-bold">{c.petPhoto}</p>
          <div
            class="mx-auto mt-2 w-40 rotate-1 border-4 border-white shadow-md sm:w-44"
          >
            <Image
              src={pichaPhoto}
              alt="Passport photo of Picha"
              width={352}
              densities={[1, 2]}
              class="aspect-square h-auto w-full object-cover"
              style="object-position: 50% 20%"
            />
          </div>
        </div>
      </div>
    </div>
  </div>
</dialog>

<script>
  import { bindDialog } from '../lib/dialog';

  function setupPassport() {
    const dialog = document.getElementById('passport') as HTMLDialogElement | null;
    if (!dialog) return;
    document.querySelectorAll<HTMLElement>('[data-passport-open]').forEach((btn) => {
      if (btn.dataset.bound) return;
      btn.dataset.bound = '1';
      btn.addEventListener('click', () => dialog.showModal());
    });
    bindDialog(dialog);
  }
  setupPassport();
  document.addEventListener('astro:page-load', setupPassport);
</script>
