---
/** A titled content section with a consistent heading + optional lead line. */
interface Props {
  id: string;
  icon: string;
  title: string;
  lead?: string;
  /** Accent tint for the heading strip. */
  tone?: 'blush' | 'amber' | 'slate';
}
const { id, icon, title, lead, tone = 'blush' } = Astro.props;

const toneClass = {
  blush: 'text-blush-600 dark:text-blush-300',
  amber: 'text-amber-600 dark:text-amber-glow',
  slate: 'text-slate-600 dark:text-slate-300',
}[tone];
---

<section id={id} class="mx-auto w-full max-w-4xl scroll-mt-8 px-5 py-8">
  <div class="mb-5 flex items-center gap-3">
    <span class="text-2xl" aria-hidden="true">{icon}</span>
    <h2 class={`text-xl font-extrabold tracking-tight sm:text-2xl ${toneClass}`}>
      {title}
    </h2>
  </div>
  {lead && <p class="mb-5 max-w-2xl text-slate-500 dark:text-slate-400">{lead}</p>}
  <slot />
</section>
