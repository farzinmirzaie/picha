---
/**
 * App navigation: pill bar on desktop, fixed bottom tab bar on mobile
 * (app-like — matches the installed PWA feel). To add a future tool page,
 * append one entry to TABS and give the page `current={id}`.
 */
import { Icon } from 'astro-icon/components';
import { isHealthDueSoon } from '../lib/health';
import { t as tr } from '../i18n/ui';

interface Props {
  current: string;
}
const { current } = Astro.props;
const locale = Astro.currentLocale ?? 'en';

// The Health tab shows a dot when a health item is due soon / overdue. The dot
// is always rendered (with `data-health-badge`); its initial visibility is the
// build-time signal, and Layout's client script toggles it live against the
// visitor's clock — same decision that drives the Due soon card + app badge.
const healthDueSoon = isHealthDueSoon();

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// Locale-prefixed base: English at root, other locales under /<code>/.
const lb = locale === 'en' ? base : `${base}/${locale}`;
// The active tab renders the -fill variant of its icon (native tab-bar feel).
const TABS = [
  { id: 'home', href: `${lb}/`, icon: 'ph:paw-print', label: 'Home' },
  { id: 'health', href: `${lb}/health/`, icon: 'ph:heartbeat', label: 'Health' },
  { id: 'care', href: `${lb}/care/`, icon: 'ph:hand-heart', label: 'Care' },
  { id: 'tools', href: `${lb}/tools/`, icon: 'ph:toolbox', label: 'Tools' },
].map((t) => ({ ...t, iconActive: `${t.icon}-fill` }));
---

<!-- desktop: floating pill under the top edge -->
<nav
  class="sticky top-4 z-40 mx-auto mt-4 hidden w-fit items-center gap-1 rounded-full border border-paper-300/60 bg-paper-50/80 p-1.5 shadow-sm backdrop-blur-md md:flex print:hidden dark:border-plum-700/60 dark:bg-plum-900/80"
  aria-label="Main"
>
  {
    TABS.map((t) => (
      <a
        href={t.href}
        data-astro-prefetch
        aria-current={current === t.id ? 'page' : undefined}
        class:list={[
          'flex items-center gap-1.5 rounded-full px-4 py-1.5 text-sm font-bold transition-colors duration-200',
          current === t.id
            ? 'bg-blush-600 text-white shadow-sm'
            : 'text-ink-600 hover:bg-blush-100 hover:text-blush-700 dark:text-ink-400 dark:hover:bg-plum-800 dark:hover:text-blush-300',
        ]}
      >
        <span class="relative flex">
          <Icon
            name={current === t.id ? t.iconActive : t.icon}
            class="h-4 w-4"
            aria-hidden="true"
          />
          {t.id === 'health' && (
            <span
              data-health-badge
              class:list={[
                'absolute -top-1 -right-1.5 h-2 w-2 rounded-full bg-amber-500 ring-2 ring-paper-50 dark:ring-plum-900',
                healthDueSoon ? '' : 'hidden',
              ]}
              aria-hidden="true"
            />
          )}
        </span>
        <span>{tr(locale, `nav.${t.id}`)}</span>
        {t.id === 'health' && (
          <span data-health-badge class:list={['sr-only', healthDueSoon ? '' : 'hidden']}>
            , item due soon
          </span>
        )}
      </a>
    ))
  }
  <span class="mx-0.5 h-5 w-px bg-paper-300/70 dark:bg-plum-700" aria-hidden="true"></span>
  <button
    type="button"
    data-lang-open
    aria-label="Language"
    class="flex items-center justify-center rounded-full px-3 py-1.5 text-ink-600 transition-colors hover:bg-blush-100 hover:text-blush-700 dark:text-ink-400 dark:hover:bg-plum-800 dark:hover:text-blush-300"
  >
    <Icon name="ph:translate" class="h-4 w-4" aria-hidden="true" />
  </button>
</nav>

<!-- mobile: bottom tab bar -->
<nav
  class="fixed inset-x-0 bottom-0 z-40 border-t border-paper-300/60 bg-paper-50/85 pb-[env(safe-area-inset-bottom)] backdrop-blur-md md:hidden print:hidden dark:border-plum-700/60 dark:bg-plum-900/85"
  aria-label="Main"
>
  <div class="mx-auto grid max-w-md grid-cols-4">
    {
      TABS.map((t) => (
        <a
          href={t.href}
          data-astro-prefetch
          aria-current={current === t.id ? 'page' : undefined}
          class:list={[
            'flex flex-col items-center gap-0.5 py-2.5 text-[11px] font-bold transition-colors duration-200',
            current === t.id
              ? 'text-blush-600 dark:text-blush-300'
              : 'text-ink-400 active:text-blush-500',
          ]}
        >
          <span
            class:list={[
              'relative flex h-8 w-14 items-center justify-center rounded-full transition-all duration-300',
              current === t.id ? 'bg-blush-100 dark:bg-plum-800' : '',
            ]}
          >
            <Icon
              name={current === t.id ? t.iconActive : t.icon}
              class="h-5 w-5"
              aria-hidden="true"
            />
            {t.id === 'health' && (
              <span
                data-health-badge
                class:list={[
                  'absolute top-1 right-3.5 h-2 w-2 rounded-full bg-amber-500 ring-2 ring-paper-50 dark:ring-plum-900',
                  healthDueSoon ? '' : 'hidden',
                ]}
                aria-hidden="true"
              />
            )}
          </span>
          <span>{tr(locale, `nav.${t.id}`)}</span>
          {t.id === 'health' && (
            <span data-health-badge class:list={['sr-only', healthDueSoon ? '' : 'hidden']}>
              , item due soon
            </span>
          )}
        </a>
      ))
    }
  </div>
</nav>
