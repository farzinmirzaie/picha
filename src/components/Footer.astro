---
/**
 * Desktop footer. Hidden on mobile (the app bar + tab bar carry the chrome
 * there) — pass `showOnMobile` where a page should keep it (Tools).
 */
import { Icon } from 'astro-icon/components';

interface Props {
  showOnMobile?: boolean;
}
const { showOnMobile = false } = Astro.props;
---

<footer
  class:list={[
    'mx-auto w-full max-w-2xl px-5 pt-6 pb-8 text-center md:pb-14',
    showOnMobile ? '' : 'hidden md:block',
  ]}
>
  <div
    class="mx-auto mb-4 flex items-center justify-center gap-2.5 text-blush-300 dark:text-plum-700"
    aria-hidden="true"
  >
    <span class="h-px w-16 bg-current opacity-50"></span>
    <Icon name="ph:paw-print" class="h-4 w-4" />
    <span class="h-px w-16 bg-current opacity-50"></span>
  </div>
  <p class="text-xs text-ink-400">
    Built by the staff, under close supervision — approved with a slow blink.
  </p>
</footer>
