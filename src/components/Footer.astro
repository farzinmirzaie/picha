---
import { identity, contact } from '../data/picha';
---

<footer class="mx-auto w-full max-w-2xl px-5 pt-6 pb-14 text-center">
  <div class="mx-auto mb-5 flex items-center justify-center gap-2 text-blush-300 dark:text-plum-700" aria-hidden="true">
    <span class="h-px w-16 bg-current opacity-50"></span>
    <span class="text-base">🐾</span>
    <span class="h-px w-16 bg-current opacity-50"></span>
  </div>
  <p class="text-sm text-ink-600 dark:text-ink-400">
    {identity.name} is staffed by {contact.ownersLabel}. If found, please call
    her people:
  </p>
  <p class="mt-1.5 flex flex-wrap items-center justify-center gap-x-4 gap-y-1 text-sm">
    {
      contact.owners.map((o) => (
        <a
          href={`tel:${o.phone.replace(/\s/g, '')}`}
          class="link-slide font-bold text-blush-600 dark:text-blush-300"
        >
          {o.name} · {o.phone}
        </a>
      ))
    }
  </p>
  <p class="mt-3 text-xs text-ink-400">
    Made with 💕 (and a great many treats) for {identity.name}
  </p>
</footer>
