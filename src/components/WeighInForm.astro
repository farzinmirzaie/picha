---
/**
 * The weigh-in entry form (PIN-gated via the log_weight RPC). Rendered twice
 * on the weight page — desktop accordion + mobile dialog — so it carries no
 * ids; the page script binds every [data-weight-form] instance.
 * `flush`: drop the card chrome (border/bg/padding) when a container already
 * provides it, e.g. inside the mobile bottom sheet.
 */
import { Icon } from 'astro-icon/components';
import { supabaseClient } from '../data/supabase';

interface Props {
  flush?: boolean;
}
const { flush = false } = Astro.props;
---

<form
  data-weight-form
  autocomplete="off"
  data-supabase-url={supabaseClient?.url}
  data-supabase-key={supabaseClient?.key}
  class:list={[
    flush ||
      'rounded-3xl border border-blush-200/70 bg-paper-50 p-5 sm:p-6 dark:border-plum-700 dark:bg-plum-900',
  ]}
>
  <!-- 2×2 on every screen: date | weight, then PIN | submit -->
  <div class="grid grid-cols-2 gap-3">
    <label class="block">
      <span class="text-[10px] font-bold tracking-[0.14em] text-ink-400 uppercase">
        Date
      </span>
      <input
        type="date"
        name="date"
        required
        class="mt-1 w-full rounded-xl border border-blush-200/70 bg-paper-100 px-3 py-2 text-sm font-bold outline-none focus:border-blush-400 dark:border-plum-700 dark:bg-plum-950"
      />
    </label>
    <label class="block">
      <span class="text-[10px] font-bold tracking-[0.14em] text-ink-400 uppercase">
        Weight (kg)
      </span>
      <input
        type="number"
        name="kg"
        required
        step="0.01"
        min="0.5"
        max="15"
        inputmode="decimal"
        placeholder="2.75"
        class="mt-1 w-full rounded-xl border border-blush-200/70 bg-paper-100 px-3 py-2 text-sm font-bold outline-none focus:border-blush-400 dark:border-plum-700 dark:bg-plum-950"
      />
    </label>
    <label class="block">
      <span class="text-[10px] font-bold tracking-[0.14em] text-ink-400 uppercase">
        Registrar PIN
      </span>
      <input
        type="password"
        name="pin"
        required
        autocomplete="off"
        inputmode="numeric"
        enterkeyhint="done"
        placeholder="staff only"
        class="mt-1 w-full rounded-xl border border-blush-200/70 bg-paper-100 px-3 py-2 text-sm font-bold outline-none focus:border-blush-400 dark:border-plum-700 dark:bg-plum-950"
      />
    </label>
    <div class="flex items-end">
      <button
        type="submit"
        class="inline-flex w-full items-center justify-center gap-2 rounded-xl bg-blush-600 px-4 py-2 text-sm font-bold text-white shadow-sm transition-all duration-200 hover:-translate-y-0.5 hover:bg-blush-700 hover:shadow-md active:translate-y-0 disabled:opacity-50"
      >
        <Icon name="ph:scales" class="h-4.5 w-4.5" aria-hidden="true" />
        Record audit
      </button>
    </div>
  </div>
  <p class="mt-3 min-h-4 text-xs font-bold text-ink-400" data-form-status aria-live="polite">
  </p>
  <p class="mt-3 text-[11px] leading-relaxed text-ink-400">
    Staff only: entries need the registrar's PIN (it is remembered on this
    device after the first successful audit). Same-date entries update the
    existing row.
  </p>
</form>
