---
/**
 * The weigh-in entry form (PIN-gated via the log_weight RPC). Rendered twice
 * on the weight page — desktop accordion + mobile dialog — so it carries no
 * ids; the page script binds every [data-weight-form] instance.
 * `flush`: drop the card chrome (border/bg/padding) when a container already
 * provides it, e.g. inside the mobile bottom sheet.
 */
import Button from './ui/Button.astro';
import { supabaseClient } from '../data/supabase';

interface Props {
  flush?: boolean;
}
const { flush = false } = Astro.props;
---

<form
  data-weight-form
  autocomplete="off"
  data-supabase-url={supabaseClient?.url}
  data-supabase-key={supabaseClient?.key}
  class:list={[
    flush ||
      'rounded-3xl border border-blush-200/70 bg-paper-50 p-5 sm:p-6 dark:border-plum-700 dark:bg-plum-900',
  ]}
>
  <!-- date | weight, then a full-width submit. No PIN field: the form only
       renders for a signed-in staff device (PIN set in the Staff room). -->
  <div class="grid grid-cols-2 gap-3">
    <label class="block">
      <span class="text-[10px] font-bold tracking-[0.14em] text-ink-400 uppercase">
        Date
      </span>
      <input
        type="date"
        name="date"
        required
        class="mt-1 w-full rounded-xl border border-blush-200/70 bg-paper-100 py-2 pr-9 pl-3 text-sm font-bold outline-none focus:border-blush-400 dark:border-plum-700 dark:bg-plum-950"
      />
    </label>
    <label class="block">
      <span class="text-[10px] font-bold tracking-[0.14em] text-ink-400 uppercase">
        Weight (kg)
      </span>
      <input
        type="number"
        name="kg"
        required
        step="0.01"
        min="0.5"
        max="15"
        inputmode="decimal"
        enterkeyhint="done"
        placeholder="2.75"
        class="mt-1 w-full rounded-xl border border-blush-200/70 bg-paper-100 px-3 py-2 text-sm font-bold outline-none focus:border-blush-400 dark:border-plum-700 dark:bg-plum-950"
      />
    </label>
  </div>
  <Button block type="submit" icon="ph:scales" class="mt-3">Record audit</Button>
  <p class="mt-3 min-h-4 text-xs font-bold text-ink-400" data-form-status aria-live="polite">
  </p>
  <p class="mt-3 text-[11px] leading-relaxed text-ink-400">
    Same-date entries update the existing row.
  </p>
</form>
