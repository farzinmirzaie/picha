---
/**
 * The measurement map: a side-profile cat with each dimension drawn where it is
 * actually taken (spine line, girth rings, front-leg line), each pinned to a
 * value chip. The chips reuse the [data-dim]/[data-dim-value] hooks, so the page
 * script's live re-fetch + cm/inch toggle update them exactly like the list.
 * A "royal tailor's" chart, zero JS of its own.
 */
import { measurementDims } from '../data/picha';
import { currentMeasurements } from '../data/measurements';
import { getMeasureCopy } from '../i18n/content';

const c = getMeasureCopy(Astro.currentLocale);
const cur = currentMeasurements;

// Chip anchor per dimension, as % of the figure box (viewBox 460 x 345; the
// drawing is shifted 20 left to leave room for the leg chip on phones).
// Keep in sync with the leader-line end points in the SVG below.
const LAYOUT: Record<string, { lx: number; ly: number }> = {
  back: { lx: 40.9, ly: 13.9 },
  chest: { lx: 47.8, ly: 92.2 },
  neck: { lx: 71.7, ly: 92.2 },
  belly: { lx: 21.7, ly: 92.2 },
  leg: { lx: 87, ly: 69.3 },
};
---

<figure class="relative mx-auto w-full" aria-label={c.cardLabel}>
  <svg viewBox="0 0 460 345" class="h-auto w-full" role="presentation">
    <g transform="translate(-20 0)">
    <!-- silhouette: a flat "shadow" of a cat standing side-on, one tone -->
    <g class="fill-blush-200 dark:fill-plum-700">
      <!-- tail -->
      <path
        d="M118 142 C78 142 56 112 60 82 C62 60 76 48 92 52"
        class="fill-none stroke-blush-200 dark:stroke-plum-700"
        stroke-width="15"
        stroke-linecap="round"></path>
      <!-- far-side legs + far ear (peek through the gaps) -->
      <path
        d="M298 198 C304 222 306 248 306 264 C306 270 310 273 314 274 L292 274 C290 262 290 240 288 208 Z"
      ></path>
      <path
        d="M216 198 C220 214 210 230 200 242 C195 250 195 262 198 268 C201 272 206 273 208 274 L186 274 C184 266 184 256 184 248 C186 236 196 220 202 202 Z"
      ></path>
      <path d="M316 106 L322 74 Q324 68 328 72 L340 94 Z"></path>
      <!-- near side: one outline, nose to tail -->
      <path
        d="M118 134 C160 121 240 138 292 128 C306 122 316 112 324 104 C328 98 331 93 334 89 L344 60 Q347 53 351 59 L364 83 C376 82 387 90 392 100 C396 106 402 110 406 116 C406 122 400 126 394 128 C392 134 384 138 376 138 C364 140 352 144 346 150 C350 166 354 180 344 198 C340 212 340 240 340 262 C340 268 346 271 350 273 L350 274 L324 274 C322 268 322 262 322 256 C322 236 320 214 312 204 C290 208 245 210 212 200 C203 200 199 206 198 213 C196 225 183 235 176 243 C173 251 174 263 177 269 C179 272 184 273 186 274 L163 274 C161 266 161 254 160 246 C158 240 154 236 150 230 C138 219 114 206 109 182 C105 160 108 141 118 134 Z"
      ></path>
    </g>

    <!-- ground -->
    <line
      x1="40"
      y1="276"
      x2="420"
      y2="276"
      class="stroke-blush-200 dark:stroke-plum-700"
      stroke-width="3"
      stroke-dasharray="2 8"
      stroke-linecap="round"></line>

    <!-- length guides: back (neck base to tail base) + front leg, with end ticks -->
    <g
      class="stroke-blush-400 dark:stroke-blush-300"
      stroke-width="2.5"
      fill="none"
      stroke-linecap="round"
    >
      <line x1="122" y1="120" x2="294" y2="114"></line>
      <line x1="122" y1="113" x2="122" y2="128"></line>
      <line x1="294" y1="107" x2="294" y2="122"></line>
      <line x1="360" y1="204" x2="360" y2="274"></line>
      <line x1="354" y1="204" x2="366" y2="204"></line>
      <line x1="354" y1="274" x2="366" y2="274"></line>
    </g>

    <!-- girth guides: neck (tilted with the neck), chest, belly rings -->
    <g class="stroke-blush-400 dark:stroke-blush-300" stroke-width="2.5" fill="none" stroke-dasharray="4 5">
      <ellipse cx="333" cy="128" rx="8" ry="24" transform="rotate(-33 333 128)"></ellipse>
      <ellipse cx="300" cy="167" rx="15" ry="42"></ellipse>
      <ellipse cx="228" cy="167" rx="14" ry="38"></ellipse>
    </g>

    <!-- leaders from each guide to its chip -->
    <g class="stroke-blush-300 dark:stroke-blush-500" stroke-width="1.4" stroke-dasharray="2 4">
      <line x1="208" y1="117" x2="208" y2="62"></line>
      <line x1="300" y1="209" x2="240" y2="304"></line>
      <line x1="346" y1="148" x2="350" y2="304"></line>
      <line x1="228" y1="205" x2="120" y2="304"></line>
      <line x1="360" y1="239" x2="420" y2="239"></line>
    </g>
    <g class="fill-blush-400 dark:fill-blush-300">
      <circle cx="208" cy="117" r="3"></circle>
      <circle cx="300" cy="209" r="3"></circle>
      <circle cx="346" cy="148" r="3"></circle>
      <circle cx="228" cy="205" r="3"></circle>
      <circle cx="360" cy="239" r="3"></circle>
    </g>
    </g>
  </svg>

  <!-- value chips (HTML overlay, positioned by % of the figure) -->
  {
    measurementDims.map((d) => {
      const v = cur[d.id];
      const pos = LAYOUT[d.id];
      return (
        <div
          class="absolute -translate-x-1/2 -translate-y-1/2"
          style={`left:${pos.lx}%;top:${pos.ly}%`}
          data-dim={d.id}
        >
          <span class="inline-flex flex-col items-center rounded-full border border-blush-200/80 bg-paper-50/95 px-2.5 py-1 shadow-sm dark:border-plum-700 dark:bg-plum-900/95">
            <span class="text-[9px] font-extrabold tracking-[0.08em] text-blush-500 uppercase dark:text-blush-300">
              {c.dims[d.id].short}
            </span>
            <span
              class="font-display text-[13px] leading-none font-semibold whitespace-nowrap text-ink-900 dark:text-paper-100"
              data-dim-value
              {...(v ? { 'data-cm': v.cm } : {})}
            >
              {v ? `${v.cm} ${c.unit}` : '—'}
            </span>
          </span>
        </div>
      );
    })
  }
</figure>
