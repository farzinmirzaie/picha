---
/**
 * The measurement map: a side-profile cat with each dimension drawn where it is
 * actually taken (spine line, girth rings, front-leg line), each pinned to a
 * value chip. The chips reuse the [data-dim]/[data-dim-value] hooks, so the page
 * script's live re-fetch + cm/inch toggle update them exactly like the list.
 * A "royal tailor's" chart, zero JS of its own.
 */
import { measurementDims } from '../data/picha';
import { currentMeasurements } from '../data/measurements';
import { getMeasureCopy } from '../i18n/content';

const c = getMeasureCopy(Astro.currentLocale);
const cur = currentMeasurements;

// Chip anchor per dimension, as % of the figure box (viewBox 460 x 330).
const LAYOUT: Record<string, { lx: number; ly: number }> = {
  back: { lx: 50, ly: 15.2 },
  chest: { lx: 54.3, ly: 92 },
  neck: { lx: 77.4, ly: 92 },
  belly: { lx: 26, ly: 92 },
  leg: { lx: 86, ly: 64.8 },
};
---

<figure class="relative mx-auto w-full" aria-label={c.cardLabel}>
  <svg viewBox="0 0 460 330" class="h-auto w-full" role="presentation">
    <!-- silhouette -->
    <g class="fill-blush-200 dark:fill-plum-700">
      <path
        d="M70 185 C20 185 10 125 30 95 C40 77 60 75 64 91 C56 113 60 155 86 165 Z"
        class="fill-none stroke-blush-200 dark:stroke-plum-700"
        stroke-width="26"
        stroke-linecap="round"></path>
      <circle cx="120" cy="175" r="72"></circle>
      <ellipse cx="215" cy="170" rx="130" ry="60"></ellipse>
      <circle cx="315" cy="175" r="58"></circle>
      <polygon points="300,125 360,115 360,190 300,190"></polygon>
      <circle cx="360" cy="117" r="46"></circle>
      <polygon points="326,91 330,45 360,79"></polygon>
      <polygon points="360,79 392,47 396,93"></polygon>
      <rect x="300" y="205" width="22" height="54" rx="11"></rect>
      <rect x="328" y="207" width="22" height="52" rx="11"></rect>
      <rect x="118" y="210" width="26" height="49" rx="13"></rect>
      <rect x="150" y="213" width="24" height="46" rx="12"></rect>
    </g>

    <!-- ground -->
    <line
      x1="40"
      y1="261"
      x2="420"
      y2="261"
      class="stroke-blush-200 dark:stroke-plum-700"
      stroke-width="3"
      stroke-dasharray="2 8"
      stroke-linecap="round"></line>

    <!-- length guides: back (spine) + front leg, with end ticks -->
    <g
      class="stroke-blush-400 dark:stroke-blush-300"
      stroke-width="2.5"
      fill="none"
      stroke-linecap="round"
    >
      <line x1="112" y1="96" x2="300" y2="104"></line>
      <line x1="112" y1="90" x2="112" y2="108"></line>
      <line x1="300" y1="98" x2="300" y2="116"></line>
      <line x1="356" y1="207" x2="356" y2="257"></line>
      <line x1="350" y1="207" x2="362" y2="207"></line>
      <line x1="350" y1="257" x2="362" y2="257"></line>
    </g>

    <!-- girth guides: neck, chest, belly rings -->
    <g class="stroke-blush-400 dark:stroke-blush-300" stroke-width="2.5" fill="none" stroke-dasharray="4 5">
      <ellipse cx="312" cy="134" rx="14" ry="37"></ellipse>
      <ellipse cx="280" cy="176" rx="22" ry="58"></ellipse>
      <ellipse cx="180" cy="178" rx="26" ry="58"></ellipse>
    </g>

    <!-- leaders from each guide to its chip -->
    <g class="stroke-blush-300 dark:stroke-blush-500" stroke-width="1.4" stroke-dasharray="2 4">
      <line x1="206" y1="100" x2="230" y2="60"></line>
      <line x1="280" y1="234" x2="250" y2="300"></line>
      <line x1="312" y1="171" x2="356" y2="300"></line>
      <line x1="180" y1="236" x2="120" y2="300"></line>
      <line x1="356" y1="230" x2="416" y2="214"></line>
    </g>
    <g class="fill-blush-400 dark:fill-blush-300">
      <circle cx="206" cy="100" r="3"></circle>
      <circle cx="280" cy="234" r="3"></circle>
      <circle cx="312" cy="171" r="3"></circle>
      <circle cx="180" cy="236" r="3"></circle>
      <circle cx="356" cy="230" r="3"></circle>
    </g>
  </svg>

  <!-- value chips (HTML overlay, positioned by % of the figure) -->
  {
    measurementDims.map((d) => {
      const v = cur[d.id];
      const pos = LAYOUT[d.id];
      return (
        <div
          class="absolute -translate-x-1/2 -translate-y-1/2"
          style={`left:${pos.lx}%;top:${pos.ly}%`}
          data-dim={d.id}
        >
          <span class="inline-flex flex-col items-center rounded-full border border-blush-200/80 bg-paper-50/95 px-2.5 py-1 shadow-sm dark:border-plum-700 dark:bg-plum-900/95">
            <span class="text-[9px] font-extrabold tracking-[0.08em] text-blush-500 uppercase dark:text-blush-300">
              {c.dims[d.id].short}
            </span>
            <span
              class="font-display text-[13px] leading-none font-semibold whitespace-nowrap text-ink-900 dark:text-paper-100"
              data-dim-value
              {...(v ? { 'data-cm': v.cm } : {})}
            >
              {v ? `${v.cm} ${c.unit}` : '—'}
            </span>
          </span>
        </div>
      );
    })
  }
</figure>
