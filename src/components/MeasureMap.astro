---
/**
 * The measurement map: a walking cat in profile (flat "shadow" silhouette, one
 * tone) with each dimension drawn where it is actually taken (spine line,
 * girth rings, front-leg line), each pinned to a value chip. The chips reuse the
 * [data-dim]/[data-dim-value] hooks, so the page script's live re-fetch +
 * cm/inch toggle update them exactly like the list. Zero JS of its own.
 */
import { measurementDims } from '../data/picha';
import { currentMeasurements } from '../data/measurements';
import { getMeasureCopy } from '../i18n/content';

const c = getMeasureCopy(Astro.currentLocale);
const cur = currentMeasurements;

// Chip anchor per dimension, as % of the figure box (viewBox 460 x 360). The
// drawing sits in <g translate(14 0)>, so chip lx = (x + 14) / 460 where x is
// the leader-line end point in the SVG below. Keep them in sync.
const LAYOUT: Record<string, { lx: number; ly: number }> = {
  neck: { lx: 30.2, ly: 13.9 },
  back: { lx: 49.8, ly: 13.9 },
  leg: { lx: 11.3, ly: 91.7 },
  chest: { lx: 52.6, ly: 91.7 },
  belly: { lx: 74.8, ly: 91.7 },
};
---

<figure class="relative mx-auto w-full" aria-label={c.cardLabel}>
  <svg viewBox="0 0 460 360" class="h-auto w-full" role="presentation">
    <g transform="translate(14 0)">
      <!-- silhouette: a cat walking left, one flat tone -->
      <g class="fill-blush-200 dark:fill-plum-700">
        <!-- far hind leg + far ear (show through the gaps) -->
        <path
          d="M270 208 L320 212 C323 230 322 252 312 262 C304 270 300 276 298 282 C296 286 292 288 286 288 L270 288 C264 288 264 282 270 281 C278 278 286 270 290 260 C294 250 284 236 272 220 Z"
        ></path>
        <path d="M74 108 L80 90 Q82 86 85 89 L94 104 Z"></path>
        <!-- near side: head, body, tail, near hind leg, both front legs -->
        <path
          d="M50 136 C54 124 64 110 78 104 L84 104 L94 84 Q96 80 99 84 L112 107 C124 114 132 124 148 129 C170 134 190 133 210 132 C245 129 275 125 300 127 C312 128 318 131 324 131 C340 120 358 104 380 96 C400 90 420 96 428 112 C438 130 430 152 420 162 C414 168 408 162 412 154 C420 140 418 122 404 116 C388 110 372 120 362 136 C356 146 352 156 352 164 C356 186 366 206 378 222 C382 240 382 262 384 278 C385 284 380 287 374 287 L362 287 C358 287 358 282 362 281 C364 268 362 252 358 242 C344 234 320 228 300 222 C280 222 250 228 212 229 C212 246 210 266 210 280 C210 286 206 289 200 289 L188 289 C182 289 182 283 188 282 C194 280 194 270 192 262 C188 250 178 236 160 224 C140 236 116 256 96 276 C92 282 88 286 82 286 L66 286 C58 286 58 280 64 278 C76 272 92 250 100 228 C104 214 108 200 106 190 C100 172 88 160 72 156 C62 154 54 150 52 144 Z"
        ></path>
      </g>

      <!-- ground -->
      <line
        x1="30"
        y1="290"
        x2="440"
        y2="290"
        class="stroke-blush-200 dark:stroke-ink-600/60"
        stroke-width="3"
        stroke-dasharray="2 8"
        stroke-linecap="round"></line>

      <!-- length guides with end ticks: back (neck base to tail base, on the
           spine) + front leg (shoulder to floor, along the leading leg) -->
      <g
        class="stroke-blush-400 dark:stroke-blush-300"
        stroke-width="2.5"
        fill="none"
        stroke-linecap="round"
      >
        <line x1="152" y1="139" x2="320" y2="137"></line>
        <line x1="152" y1="132" x2="152" y2="146"></line>
        <line x1="320" y1="130" x2="320" y2="144"></line>
        <line x1="96" y1="198" x2="52" y2="278"></line>
        <line x1="90" y1="195" x2="102" y2="201"></line>
        <line x1="46" y1="275" x2="58" y2="281"></line>
      </g>

      <!-- girth guides: neck (tilted with the neck), chest (behind the front
           legs), belly (narrowest, just ahead of the back legs) -->
      <g class="stroke-blush-400 dark:stroke-blush-300" stroke-width="2.5" fill="none" stroke-dasharray="4 5">
        <ellipse cx="118" cy="142" rx="9" ry="26" transform="rotate(35 118 142)"></ellipse>
        <ellipse cx="222" cy="181" rx="15" ry="48"></ellipse>
        <ellipse cx="268" cy="176" rx="13" ry="46"></ellipse>
      </g>

      <!-- leaders from each guide to its chip -->
      <g class="stroke-blush-300 dark:stroke-blush-500" stroke-width="1.4" stroke-dasharray="2 4">
        <line x1="133" y1="121" x2="125" y2="64"></line>
        <line x1="180" y1="138" x2="215" y2="64"></line>
        <line x1="74" y1="238" x2="38" y2="316"></line>
        <line x1="222" y1="229" x2="228" y2="316"></line>
        <line x1="268" y1="222" x2="330" y2="316"></line>
      </g>
      <g class="fill-blush-400 dark:fill-blush-300">
        <circle cx="133" cy="121" r="3"></circle>
        <circle cx="180" cy="138" r="3"></circle>
        <circle cx="74" cy="238" r="3"></circle>
        <circle cx="222" cy="229" r="3"></circle>
        <circle cx="268" cy="222" r="3"></circle>
      </g>
    </g>
  </svg>

  <!-- value chips (HTML overlay, positioned by % of the figure) -->
  {
    measurementDims.map((d) => {
      const v = cur[d.id];
      const pos = LAYOUT[d.id];
      return (
        <div
          class="absolute -translate-x-1/2 -translate-y-1/2"
          style={`left:${pos.lx}%;top:${pos.ly}%`}
          data-dim={d.id}
        >
          <span class="inline-flex flex-col items-center rounded-full border border-blush-200/80 bg-paper-50/95 px-2.5 py-1 shadow-sm dark:border-ink-600 dark:bg-plum-900/95">
            <span class="text-[9px] font-extrabold tracking-[0.08em] text-blush-500 uppercase dark:text-blush-300">
              {c.dims[d.id].short}
            </span>
            <span
              class="font-display text-[13px] leading-none font-semibold whitespace-nowrap text-ink-900 dark:text-paper-100"
              data-dim-value
              {...(v ? { 'data-cm': v.cm } : {})}
            >
              {v ? `${v.cm} ${c.unit}` : '—'}
            </span>
          </span>
        </div>
      );
    })
  }
</figure>
