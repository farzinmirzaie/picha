---
/**
 * Illustrated stand-in for Picha: an all-white cat with pink ears/nose, amber
 * eyes and her signature pink collar + bell. Swap for a real photo by dropping
 * one in and replacing this component in the hero (see CLAUDE.md).
 */
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 240 240"
  role="img"
  aria-label="Illustration of Picha, an all-white cat with amber eyes and a pink collar"
  xmlns="http://www.w3.org/2000/svg"
>
  <defs>
    <radialGradient id="furGlow" cx="50%" cy="42%" r="60%">
      <stop offset="0%" stop-color="#ffffff" />
      <stop offset="100%" stop-color="#f6ecff00" />
    </radialGradient>
    <linearGradient id="eye" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#f6c651" />
      <stop offset="100%" stop-color="#e0921f" />
    </linearGradient>
  </defs>

  <!-- soft halo -->
  <circle cx="120" cy="120" r="112" fill="url(#furGlow)" />

  <!-- ears -->
  <path d="M60 96 L48 40 L104 72 Z" fill="#ffffff" stroke="#eadfd3" stroke-width="3" stroke-linejoin="round" />
  <path d="M180 96 L192 40 L136 72 Z" fill="#ffffff" stroke="#eadfd3" stroke-width="3" stroke-linejoin="round" />
  <path d="M64 86 L56 54 L92 74 Z" fill="#f9cfe0" />
  <path d="M176 86 L184 54 L148 74 Z" fill="#f9cfe0" />

  <!-- head -->
  <ellipse cx="120" cy="128" rx="78" ry="72" fill="#ffffff" stroke="#eadfd3" stroke-width="3" />

  <!-- cheek floof -->
  <path d="M44 140 q-10 6 0 14 q8 -2 12 -8 Z" fill="#ffffff" stroke="#eadfd3" stroke-width="2" />
  <path d="M196 140 q10 6 0 14 q-8 -2 -12 -8 Z" fill="#ffffff" stroke="#eadfd3" stroke-width="2" />

  <!-- eyes -->
  <ellipse cx="94" cy="122" rx="16" ry="19" fill="url(#eye)" />
  <ellipse cx="146" cy="122" rx="16" ry="19" fill="url(#eye)" />
  <ellipse cx="94" cy="124" rx="6" ry="12" fill="#2b2b2b" />
  <ellipse cx="146" cy="124" rx="6" ry="12" fill="#2b2b2b" />
  <circle cx="90" cy="116" r="3.5" fill="#ffffff" />
  <circle cx="142" cy="116" r="3.5" fill="#ffffff" />

  <!-- nose -->
  <path d="M114 146 L126 146 L120 154 Z" fill="#f4a9c7" stroke="#e07ba0" stroke-width="1.5" stroke-linejoin="round" />
  <!-- mouth -->
  <path d="M120 154 q-6 8 -14 6 M120 154 q6 8 14 6" fill="none" stroke="#d9b8c6" stroke-width="2.5" stroke-linecap="round" />

  <!-- whiskers -->
  <g stroke="#e6d8cf" stroke-width="2" stroke-linecap="round">
    <path d="M78 140 L34 132" />
    <path d="M78 148 L36 150" />
    <path d="M162 140 L206 132" />
    <path d="M162 148 L204 150" />
  </g>

  <!-- collar -->
  <path d="M78 188 q42 26 84 0" fill="none" stroke="#ec7ba8" stroke-width="10" stroke-linecap="round" />
  <!-- bell -->
  <circle cx="120" cy="198" r="10" fill="#f2b134" stroke="#d9962a" stroke-width="2" />
  <line x1="112" y1="196" x2="128" y2="196" stroke="#d9962a" stroke-width="2" />
  <circle cx="120" cy="201" r="1.8" fill="#d9962a" />
</svg>
