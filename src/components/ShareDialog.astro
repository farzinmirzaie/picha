---
/**
 * The share sheet: QR code to the site + native share / copy-link buttons.
 * Include once per page; any element with `data-share-open` opens it.
 * The QR is a custom-designed image (src/assets/qr.png) encoding the site URL;
 * it sits on a white tile so it scans reliably in both themes. The dialog ships
 * no JS beyond the open/share/copy handlers. Generic on purpose: it hands the
 * whole app to a vet, a day care, or family in one scan.
 */
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
import SheetHeader from './ui/SheetHeader.astro';
import Button from './ui/Button.astro';
import qrImage from '../assets/qr.png';
import { getShareCopy } from '../i18n/content';

const c = getShareCopy(Astro.currentLocale);
const url = new URL(`${import.meta.env.BASE_URL.replace(/\/$/, '')}/`, Astro.site)
  .href;
---

<dialog id="share" class="sheet" aria-labelledby="share-title" data-url={url} data-share-text={c.shareText}>
  <div class="rounded-2xl bg-paper-50 shadow-2xl max-md:rounded-b-none max-md:pb-[env(safe-area-inset-bottom)] dark:bg-plum-900">
    <SheetHeader title={c.sheetTitle} titleId="share-title" closeLabel={c.closeLabel} />

    <div class="p-6 text-center">
      <p class="mx-auto max-w-xs text-sm leading-relaxed text-ink-600 dark:text-ink-400">
        {c.blurb}
      </p>

      <div
        class="mx-auto mt-5 w-52 rounded-2xl border border-paper-300/70 bg-white p-3.5 shadow-sm dark:border-plum-700"
        role="img"
        aria-label={`QR code linking to ${url}`}
      >
        <Image
          src={qrImage}
          alt=""
          width={600}
          format="png"
          class="h-auto w-full"
          aria-hidden="true"
        />
      </div>
      <p class="select-text mt-3 font-mono text-[11px] break-all text-ink-400">{url}</p>

      <div class="mt-5 flex flex-wrap justify-center gap-2.5">
        <Button data-share-native icon="ph:share-network">{c.share}</Button>
        <Button variant="outline" data-share-copy>
          <span class="relative h-4.5 w-4.5 shrink-0" aria-hidden="true">
            <Icon
              name="ph:copy"
              data-copy-icon
              class="absolute inset-0 h-full w-full transition-all duration-300 ease-out"
            />
            <Icon
              name="ph:check"
              data-copy-check
              class="absolute inset-0 h-full w-full scale-0 opacity-0 transition-all duration-300 ease-out"
            />
          </span>
          <span data-share-copy-label>{c.copyLink}</span>
        </Button>
      </div>
    </div>
  </div>
</dialog>

<script>
  import { bindDialog } from '../lib/dialog';
  import { getShareCopy } from '../i18n/content';

  function setupShare() {
    const dialog = document.getElementById('share') as HTMLDialogElement | null;
    if (!dialog) return;
    const url = dialog.dataset.url!;

    document.querySelectorAll<HTMLElement>('[data-share-open]').forEach((btn) => {
      if (btn.dataset.bound) return;
      btn.dataset.bound = '1';
      btn.addEventListener('click', () => dialog.showModal());
    });

    if (dialog.dataset.wired) return;
    dialog.dataset.wired = '1';
    bindDialog(dialog);

    const native = dialog.querySelector<HTMLButtonElement>('[data-share-native]');
    // No Web Share API (mostly desktop browsers): the copy button carries it.
    // Remove inline-flex too, or it would beat the `hidden` display utility.
    if (!navigator.share) native?.classList.remove('inline-flex');
    if (!navigator.share) native?.classList.add('hidden');
    const shareText = dialog.dataset.shareText || 'Picha 🐾';
    native?.addEventListener('click', async () => {
      try {
        await navigator.share({
          title: 'Picha 🐾',
          text: shareText,
          url,
        });
      } catch {
        /* user dismissed the share sheet */
      }
    });

    const copy = dialog.querySelector<HTMLButtonElement>('[data-share-copy]');
    const copyLabel = dialog.querySelector<HTMLElement>('[data-share-copy-label]');
    const iconCopy = dialog.querySelector<HTMLElement>('[data-copy-icon]');
    const iconCheck = dialog.querySelector<HTMLElement>('[data-copy-check]');
    let copyTimer: ReturnType<typeof setTimeout> | undefined;
    const showCopied = (on: boolean) => {
      iconCopy?.classList.toggle('scale-0', on);
      iconCopy?.classList.toggle('opacity-0', on);
      iconCheck?.classList.toggle('scale-0', !on);
      iconCheck?.classList.toggle('opacity-0', !on);
      const sc = getShareCopy(document.documentElement.lang || 'en');
      if (copyLabel) copyLabel.textContent = on ? sc.copied : sc.copyLink;
    };
    copy?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(url);
      } catch {
        return;
      }
      showCopied(true);
      clearTimeout(copyTimer);
      copyTimer = setTimeout(() => showCopied(false), 1600);
    });
  }

  setupShare();
  document.addEventListener('astro:page-load', setupShare);
</script>
