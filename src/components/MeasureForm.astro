---
/**
 * The measurement entry form (PIN-gated via the log_measurement RPC). Rendered
 * twice on the measurements page — desktop accordion + mobile dialog — so it
 * carries no ids; the page script binds every [data-measure-form] instance.
 * Every dimension is optional (measure what she tolerates); blanks keep their
 * last value. `flush`: drop the card chrome when a container already provides it.
 */
import Button from './ui/Button.astro';
import { supabaseClient } from '../data/supabase';
import { measurementDims } from '../data/picha';
import { getMeasureCopy } from '../i18n/content';

interface Props {
  flush?: boolean;
}
const { flush = false } = Astro.props;
const c = getMeasureCopy(Astro.currentLocale);
---

<form
  data-measure-form
  autocomplete="off"
  data-supabase-url={supabaseClient?.url}
  data-supabase-key={supabaseClient?.key}
  class:list={[
    flush ||
      'rounded-3xl border border-blush-200/70 bg-paper-50 p-5 sm:p-6 dark:border-plum-700 dark:bg-plum-900',
  ]}
>
  <label class="block">
    <span class="text-[10px] font-bold tracking-[0.14em] text-ink-400 uppercase">{c.form.date}</span>
    <input
      type="date"
      name="date"
      required
      class="mt-1 w-full rounded-xl border border-blush-200/70 bg-paper-100 px-3 py-2 text-sm font-bold outline-none focus:border-blush-400 dark:border-plum-700 dark:bg-plum-950"
    />
  </label>
  <div class="mt-3 grid grid-cols-2 gap-3">
    {
      measurementDims.map((d) => (
        <label class="block">
          <span class="text-[10px] font-bold tracking-[0.14em] text-ink-400 uppercase">
            {c.dims[d.id].label} (<span data-unit-label>{c.unit}</span>)
          </span>
          <input
            type="number"
            name={d.id}
            step="0.1"
            min="1"
            max="150"
            inputmode="decimal"
            class="mt-1 w-full rounded-xl border border-blush-200/70 bg-paper-100 px-3 py-2 text-sm font-bold outline-none focus:border-blush-400 dark:border-plum-700 dark:bg-plum-950"
          />
        </label>
      ))
    }
  </div>
  <Button block type="submit" icon="ph:ruler" class="mt-4">{c.form.record}</Button>
  <p class="mt-3 min-h-4 text-xs font-bold text-ink-400" data-form-status aria-live="polite"></p>
  <p class="mt-3 text-[11px] leading-relaxed text-ink-400">{c.form.leaveBlankNote}</p>
</form>
