---
/**
 * Language picker (Astro native i18n). Include once (in Layout). Any
 * `[data-lang-open]` element opens it (the globe in the desktop nav + the
 * mobile app-bar translate button). Each option is a link to the current page
 * in that locale (English at root, others prefixed), so picking a language
 * navigates — no client-side text swap. The choice is stored in localStorage
 * (`picha-lang`); it no longer opens automatically on load.
 */
import { Icon } from 'astro-icon/components';
import { LOCALES, localeLabels, t } from '../i18n/ui';

const current = Astro.currentLocale ?? 'en';
const base = import.meta.env.BASE_URL.replace(/\/$/, ''); // "/picha"
// Logical path after the base, with any locale prefix stripped.
let rest = Astro.url.pathname.slice(base.length) || '/';
const m = rest.match(/^\/ms(?=\/|$)/);
if (m) rest = rest.slice(m[0].length) || '/';
if (!rest.startsWith('/')) rest = '/' + rest;
const urlFor = (loc: string) => (loc === 'en' ? `${base}${rest}` : `${base}/${loc}${rest}`);
---

<dialog id="lang" class="sheet" aria-labelledby="lang-title">
  <div
    class="rounded-2xl bg-paper-50 shadow-2xl max-md:rounded-b-none max-md:pb-[env(safe-area-inset-bottom)] dark:bg-plum-900"
  >
    <div class="sticky top-0 z-10 flex items-center justify-between bg-blush-600 px-5 py-3">
      <h2 id="lang-title" class="text-[11px] font-bold tracking-[0.22em] text-white uppercase sm:text-xs">
        {t(current, 'lang.title')}
      </h2>
      <button
        type="button"
        data-dialog-close
        aria-label="Close"
        class="flex h-8 w-8 items-center justify-center rounded-full bg-white/20 text-white transition-colors hover:bg-white/35"
      >
        <Icon name="ph:x" class="h-4 w-4" aria-hidden="true" />
      </button>
    </div>

    <div class="p-6">
      <p class="mx-auto max-w-xs text-center text-sm leading-relaxed text-ink-600 dark:text-ink-400">
        {t(current, 'lang.sub')}
      </p>
      <ul class="mt-5 space-y-2.5">
        {
          LOCALES.map((l) => (
            <li>
              <a
                href={urlFor(l)}
                data-lang-pick={l}
                aria-current={l === current ? 'true' : undefined}
                class="flex w-full items-center gap-3 rounded-2xl border border-blush-200/70 bg-white px-4 py-3.5 text-left shadow-sm transition-all duration-200 hover:-translate-y-0.5 hover:shadow-md active:translate-y-0 dark:border-plum-700 dark:bg-plum-950"
              >
                <Icon name="ph:translate" class="h-5 w-5 shrink-0 text-blush-500" aria-hidden="true" />
                <span class="flex-1 font-display text-lg font-semibold">{localeLabels[l]}</span>
                {l === current && (
                  <Icon name="ph:check-circle" class="h-5 w-5 shrink-0 text-blush-600 dark:text-blush-300" aria-hidden="true" />
                )}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</dialog>

<script>
  import { bindDialog } from '../lib/dialog';

  function setup() {
    const dialog = document.getElementById('lang') as HTMLDialogElement | null;
    if (!dialog) return;
    document.querySelectorAll<HTMLElement>('[data-lang-open]').forEach((btn) => {
      if (btn.dataset.bound) return;
      btn.dataset.bound = '1';
      btn.addEventListener('click', () => dialog.showModal());
    });
    if (dialog.dataset.wired) return;
    dialog.dataset.wired = '1';
    bindDialog(dialog);
    // Remember the choice (the link itself navigates to the locale route).
    dialog.querySelectorAll<HTMLAnchorElement>('[data-lang-pick]').forEach((a) => {
      a.addEventListener('click', () => {
        try {
          localStorage.setItem('picha-lang', a.dataset.langPick!);
        } catch {
          /* private mode */
        }
      });
    });
  }

  setup();
  document.addEventListener('astro:page-load', setup);
</script>
