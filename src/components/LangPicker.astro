---
/**
 * Language picker + the client i18n engine (proof of concept). Include once
 * (in Layout). Any `[data-lang-open]` element opens it, and it also opens on
 * every visit for now (later: first visit only, then the switcher takes over).
 * Picking a language swaps every `[data-i18n]` element via src/i18n/ui.ts,
 * sets <html lang>, and remembers the choice in localStorage (`picha-lang`).
 * Options render from LOCALES, so adding a language is a data-only change.
 */
import { Icon } from 'astro-icon/components';
import { LOCALES, localeLabels } from '../i18n/ui';
---

<dialog id="lang" class="sheet" aria-labelledby="lang-title">
  <div
    class="rounded-2xl bg-paper-50 shadow-2xl max-md:rounded-b-none max-md:pb-[env(safe-area-inset-bottom)] dark:bg-plum-900"
  >
    <!-- header inline (not SheetHeader) so the title itself can translate -->
    <div class="sticky top-0 z-10 flex items-center justify-between bg-blush-600 px-5 py-3">
      <h2
        id="lang-title"
        data-i18n="lang.title"
        class="text-[11px] font-bold tracking-[0.22em] text-white uppercase sm:text-xs"
      >
        Choose your language
      </h2>
      <button
        type="button"
        data-dialog-close
        aria-label="Close"
        class="flex h-8 w-8 items-center justify-center rounded-full bg-white/20 text-white transition-colors hover:bg-white/35"
      >
        <Icon name="ph:x" class="h-4 w-4" aria-hidden="true" />
      </button>
    </div>

    <div class="p-6">
      <p
        data-i18n="lang.sub"
        class="mx-auto max-w-xs text-center text-sm leading-relaxed text-ink-600 dark:text-ink-400"
      >
        You can switch anytime from the globe in the menu.
      </p>
      <ul class="mt-5 space-y-2.5">
        {
          LOCALES.map((l) => (
            <li>
              <button
                type="button"
                data-lang-pick={l}
                class="flex w-full items-center gap-3 rounded-2xl border border-blush-200/70 bg-white px-4 py-3.5 text-left shadow-sm transition-all duration-200 hover:-translate-y-0.5 hover:shadow-md active:translate-y-0 dark:border-plum-700 dark:bg-plum-950"
              >
                <Icon name="ph:translate" class="h-5 w-5 shrink-0 text-blush-500" aria-hidden="true" />
                <span class="flex-1 font-display text-lg font-semibold">{localeLabels[l]}</span>
                <Icon
                  name="ph:check-circle"
                  data-lang-active
                  class="hidden h-5 w-5 shrink-0 text-blush-600 dark:text-blush-300"
                  aria-hidden="true"
                />
              </button>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</dialog>

<script>
  import { bindDialog } from '../lib/dialog';
  import { ui, DEFAULT_LOCALE, LOCALES } from '../i18n/ui';

  const KEY = 'picha-lang';
  const getLang = () => {
    const v = localStorage.getItem(KEY);
    return v && (LOCALES as readonly string[]).includes(v) ? v : DEFAULT_LOCALE;
  };

  // Swap every tagged element to `lang`, set <html lang>, and mark the active
  // option. Falls back to the default locale for any missing key.
  function apply(lang: string) {
    const dict = ui[lang] ?? ui[DEFAULT_LOCALE];
    document.documentElement.lang = lang;
    document.querySelectorAll<HTMLElement>('[data-i18n]').forEach((el) => {
      const key = el.dataset.i18n!;
      const val = dict[key] ?? ui[DEFAULT_LOCALE][key];
      if (val != null) el.textContent = val;
    });
    document.querySelectorAll<HTMLElement>('[data-lang-pick]').forEach((btn) => {
      const on = btn.dataset.langPick === lang;
      btn.querySelector('[data-lang-active]')?.classList.toggle('hidden', !on);
    });
  }

  function setup() {
    apply(getLang()); // re-apply on every page, including after ClientRouter swaps
    const dialog = document.getElementById('lang') as HTMLDialogElement | null;
    if (!dialog) return;
    document.querySelectorAll<HTMLElement>('[data-lang-open]').forEach((btn) => {
      if (btn.dataset.bound) return;
      btn.dataset.bound = '1';
      btn.addEventListener('click', () => dialog.showModal());
    });
    if (dialog.dataset.wired) return;
    dialog.dataset.wired = '1';
    bindDialog(dialog);
    dialog.querySelectorAll<HTMLButtonElement>('[data-lang-pick]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const lang = btn.dataset.langPick!;
        localStorage.setItem(KEY, lang);
        apply(lang);
        dialog.close();
      });
    });
  }

  setup();
  document.addEventListener('astro:page-load', setup);

  // Ask on every visit: open on each hard load (in-app ClientRouter navigations
  // don't fire `load`, so it won't nag between pages). Later: gate on a
  // first-visit flag so it appears only once, then the switcher takes over.
  window.addEventListener('load', () => {
    (document.getElementById('lang') as HTMLDialogElement | null)?.showModal();
  });
</script>
