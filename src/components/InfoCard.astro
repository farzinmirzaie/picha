---
/** A soft rounded card for a single care/health item. */
interface Props {
  icon: string;
  title: string;
  cadence?: string;
}
const { icon, title, cadence } = Astro.props;
---

<div
  class="rise rounded-2xl border border-blush-100 bg-cream-50/80 p-5 shadow-sm backdrop-blur transition hover:-translate-y-0.5 hover:shadow-md dark:border-slate-800 dark:bg-slate-900/70"
>
  <div class="mb-2 flex items-center justify-between gap-2">
    <div class="flex items-center gap-2">
      <span class="text-xl" aria-hidden="true">{icon}</span>
      <h3 class="font-bold text-slate-800 dark:text-slate-100">{title}</h3>
    </div>
    {
      cadence && (
        <span class="shrink-0 rounded-full bg-blush-100 px-2.5 py-0.5 text-xs font-semibold text-blush-700 dark:bg-blush-700/30 dark:text-blush-200">
          {cadence}
        </span>
      )
    }
  </div>
  <p class="text-sm leading-relaxed text-slate-600 dark:text-slate-300">
    <slot />
  </p>
</div>
