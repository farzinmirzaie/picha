---
/** The Academy's session rules card — shared by the hub and course pages. */
import { Icon } from 'astro-icon/components';
import SectionLabel from './ui/SectionLabel.astro';
import { getTrainingCopy } from '../i18n/content';

interface Props {
  /** Top padding utility for the section (layout differs per page). */
  padTop?: string;
}
const { padTop = 'pt-8' } = Astro.props;
const tc = getTrainingCopy(Astro.currentLocale);
const trainingRules = tc.rules;
---

<section
  class:list={['mx-auto w-full max-w-2xl px-5 pb-8 md:pb-0', padTop]}
  aria-label="Session rules"
>
  <SectionLabel class="reveal mb-2">{tc.rulesLabel}</SectionLabel>
  <div
    class="reveal overflow-hidden rounded-3xl border border-blush-200/70 bg-paper-50 dark:border-plum-700 dark:bg-plum-900"
  >
    <ul class="divide-y divide-paper-200 dark:divide-plum-800">
      {
        trainingRules.map((r) => (
          <li class="flex items-start gap-3 px-5 py-3.5 text-sm text-ink-600 dark:text-ink-400">
            <Icon
              name="ph:seal-check"
              class="mt-0.5 h-4 w-4 shrink-0 text-blush-500 dark:text-blush-300"
              aria-hidden="true"
            />
            {r}
          </li>
        ))
      }
    </ul>
  </div>
  <slot />
</section>
