# Supabase (live cloud data) — copy to .env for local builds that read from the
# cloud. Powers the weight ledger, training progress and daily rounds today, and
# whatever staff tools grow here next. Without these, builds quietly fall back to
# the seed data in src/data/picha.ts, so they never break.
# Values: Supabase dashboard → Project Settings → Data API.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-public-key>

# Web Push (background reminders). The VAPID *public* key is baked into the
# client so it can subscribe; it's safe to expose (PUBLIC_ vars ship to the
# browser). Generate a pair with `npx web-push generate-vapid-keys`. The
# private key + service_role key live only in the sender's secrets, never here.
# See docs/notifications.md.
PUBLIC_VAPID_KEY=<vapid-public-key>
